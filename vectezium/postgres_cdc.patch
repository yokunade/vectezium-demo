new file mode 100644
index 0000000..0422798
--- /dev/null
+++ b/src/sources/postgres_cdc/envelope.rs
@@ -0,0 +1,168 @@
+//! The PostgreSQL `source` block of change events. The envelopes themselves are shared with every
+//! connector (`cdc::envelope`).
+//!
+//! ```json
+//! "source": {
+//!   "version": "…", "connector": "postgresql", "name": "dbserver1", "ts_ms": 1700000000000,
+//!   "snapshot": "false", "db": "inventory", "sequence": "[\"24023119\",\"24023128\"]",
+//!   "ts_us": …, "ts_ns": …, "table": "customers", "schema": "public", "txId": 555,
+//!   "lsn": 24023128, "xmin": null
+//! }
+//! ```
+//!
+//! As in Debezium, `source.db` is the database and `source.schema` the schema. In the record
+//! format `metadata.db` is the schema (the level the include lists and the lake layout use, as
+//! the database is for MySQL), with the database in `metadata.database`.
+
+use serde_json::{Map, Value as Json, json};
+
+use super::offset::Lsn;
+pub use crate::sources::cdc::envelope::{Op, SnapshotMarker, SourceBlock};
+
+/// Values for the `source` block of one PostgreSQL change event.
+#[derive(Clone, Debug)]
+pub struct SourceInfo<'a> {
+    pub connector_version: &'a str,
+    pub name: &'a str,
+    /// Commit time of the change in microseconds since the epoch.
+    pub ts_us: i64,
+    pub snapshot: SnapshotMarker,
+    pub database: &'a str,
+    pub schema: &'a str,
+    pub table: &'a str,
+    pub txid: Option<u32>,
+    /// The commit LSN of the change's transaction (the snapshot's position for snapshot reads).
+    pub lsn: Option<Lsn>,
+    /// The commit LSN of the transaction before it, Debezium's `lastCommitLsn`.
+    pub last_commit_lsn: Option<Lsn>,
+}
+
+impl SourceBlock for SourceInfo<'_> {
+    fn connector(&self) -> &'static str {
+        "postgresql"
+    }
+
+    fn connector_version(&self) -> &str {
+        self.connector_version
+    }
+
+    fn server_name(&self) -> &str {
+        self.name
+    }
+
+    fn ts_us(&self) -> i64 {
+        self.ts_us
+    }
+
+    fn snapshot(&self) -> SnapshotMarker {
+        self.snapshot
+    }
+
+    fn db(&self) -> &str {
+        self.schema
+    }
+
+    fn table(&self) -> &str {
+        self.table
+    }
+
+    /// Debezium's `["<lastCommitLsn>", "<lsn>"]`, as a JSON string.
+    fn sequence(&self) -> Json {
+        let text = |lsn: Option<Lsn>| lsn.map(|l| l.0.to_string());
+        Json::from(json!([text(self.last_commit_lsn), text(self.lsn)]).to_string())
+    }
+
+    fn debezium_position(&self, source: &mut Map<String, Json>) {
+        // `db` is the database in Debezium's PostgreSQL connector (replaced in place, so the
+        // field order stays Debezium's).
+        source.insert("db".into(), json!(self.database));
+        source.insert("schema".into(), json!(self.schema));
+        source.insert("txId".into(), self.txid.map_or(Json::Null, |t| json!(t)));
+        source.insert("lsn".into(), self.lsn.map_or(Json::Null, |l| json!(l.0)));
+        source.insert("xmin".into(), Json::Null);
+    }
+
+    fn record_position(&self, metadata: &mut Map<String, Json>) {
+        metadata.insert("database".into(), json!(self.database));
+        metadata.insert("txid".into(), self.txid.map_or(Json::Null, |t| json!(t)));
+        metadata.insert(
+            "lsn".into(),
+            self.lsn.map_or(Json::Null, |l| json!(l.to_string())),
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::sources::cdc::{
+        RecordImages,
+        envelope::{change_event, record_event},
+    };
+
+    fn source() -> SourceInfo<'static> {
+        SourceInfo {
+            connector_version: "test",
+            name: "srv",
+            ts_us: 1_700_000_000_123_456,
+            snapshot: SnapshotMarker::False,
+            database: "shop",
+            schema: "public",
+            table: "orders",
+            txid: Some(555),
+            lsn: Some(Lsn(24_023_128)),
+            last_commit_lsn: Some(Lsn(24_023_119)),
+        }
+    }
+
+    #[test]
+    fn debezium_source_block() {
+        let mut after = Map::new();
+        after.insert("id".into(), json!(1));
+        let event = change_event(Op::Create, None, Some(after), &source());
+        let block = event["source"].as_object().unwrap();
+        let keys: Vec<&str> = block.keys().map(String::as_str).collect();
+        assert_eq!(
+            keys,
+            [
+                "version",
+                "connector",
+                "name",
+                "ts_ms",
+                "snapshot",
+                "db",
+                "sequence",
+                "ts_us",
+                "ts_ns",
+                "table",
+                "schema",
+                "txId",
+                "lsn",
+                "xmin"
+            ]
+        );
+        assert_eq!(block["connector"], json!("postgresql"));
+        assert_eq!(block["db"], json!("shop"));
+        assert_eq!(block["schema"], json!("public"));
+        assert_eq!(block["sequence"], json!("[\"24023119\",\"24023128\"]"));
+        assert_eq!(block["lsn"], json!(24_023_128));
+    }
+
+    #[test]
+    fn record_metadata_uses_schema_as_db() {
+        let event = record_event(
+            Op::Update,
+            None,
+            Some(Map::new()),
+            &source(),
+            None,
+            Some("v1"),
+            RecordImages::After,
+        );
+        let metadata = event["metadata"].as_object().unwrap();
+        assert_eq!(metadata["db"], json!("public"));
+        assert_eq!(metadata["database"], json!("shop"));
+        assert_eq!(metadata["lsn"], json!("0/16E9058"));
+        assert_eq!(metadata["txid"], json!(555));
+    }
+}
diff --git a/src/sources/postgres_cdc/incremental.rs b/src/sources/postgres_cdc/incremental.rs
new file mode 100644
index 0000000..5bba555
--- /dev/null
+++ b/src/sources/postgres_cdc/incremental.rs
@@ -0,0 +1,288 @@
+//! Incremental (chunked) snapshots, read while the slot streams: the read-only watermark
+//! algorithm of Debezium's PostgreSQL connector (DBLog), with a transaction snapshot as the
+//! watermark.
+//!
+//! Each chunk of a table is read in one short `REPEATABLE READ` transaction, in key order:
+//!
+//! * `S = pg_current_snapshot()`: the transaction's snapshot, which the chunk's rows reflect;
+//! * `H = pg_current_wal_insert_lsn()`, read after `S`: every transaction visible in `S` has
+//!   its commit record before `H`.
+//!
+//! The chunk is held (a "window") while the stream catches up to `H`. A captured change to one
+//! of the chunk's keys from a transaction *not* visible in `S` is newer than the chunk's copy,
+//! so that key is dropped from the chunk (the change itself is emitted as usual). Once every
+//! transaction committed before `H` has been streamed, the remaining rows are emitted as
+//! snapshot reads: every change older than them has been emitted, and every newer change
+//! follows them. Windows only open between transactions, so no transaction is half-streamed
+//! when one opens.
+//!
+//! Locks are only held for one chunk query at a time. Progress (the last key delivered) is
+//! stored with each offset, so a restart resumes from the last delivered chunk.
+
+use std::{collections::HashMap, str::FromStr};
+
+use pgrepl_tokio_postgres::{Client, SimpleQueryMessage};
+use serde_json::{Map, Value as Json};
+
+use super::{
+    catalog::{TableInfo, TypeRegistry, quote_ident},
+    connection::error_text,
+    offset::{Lsn, TableRef},
+    source::{Settings, row_key, row_map},
+};
+
+/// A transaction snapshot (`pg_current_snapshot()`): `xmin:xmax:xip,…`, 64-bit transaction ids.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PgSnapshot {
+    xmin: u64,
+    xmax: u64,
+    xip: Vec<u64>,
+}
+
+impl FromStr for PgSnapshot {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let bad = || format!("invalid snapshot `{s}`");
+        let mut parts = s.split(':');
+        let (Some(xmin), Some(xmax), Some(xip)) = (parts.next(), parts.next(), parts.next()) else {
+            return Err(bad());
+        };
+        let xip = xip
+            .split(',')
+            .filter(|x| !x.is_empty())
+            .map(|x| x.parse().map_err(|_| bad()))
+            .collect::<Result<_, _>>()?;
+        Ok(Self {
+            xmin: xmin.parse().map_err(|_| bad())?,
+            xmax: xmax.parse().map_err(|_| bad())?,
+            xip,
+        })
+    }
+}
+
+impl PgSnapshot {
+    /// Whether the (committed) transaction `xid` is visible in this snapshot: it committed
+    /// before the snapshot was taken.
+    pub fn visible(&self, xid: u32) -> bool {
+        let full = widen(xid, self.xmax);
+        full < self.xmin || (full < self.xmax && !self.xip.contains(&full))
+    }
+}
+
+/// The 64-bit id of a 32-bit `xid` near `reference` (pgoutput sends 32-bit ids; snapshots have
+/// 64-bit ones). Ids within 2^31 of the reference are unambiguous.
+fn widen(xid: u32, reference: u64) -> u64 {
+    const EPOCH: u64 = 1 << 32;
+    const HALF: u64 = 1 << 31;
+    let full = (reference & !(EPOCH - 1)) | u64::from(xid);
+    if full > reference.saturating_add(HALF) {
+        full.saturating_sub(EPOCH)
+    } else if full.saturating_add(HALF) < reference {
+        full + EPOCH
+    } else {
+        full
+    }
+}
+
+/// One chunk, held until the stream reaches `high`.
+pub struct Window {
+    pub table: TableRef,
+    pub info: TableInfo,
+    pub snapshot: PgSnapshot,
+    pub high: Lsn,
+    /// Rows in key order; a dropped row is `None`.
+    rows: Vec<Option<Map<String, Json>>>,
+    /// Key (as JSON text) → index into `rows`.
+    index: HashMap<String, usize>,
+    /// SQL literals of the last key read (where the next chunk starts).
+    pub last_key: Option<Vec<String>>,
+    /// Fewer rows than a full chunk: the table is done once this window closes.
+    pub complete: bool,
+}
+
+impl Window {
+    /// Drops `key` (a change newer than the chunk touched it).
+    pub fn drop_key(&mut self, key: &str) {
+        if let Some(&i) = self.index.get(key) {
+            self.rows[i] = None;
+        }
+    }
+
+    /// Drops every row (the table was truncated after the chunk's snapshot).
+    pub fn drop_all(&mut self) {
+        self.rows.iter_mut().for_each(|r| *r = None);
+    }
+
+    /// The rows still to emit.
+    pub fn into_rows(self) -> impl Iterator<Item = Map<String, Json>> {
+        self.rows.into_iter().flatten()
+    }
+}
+
+/// The key of a row as text, for matching chunk rows with streamed changes.
+pub fn key_text(key: &Map<String, Json>) -> String {
+    Json::Object(key.clone()).to_string()
+}
+
+/// What reading the next chunk of a table gave.
+pub enum Chunk {
+    Window(Box<Window>),
+    /// The table no longer exists.
+    Gone,
+    /// The table has no key to read it in order by.
+    NoKey,
+}
+
+/// Reads the next chunk of `table` after `last_key`.
+pub async fn read_chunk(
+    client: &Client,
+    settings: &Settings,
+    registry: &TypeRegistry,
+    table: &TableRef,
+    last_key: Option<&[String]>,
+    chunk_size: usize,
+) -> Result<Chunk, String> {
+    let (schema, name) = table;
+    let Some(info) = TableInfo::from_catalog(
+        client,
+        registry,
+        &settings.filters,
+        &settings.convert,
+        schema,
+        name,
+    )
+    .await?
+    else {
+        return Ok(Chunk::Gone);
+    };
+    if info.key.is_empty() {
+        return Ok(Chunk::NoKey);
+    }
+    let qualified = format!("{}.{}", quote_ident(schema), quote_ident(name));
+    let columns = info
+        .columns
+        .iter()
+        .map(|c| quote_ident(&c.name))
+        .collect::<Vec<_>>()
+        .join(", ");
+    let key_columns = info
+        .key
+        .iter()
+        .map(|&i| quote_ident(&info.columns[i].name))
+        .collect::<Vec<_>>()
+        .join(", ");
+    // Untyped literals take the key columns' types in the row comparison.
+    let after = last_key.map_or(String::new(), |values| {
+        format!(" WHERE ({key_columns}) > ({})", values.join(", "))
+    });
+    let select = format!(
+        "SELECT {columns} FROM {qualified}{after} ORDER BY {key_columns} LIMIT {chunk_size}"
+    );
+
+    let fail = |error: pgrepl_tokio_postgres::Error| {
+        format!("failed to read a chunk of {qualified}: {}", error_text(&error))
+    };
+    client
+        .batch_execute("BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY")
+        .await
+        .map_err(fail)?;
+    let result = async {
+        // The first statement fixes the transaction's snapshot, so it is the one the chunk
+        // reads; the insert position, read after it, is past every commit the snapshot sees.
+        let marks = client
+            .query_one(
+                "SELECT pg_current_snapshot()::text, pg_current_wal_insert_lsn()::text",
+                &[],
+            )
+            .await
+            .map_err(fail)?;
+        let snapshot: PgSnapshot = marks.get::<_, String>(0).parse()?;
+        let high: Lsn = marks.get::<_, String>(1).parse()?;
+        let messages = client.simple_query(&select).await.map_err(fail)?;
+        Ok::<_, String>((snapshot, high, messages))
+    }
+    .await;
+    _ = client.batch_execute("COMMIT").await;
+    let (snapshot, high, messages) = result?;
+
+    let mut rows = Vec::new();
+    let mut index = HashMap::new();
+    let mut last = None;
+    let mut fetched = 0;
+    for message in messages {
+        let SimpleQueryMessage::Row(row) = message else {
+            continue;
+        };
+        fetched += 1;
+        last = Some(
+            info.key
+                .iter()
+                .map(|&i| {
+                    let text = row.get(i).unwrap_or_default();
+                    format!("'{}'", text.replace('\'', "''"))
+                })
+                .collect::<Vec<_>>(),
+        );
+        let after = match row_map(settings, &info, |i| row.get(i)) {
+            Ok(after) => after,
+            Err(error) => {
+                settings.handle_failure(error, schema, name)?;
+                continue;
+            }
+        };
+        if let Some(key) = row_key(&info, &after) {
+            index.insert(key_text(&key), rows.len());
+        }
+        rows.push(Some(after));
+    }
+    let read = last.is_some();
+    Ok(Chunk::Window(Box::new(Window {
+        table: table.clone(),
+        info,
+        snapshot,
+        high,
+        rows,
+        index,
+        // A chunk with no rows leaves the position where it was.
+        last_key: if read { last } else { last_key.map(<[String]>::to_vec) },
+        complete: fetched < chunk_size,
+    })))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_snapshots() {
+        let s: PgSnapshot = "740:745:740,742".parse().unwrap();
+        assert_eq!(s, PgSnapshot { xmin: 740, xmax: 745, xip: vec![740, 742] });
+        let s: PgSnapshot = "750:750:".parse().unwrap();
+        assert!(s.xip.is_empty());
+        assert!("750:750".parse::<PgSnapshot>().is_err());
+    }
+
+    #[test]
+    fn visibility() {
+        let s: PgSnapshot = "740:745:740,742".parse().unwrap();
+        assert!(s.visible(739)); // committed before every running transaction
+        assert!(!s.visible(740)); // running when the snapshot was taken
+        assert!(s.visible(741)); // committed, between running ones
+        assert!(!s.visible(742));
+        assert!(!s.visible(745)); // started after the snapshot
+        assert!(!s.visible(900));
+    }
+
+    #[test]
+    fn widening_across_epochs() {
+        let reference = (3_u64 << 32) | 10;
+        assert_eq!(widen(5, reference), (3 << 32) | 5);
+        assert_eq!(widen(20, reference), (3 << 32) | 20);
+        // Just before the epoch boundary: the previous epoch.
+        assert_eq!(widen(u32::MAX - 5, reference), (2 << 32) | u64::from(u32::MAX - 5));
+        let s = PgSnapshot { xmin: (3 << 32) | 2, xmax: (3 << 32) | 12, xip: vec![] };
+        assert!(s.visible(u32::MAX - 5));
+        assert!(!s.visible(12));
+    }
+}
diff --git a/src/sources/postgres_cdc/mod.rs b/src/sources/postgres_cdc/mod.rs
new file mode 100644
index 0000000..2a0ef6b
--- /dev/null
+++ b/src/sources/postgres_cdc/mod.rs
@@ -0,0 +1,677 @@
+//! `postgres_cdc` source: Debezium-compatible change data capture from PostgreSQL logical
+//! replication (`pgoutput`).
+//!
+//! The source reads a logical replication slot through a publication. On its first start it
+//! creates the slot and snapshots the captured tables: `blocking`, in the slot's exported
+//! snapshot before streaming (so the snapshot and the stream meet exactly at the slot's
+//! position), or `incremental`, in chunks while streaming (Debezium's read-only incremental
+//! snapshot, see `incremental.rs`). Then it streams committed transactions. Each row change is emitted as a Debezium change event (or a `record` event), in
+//! the same lake layout as `mysql_cdc`: both are built on the shared CDC core (`sources::cdc`).
+//!
+//! Offsets point at transaction boundaries (the end of a commit record). They are stored once
+//! everything before them was delivered, and only then (or once published, with
+//! `publish_offsets`) does the source let the server discard WAL up to them, so the slot never
+//! runs ahead of the lake.
+//!
+//! Server requirements: PostgreSQL 13+ with `wal_level=logical`; a user with the `REPLICATION`
+//! attribute and `SELECT` on the captured tables. `REPLICA IDENTITY FULL` gives full before
+//! images; without it updates carry no before image and deletes only the key.
+//!
+//! Option names follow Debezium's PostgreSQL connector where one exists.
+
+use std::{collections::HashMap, path::PathBuf};
+
+use vector_lib::{
+    config::{LegacyKey, LogNamespace},
+    configurable::configurable_component,
+    lookup::owned_value_path,
+    schema::Definition,
+    sensitive_string::SensitiveString,
+};
+use vrl::value::{Kind, kind::Collection};
+
+use crate::config::{
+    GenerateConfig, SourceAcknowledgementsConfig, SourceConfig, SourceContext, SourceOutput,
+    log_schema,
+};
+
+mod catalog;
+mod connection;
+mod convert;
+mod envelope;
+mod incremental;
+mod offset;
+mod snapshot;
+mod source;
+mod stream;
+mod table_schema;
+
+use crate::sources::cdc::filter;
+pub use crate::sources::cdc::{
+    CONTROL_OUTPUT, EventFormat, EventProcessingFailureHandlingMode, OBSERVE_OUTPUT,
+    OFFSETS_OUTPUT, RecordImages, TABLE_SCHEMAS_OUTPUT, lock::SingleWriterLockConfig,
+    recovery::OffsetRecoveryConfig,
+};
+
+/// How the source bootstraps when it starts.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum SnapshotMode {
+    /// Snapshot all captured tables when no stored offset exists (or the previous snapshot did
+    /// not complete), then stream changes.
+    #[default]
+    Initial,
+
+    /// Take the snapshot as with `initial`, then stop without streaming.
+    InitialOnly,
+
+    /// Never snapshot table data; stream from the slot's position when no stored offset exists.
+    NoData,
+
+    /// Like `initial`, but also re-snapshot when the stored offset can no longer be streamed
+    /// (the slot was invalidated by `max_slot_wal_keep_size`, or dropped).
+    WhenNeeded,
+}
+
+/// How the initial snapshot (and a re-snapshot after the slot was lost) reads tables.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum SnapshotStrategy {
+    /// Read every table in the slot's exported snapshot before streaming starts
+    /// (`snapshot_max_threads` readers). One long read transaction per reader.
+    #[default]
+    Blocking,
+
+    /// Stream from the slot's position right away and read tables in key order, in chunks of
+    /// `incremental_snapshot_chunk_size` rows, each one short transaction interleaved with
+    /// streaming (Debezium's read-only incremental snapshot, watermarked with
+    /// `pg_current_snapshot()`). Needs a primary key (or `pk_override`) on every table.
+    Incremental,
+}
+
+/// What the source does when it would have to snapshot tables that nobody asked for (after the
+/// slot was lost).
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum UnplannedSnapshots {
+    /// Refuse to start until the re-snapshot is approved (`resnapshot_approved: true` in the
+    /// offset file).
+    #[default]
+    Hold,
+
+    /// Start it automatically.
+    Allow,
+}
+
+/// Whether the source creates its publication.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum PublicationAutocreateMode {
+    /// The publication must exist; the source never creates or changes it.
+    Disabled,
+
+    /// Create the publication for the tables the include/exclude lists capture, if it does not
+    /// exist. Needs ownership of those tables (or superuser).
+    #[default]
+    Filtered,
+
+    /// Create the publication `FOR ALL TABLES`, if it does not exist. Needs superuser.
+    AllTables,
+}
+
+/// How `NUMERIC`, `DECIMAL` and `MONEY` values are represented.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum DecimalHandlingMode {
+    /// The unscaled value as big-endian two's-complement bytes (Debezium's default). Columns
+    /// without a declared scale give `{"scale": …, "value": …}`. `NaN` and infinities give null.
+    #[default]
+    Precise,
+
+    /// The exact decimal as a string, such as `"1234.50"` (`"NaN"`, `"Infinity"` as such).
+    /// Recommended for data lakes.
+    String,
+
+    /// A JSON number. May lose precision.
+    Double,
+}
+
+/// How binary values (`BYTEA`, `BIT(n)`, precise decimals) are encoded.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum BinaryHandlingMode {
+    /// Standard base64 (what Debezium's JSON converter emits for bytes).
+    #[default]
+    Base64,
+
+    /// URL-safe base64.
+    Base64UrlSafe,
+
+    /// Lowercase hexadecimal.
+    Hex,
+}
+
+/// How `JSON` and `JSONB` values are represented.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum JsonHandlingMode {
+    /// The document as text, as PostgreSQL prints it (Debezium's convention).
+    #[default]
+    String,
+
+    /// The parsed document, embedded in the event.
+    Object,
+}
+
+/// How temporal values are represented.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum TimePrecisionMode {
+    /// `TIME` uses microseconds; `TIMESTAMP(0-3)` milliseconds and `TIMESTAMP(4-6)`
+    /// microseconds since the epoch.
+    #[default]
+    AdaptiveTimeMicroseconds,
+
+    /// Milliseconds for `TIME` and `TIMESTAMP` regardless of their precision.
+    Connect,
+}
+
+/// How `INTERVAL` values are represented.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum IntervalHandlingMode {
+    /// Microseconds, counting a month as 30.4375 days (Debezium's `numeric`).
+    #[default]
+    Numeric,
+
+    /// An ISO 8601 duration such as `"P1Y2M3DT4H5M6.78S"`.
+    String,
+}
+
+/// TLS mode for connections to PostgreSQL.
+#[configurable_component]
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum SslMode {
+    /// Do not use TLS.
+    Disable,
+
+    /// Require TLS but do not verify the server certificate.
+    Require,
+
+    /// Require TLS and verify the server certificate against the CA, without checking the host
+    /// name.
+    VerifyCa,
+
+    /// Require TLS, verify the server certificate and its host name.
+    #[default]
+    VerifyFull,
+}
+
+/// Configuration for the `postgres_cdc` source.
+#[configurable_component(source(
+    "postgres_cdc",
+    "Capture row-level changes from PostgreSQL through logical replication as Debezium-compatible events."
+))]
+#[derive(Clone, Debug)]
+#[serde(deny_unknown_fields)]
+pub struct PostgresCdcConfig {
+    /// The PostgreSQL server host name or IP address.
+    #[serde(default = "default_hostname")]
+    #[configurable(metadata(docs::examples = "postgres.internal"))]
+    pub hostname: String,
+
+    /// The PostgreSQL server port.
+    #[serde(default = "default_port")]
+    pub port: u16,
+
+    /// The user to connect as. It needs the `REPLICATION` attribute and `SELECT` on the captured
+    /// tables (and ownership of them for `publication_autocreate_mode: filtered`).
+    #[configurable(metadata(docs::examples = "vectezium"))]
+    pub user: String,
+
+    /// The password of the user.
+    #[serde(default)]
+    #[configurable(metadata(docs::examples = "${POSTGRES_PASSWORD}"))]
+    pub password: Option<SensitiveString>,
+
+    /// The database to capture. One source captures one database (a slot belongs to one).
+    #[configurable(metadata(docs::examples = "inventory"))]
+    pub database: String,
+
+    /// Logical name of the captured server, emitted as `source.name` (Debezium's `topic.prefix`).
+    #[serde(default = "default_topic_prefix")]
+    #[configurable(metadata(docs::examples = "dbserver1"))]
+    pub topic_prefix: String,
+
+    /// The logical replication slot. Created (with `pgoutput`) on the first start. Unique per
+    /// source: two sources must never share a slot.
+    #[serde(default = "default_slot_name")]
+    pub slot_name: String,
+
+    /// The publication the slot streams. See `publication_autocreate_mode`.
+    #[serde(default = "default_publication_name")]
+    pub publication_name: String,
+
+    /// Whether the source creates its publication.
+    #[serde(default)]
+    pub publication_autocreate_mode: PublicationAutocreateMode,
+
+    /// Regular expressions matching schema names to capture. Mutually exclusive with
+    /// `schema_exclude_list`.
+    #[serde(default)]
+    #[configurable(metadata(docs::examples = "public"))]
+    pub schema_include_list: Vec<String>,
+
+    /// Regular expressions matching schema names to skip.
+    #[serde(default)]
+    pub schema_exclude_list: Vec<String>,
+
+    /// Regular expressions matching `<schema>.<table>` to capture. Mutually exclusive with
+    /// `table_exclude_list`.
+    #[serde(default)]
+    #[configurable(metadata(docs::examples = "public\\.orders"))]
+    pub table_include_list: Vec<String>,
+
+    /// Regular expressions matching `<schema>.<table>` to skip.
+    #[serde(default)]
+    pub table_exclude_list: Vec<String>,
+
+    /// Regular expressions matching `<schema>.<table>.<column>` to omit from change events.
+    #[serde(default)]
+    #[configurable(metadata(docs::examples = "public\\.customers\\.ssn"))]
+    pub column_exclude_list: Vec<String>,
+
+    /// Key columns per table, replacing the primary key (or giving a table without one a key):
+    /// `pk_override.<schema>.<table>: "col1, col2"`. Like Debezium's `message.key.columns`.
+    #[serde(default)]
+    #[configurable(metadata(
+        docs::additional_props_description = "Tables of a schema and their key columns."
+    ))]
+    pub pk_override: HashMap<String, HashMap<String, String>>,
+
+    /// How the source bootstraps when it starts.
+    #[serde(default)]
+    pub snapshot_mode: SnapshotMode,
+
+    /// What to do when tables would have to be snapshotted without anyone asking for it (after
+    /// the slot was lost): `hold` (default) or `allow`.
+    #[serde(default)]
+    pub unplanned_snapshots: UnplannedSnapshots,
+
+    /// How the initial snapshot reads tables: `blocking` (in the slot's exported snapshot,
+    /// before streaming) or `incremental` (in chunks, while streaming).
+    #[serde(default)]
+    pub snapshot_strategy: SnapshotStrategy,
+
+    /// Snapshot the existing rows of captured tables that were never snapshotted: tables added
+    /// to the publication or the include lists later, and tables removed from
+    /// `snapshotted_tables` in the offset file (an ad-hoc snapshot). Found at start-up and read
+    /// incrementally while streaming. When `false`, such tables only get changes from the moment
+    /// they are captured.
+    #[serde(default)]
+    pub snapshot_new_tables: bool,
+
+    /// Rows per chunk of an incremental snapshot. Each chunk is read with one short query and
+    /// held in memory until the stream has caught up with it.
+    #[serde(default = "default_incremental_snapshot_chunk_size")]
+    #[configurable(metadata(docs::type_unit = "rows"))]
+    pub incremental_snapshot_chunk_size: usize,
+
+    /// The number of connections that read tables in parallel during the initial snapshot. All
+    /// of them read the slot's exported snapshot, so the result is the same as with one.
+    #[serde(default = "default_snapshot_max_threads")]
+    pub snapshot_max_threads: usize,
+
+    /// Rows fetched per round trip while snapshotting a table (a server-side cursor), which
+    /// bounds the memory a snapshot reader holds.
+    #[serde(default = "default_snapshot_fetch_size")]
+    #[configurable(metadata(docs::type_unit = "rows"))]
+    pub snapshot_fetch_size: usize,
+
+    /// How `NUMERIC`, `DECIMAL` and `MONEY` values are represented.
+    #[serde(default)]
+    pub decimal_handling_mode: DecimalHandlingMode,
+
+    /// How binary values are encoded.
+    #[serde(default)]
+    pub binary_handling_mode: BinaryHandlingMode,
+
+    /// How temporal values are represented.
+    #[serde(default)]
+    pub time_precision_mode: TimePrecisionMode,
+
+    /// How `INTERVAL` values are represented.
+    #[serde(default)]
+    pub interval_handling_mode: IntervalHandlingMode,
+
+    /// How `JSON` and `JSONB` values are represented.
+    #[serde(default)]
+    pub json_handling_mode: JsonHandlingMode,
+
+    /// Digits after the decimal point of `MONEY` values (match the server's `lc_monetary`).
+    #[serde(default = "default_money_fraction_digits")]
+    pub money_fraction_digits: u8,
+
+    /// The value of a large (TOASTed) column an update did not change, when the old row does
+    /// not have it either (`REPLICA IDENTITY` other than `FULL`). Debezium's
+    /// `unavailable.value.placeholder`.
+    #[serde(default = "default_unavailable_value_placeholder")]
+    pub unavailable_value_placeholder: String,
+
+    /// The shape of emitted row-change events.
+    #[serde(default)]
+    pub event_format: EventFormat,
+
+    /// Which row images `event_format: record` includes. Ignored for `debezium`.
+    #[serde(default)]
+    pub record_images: RecordImages,
+
+    /// When the snapshot of a table completes, emit a `snapshot_completed` event on the
+    /// `control` output with the snapshot's `snapshot_id`, `started_seq` and row count.
+    #[serde(default = "crate::serde::default_true")]
+    pub snapshot_end_markers: bool,
+
+    /// What to do when a row change cannot be converted.
+    #[serde(default)]
+    pub event_processing_failure_handling_mode: EventProcessingFailureHandlingMode,
+
+    /// Emit a schema document for every captured table on the `table_schemas` output, once per
+    /// distinct table definition (and again after each restart).
+    #[serde(default)]
+    pub include_table_schemas: bool,
+
+    /// Emit a `schema_change` event on the `control` output when a captured table's columns
+    /// change. PostgreSQL does not stream DDL, so the event describes the change (columns added,
+    /// removed, retyped) rather than the statement. (`truncate` and `snapshot_completed` events
+    /// are always emitted there.)
+    #[serde(default)]
+    pub include_schema_changes: bool,
+
+    /// Publish each committed offset on the `offsets` output, once everything up to it has been
+    /// delivered. Requires end-to-end acknowledgements.
+    #[serde(default)]
+    pub publish_offsets: bool,
+
+    /// Also send an unacknowledged copy of every event on the `observe` output, for viewers such
+    /// as a live feed (see `mysql_cdc`).
+    #[serde(default)]
+    pub observe_output: bool,
+
+    /// The minimum time between two published offsets.
+    #[serde(default = "default_offset_publish_interval_secs")]
+    #[configurable(metadata(docs::type_unit = "seconds"))]
+    pub offset_publish_interval_secs: u64,
+
+    /// Hold a lease on an Azure blob while running, so only one instance captures this database
+    /// at a time.
+    #[serde(default)]
+    pub single_writer_lock: Option<SingleWriterLockConfig>,
+
+    /// When there is no stored offset, resume from the last published offset in the lake.
+    /// Needs `single_writer_lock` and `publish_offsets`.
+    #[serde(default)]
+    pub offset_recovery: Option<OffsetRecoveryConfig>,
+
+    /// The maximum number of change events sent downstream in one batch.
+    #[serde(default = "default_batch_size")]
+    #[configurable(metadata(docs::type_unit = "events"))]
+    pub batch_size: usize,
+
+    /// The maximum number of events sent downstream in one batch while the initial snapshot
+    /// runs. Defaults to `batch_size`.
+    #[serde(default)]
+    #[configurable(metadata(docs::type_unit = "events"))]
+    pub snapshot_batch_size: Option<usize>,
+
+    /// How often the source reports its position to the server (and answers keepalives at the
+    /// latest). Keep it well below the server's `wal_sender_timeout`.
+    #[serde(default = "default_status_update_interval_secs")]
+    #[configurable(metadata(docs::type_unit = "seconds"))]
+    pub status_update_interval_secs: u64,
+
+    /// The timeout for establishing a connection.
+    #[serde(default = "default_connect_timeout_secs")]
+    #[configurable(metadata(docs::type_unit = "seconds"))]
+    pub connect_timeout_secs: u64,
+
+    /// TLS mode for connections to PostgreSQL.
+    #[serde(default)]
+    pub ssl_mode: SslMode,
+
+    /// Path to a PEM file with the CA certificate(s) used to verify the server. When not set,
+    /// the system trust store is used.
+    #[serde(default)]
+    #[configurable(metadata(docs::examples = "/etc/ssl/certs/postgres-ca.pem"))]
+    pub ssl_ca_file: Option<PathBuf>,
+
+    /// The directory used to persist offsets. By default, the global `data_dir` option is used.
+    #[serde(default)]
+    #[configurable(metadata(docs::examples = "/var/lib/vector"))]
+    #[configurable(metadata(docs::human_name = "Data Directory"))]
+    pub data_dir: Option<PathBuf>,
+
+    #[serde(default, deserialize_with = "crate::serde::bool_or_struct")]
+    pub acknowledgements: SourceAcknowledgementsConfig,
+
+    /// The namespace to use for logs. This overrides the global setting.
+    #[configurable(metadata(docs::hidden))]
+    #[serde(default)]
+    pub log_namespace: Option<bool>,
+}

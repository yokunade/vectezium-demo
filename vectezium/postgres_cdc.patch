+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn generate_config() {
+        crate::test_util::test_generate_config::<PostgresCdcConfig>();
+    }
+
+    #[test]
+    fn parses_full_config() {
+        let config: PostgresCdcConfig = serde_yaml::from_str(indoc::indoc! {r#"
+            hostname: db
+            user: cdc
+            password: secret
+            database: shop
+            slot_name: lake
+            table_include_list: ["public\\.orders"]
+            snapshot_mode: when_needed
+            snapshot_max_threads: 4
+            event_format: record
+            record_images: before_and_after
+            decimal_handling_mode: string
+            interval_handling_mode: string
+            ssl_mode: require
+            acknowledgements: true
+        "#})
+        .unwrap();
+        assert_eq!(config.port, 5432);
+        assert_eq!(config.slot_name, "lake");
+        assert_eq!(config.publication_name, "vectezium");
+        assert_eq!(
+            config.publication_autocreate_mode,
+            PublicationAutocreateMode::Filtered
+        );
+        assert_eq!(config.snapshot_mode, SnapshotMode::WhenNeeded);
+        assert_eq!(config.decimal_handling_mode, DecimalHandlingMode::String);
+        assert_eq!(config.interval_handling_mode, IntervalHandlingMode::String);
+        assert_eq!(config.ssl_mode, SslMode::Require);
+        assert_eq!(
+            config.unavailable_value_placeholder,
+            "__debezium_unavailable_value"
+        );
+        assert!(config.acknowledgements.enabled());
+    }
+
+    #[test]
+    fn database_is_required() {
+        assert!(serde_yaml::from_str::<PostgresCdcConfig>("user: u").is_err());
+    }
+
+    #[test]
+    fn outputs_include_control_and_optional_ports() {
+        let mut config: PostgresCdcConfig =
+            serde_yaml::from_str("user: u\ndatabase: d").unwrap();
+        assert_eq!(config.outputs(LogNamespace::Legacy).len(), 2);
+        config.include_table_schemas = true;
+        config.publish_offsets = true;
+        config.observe_output = true;
+        let outputs = config.outputs(LogNamespace::Legacy);
+        assert_eq!(outputs.len(), 5);
+        assert_eq!(outputs[1].port.as_deref(), Some(TABLE_SCHEMAS_OUTPUT));
+        assert_eq!(outputs[3].port.as_deref(), Some(OFFSETS_OUTPUT));
+    }
+}
diff --git a/src/sources/postgres_cdc/offset.rs b/src/sources/postgres_cdc/offset.rs
new file mode 100644
index 0000000..4cc9132
--- /dev/null
+++ b/src/sources/postgres_cdc/offset.rs
@@ -0,0 +1,241 @@
+//! Offsets: a WAL position (LSN) at a transaction boundary. Storage, checkpointing and
+//! publishing are shared by every connector (`cdc::checkpoint`); [`Offset`] is PostgreSQL's
+//! [`CdcOffset`].
+//!
+//! `lsn` is the end of the last fully processed commit record, or (while no captured changes
+//! flow) a position the server reported with nothing pending before it. Every transaction that
+//! commits at or after it is still to come; every one before it was processed. Resuming
+//! therefore skips transactions whose commit LSN is before `lsn`.
+
+use std::{fmt, str::FromStr};
+
+use serde::{Deserialize, Deserializer, Serialize, Serializer};
+use serde_json::{Map, Value as Json};
+
+pub use crate::sources::cdc::checkpoint::CheckpointStore;
+use crate::sources::cdc::checkpoint::CdcOffset;
+
+/// Current on-disk checkpoint format version.
+const CHECKPOINT_VERSION: u32 = 1;
+
+/// A captured table: `(schema, table)`.
+pub type TableRef = (String, String);
+
+/// A WAL position, printed the way PostgreSQL prints it (`16/B374D848`).
+#[derive(Clone, Copy, Debug, Default, Eq, Ord, PartialEq, PartialOrd, Hash)]
+pub struct Lsn(pub u64);
+
+impl fmt::Display for Lsn {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{:X}/{:X}", self.0 >> 32, self.0 & 0xFFFF_FFFF)
+    }
+}
+
+impl FromStr for Lsn {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let (hi, lo) = s
+            .trim()
+            .split_once('/')
+            .ok_or_else(|| format!("invalid LSN `{s}`"))?;
+        let hi = u64::from_str_radix(hi, 16).map_err(|_| format!("invalid LSN `{s}`"))?;
+        let lo = u64::from_str_radix(lo, 16).map_err(|_| format!("invalid LSN `{s}`"))?;
+        if hi > 0xFFFF_FFFF || lo > 0xFFFF_FFFF {
+            return Err(format!("invalid LSN `{s}`"));
+        }
+        Ok(Self((hi << 32) | lo))
+    }
+}
+
+impl Serialize for Lsn {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.collect_str(self)
+    }
+}
+
+impl<'de> Deserialize<'de> for Lsn {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let s = String::deserialize(deserializer)?;
+        s.parse().map_err(serde::de::Error::custom)
+    }
+}
+
+/// A resumable position in the WAL.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct Offset {
+    /// Checkpoint format version.
+    #[serde(default = "default_version")]
+    pub version: u32,
+    /// Where to resume: transactions committing before it were processed.
+    pub lsn: Lsn,
+    /// The slot the position belongs to.
+    pub slot_name: String,
+    /// The server's `system_identifier`: a slot (and its LSNs) only exists on one cluster.
+    #[serde(default)]
+    pub system_identifier: Option<String>,
+    /// Whether the initial snapshot completed. When `false`, the snapshot is taken again.
+    pub snapshot_completed: bool,
+    /// The tables the completed snapshot covered (or that were captured when the source started
+    /// with `no_data`).
+    #[serde(default)]
+    pub snapshotted_tables: Vec<TableRef>,
+    /// The counter of the next change event (see `cdc::seq`).
+    #[serde(default = "default_next_seq")]
+    pub next_seq: u64,
+    /// The position of the last snapshot event after `next_seq - 1`.
+    #[serde(default)]
+    pub seq_sub: u64,
+    /// Set by an operator (in the offset file, while the source is stopped) to allow the
+    /// re-snapshot after the slot was lost, when `unplanned_snapshots` is `hold`.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub resnapshot_approved: bool,
+    /// The incremental snapshot in progress, if any (same shape as `mysql_cdc`'s, so the same
+    /// tools can queue tables).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub incremental: Option<IncrementalProgress>,
+}
+
+/// An incremental snapshot: tables read in key order, in chunks, while changes stream.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub struct IncrementalProgress {
+    pub snapshot_id: String,
+    /// When the snapshot started (ms since the epoch); informational.
+    pub started_ms: i64,
+    /// The `seq` when the first table in `tables` started being read: changes with a `seq` at
+    /// or above it are newer than the snapshot of that table.
+    #[serde(default)]
+    pub started_seq: Option<u64>,
+    /// Tables still to snapshot; the first is in progress.
+    pub tables: Vec<TableRef>,
+    /// SQL literals of the key of the last row delivered from the first table.
+    #[serde(default)]
+    pub last_key: Option<Vec<String>>,
+    /// Rows delivered so far from the first table.
+    #[serde(default)]
+    pub rows: u64,
+}
+
+impl IncrementalProgress {
+    pub fn new(tables: Vec<TableRef>) -> Self {
+        Self {
+            snapshot_id: chrono::Utc::now().format("%Y%m%dT%H%M%S%.6fZ").to_string(),
+            started_ms: chrono::Utc::now().timestamp_millis(),
+            started_seq: None,
+            tables,
+            last_key: None,
+            rows: 0,
+        }
+    }
+}
+
+const fn default_version() -> u32 {
+    CHECKPOINT_VERSION
+}
+
+const fn default_next_seq() -> u64 {
+    1
+}
+
+impl Offset {
+    pub fn new(lsn: Lsn, slot_name: &str, system_identifier: Option<String>) -> Self {
+        Self {
+            version: CHECKPOINT_VERSION,
+            lsn,
+            slot_name: slot_name.to_owned(),
+            system_identifier,
+            snapshot_completed: false,
+            snapshotted_tables: Vec::new(),
+            next_seq: 1,
+            seq_sub: 0,
+            resnapshot_approved: false,
+            incremental: None,
+        }
+    }
+
+    /// The same offset at another position.
+    #[must_use]
+    pub fn at(&self, lsn: Lsn) -> Self {
+        let mut offset = self.clone();
+        offset.lsn = lsn;
+        offset.resnapshot_approved = false;
+        offset
+    }
+}
+
+impl fmt::Display for Offset {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "slot {} lsn {}", self.slot_name, self.lsn)
+    }
+}
+
+impl CdcOffset for Offset {
+    fn seq(&self) -> (u64, u64) {
+        (self.next_seq, self.seq_sub)
+    }
+
+    fn set_seq(&mut self, next_seq: u64, seq_sub: u64) {
+        self.next_seq = next_seq;
+        self.seq_sub = seq_sub;
+    }
+
+    fn snapshot_in_progress(&self) -> bool {
+        !self.snapshot_completed || self.incremental.is_some()
+    }
+
+    fn publish_position(&self, payload: &mut Map<String, Json>) {
+        payload.insert("lsn".into(), Json::from(self.lsn.to_string()));
+        payload.insert("slot_name".into(), Json::from(self.slot_name.as_str()));
+    }
+
+    fn advances_without_seq(&self, published: &Self) -> bool {
+        self.lsn > published.lsn
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lsn_text_roundtrip() {
+        let lsn: Lsn = "16/B374D848".parse().unwrap();
+        assert_eq!(lsn.0, 0x16_B374_D848);
+        assert_eq!(lsn.to_string(), "16/B374D848");
+        assert_eq!(Lsn(0).to_string(), "0/0");
+        assert!("16B374D848".parse::<Lsn>().is_err());
+        assert!("1FFFFFFFF/0".parse::<Lsn>().is_err());
+        assert!(Lsn(5) < "0/6".parse().unwrap());
+    }
+
+    #[test]
+    fn offset_json_roundtrip() {
+        let mut offset = Offset::new(Lsn(0x1_0000_0010), "lake", Some("7300".into()));
+        offset.snapshot_completed = true;
+        offset.snapshotted_tables = vec![("public".into(), "orders".into())];
+        offset.set_seq(42, 3);
+        let json = serde_json::to_value(&offset).unwrap();
+        assert_eq!(json["lsn"], Json::from("1/10"));
+        assert!(json.get("resnapshot_approved").is_none());
+        let back: Offset = serde_json::from_value(json).unwrap();
+        assert_eq!(back, offset);
+    }
+
+    #[test]
+    fn approval_is_read_and_cleared_on_move() {
+        let offset: Offset = serde_json::from_value(serde_json::json!({
+            "lsn": "0/10", "slot_name": "s", "snapshot_completed": true, "resnapshot_approved": true
+        }))
+        .unwrap();
+        assert!(offset.resnapshot_approved);
+        assert_eq!(offset.next_seq, 1);
+        assert!(!offset.at(Lsn(0x20)).resnapshot_approved);
+    }
+
+    #[test]
+    fn idle_offsets_advance_without_seq() {
+        let offset = Offset::new(Lsn(10), "s", None);
+        assert!(offset.at(Lsn(11)).advances_without_seq(&offset));
+        assert!(!offset.advances_without_seq(&offset));
+    }
+}
diff --git a/src/sources/postgres_cdc/snapshot.rs b/src/sources/postgres_cdc/snapshot.rs
new file mode 100644
index 0000000..9c3e3fd
--- /dev/null
+++ b/src/sources/postgres_cdc/snapshot.rs
@@ -0,0 +1,325 @@
+//! The initial snapshot, read from the replication slot's exported snapshot:
+//!
+//! 1. `CREATE_REPLICATION_SLOT … EXPORT_SNAPSHOT` creates the slot and exports a snapshot of the
+//!    database exactly at the slot's consistent point;
+//! 2. each of the `snapshot_max_threads` connections imports it (`SET TRANSACTION SNAPSHOT`)
+//!    while the exporting connection is still idle, so all of them see the same instant;
+//! 3. tables are read through server-side cursors (`snapshot_fetch_size` rows per round trip),
+//!    in parallel, as `op: r` events;
+//! 4. streaming then starts at the consistent point: every change after the snapshot comes from
+//!    the slot, and none before it. No locks are taken.
+//!
+//! The snapshot's offset is only stored once every snapshot event has been delivered. If the
+//! source stops before that, the slot is replaced and the snapshot taken again.
+
+use std::{
+    collections::{HashMap, VecDeque},
+    sync::{Arc, Mutex},
+};
+
+use chrono::Utc;
+use pgrepl_tokio_postgres::{Client, SimpleQueryMessage};
+use tokio::sync::mpsc;
+
+use super::{
+    catalog::{TableInfo, TypeRegistry, quote_ident},
+    connection::{error_text, simple_rows},
+    envelope::{Op, SnapshotMarker},
+    offset::{Lsn, Offset, TableRef},
+    source::{Emitter, EventBuilder, EventMeta, Settings, note_table_schema, row_event, row_map},
+};
+use crate::{event::LogEvent, shutdown::ShutdownSignal, sources::cdc::control::snapshot_completed};
+
+/// What a reader sends the emitting task.
+enum Read {
+    Row(usize, LogEvent),
+    Done(usize, u64),
+    Failed(String),
+}
+
+/// A new snapshot id (sortable, unique per snapshot).
+fn new_snapshot_id() -> String {
+    Utc::now().format("%Y%m%dT%H%M%S%.6fZ").to_string()
+}
+
+/// Takes the snapshot. Returns the offset to stream from, or `None` if the source was shut down.
+pub(super) async fn run(
+    settings: Arc<Settings>,
+    query: &Client,
+    registry: &TypeRegistry,
+    emitter: &mut Emitter,
+    captured: &[TableRef],
+    system_id: &str,
+    mut shutdown: ShutdownSignal,
+) -> Result<Option<Offset>, String> {
+    // 1. The slot and its exported snapshot.
+    let repl = settings.conn.connect(true).await?;
+    let created = simple_rows(
+        &repl,
+        &format!(
+            "CREATE_REPLICATION_SLOT {} LOGICAL pgoutput EXPORT_SNAPSHOT",
+            quote_ident(&settings.slot_name)
+        ),
+    )
+    .await
+    .map_err(|error| {
+        format!(
+            "failed to create replication slot `{}`: {}",
+            settings.slot_name,
+            error_text(&error)
+        )
+    })?;
+    let row = created.first().ok_or("CREATE_REPLICATION_SLOT returned nothing")?;
+    let lsn: Lsn = row
+        .get(1)
+        .cloned()
+        .flatten()
+        .ok_or("CREATE_REPLICATION_SLOT returned no position")?
+        .parse()?;
+    let snapshot_name = row
+        .get(2)
+        .cloned()
+        .flatten()
+        .ok_or("CREATE_REPLICATION_SLOT exported no snapshot")?;
+
+    // The tables as the catalog describes them now.
+    let mut tables = Vec::with_capacity(captured.len());
+    for (schema, table) in captured {
+        if let Some(info) = TableInfo::from_catalog(
+            query,
+            registry,
+            &settings.filters,
+            &settings.convert,
+            schema,
+            table,
+        )
+        .await?
+        {
+            settings.warn_if_keyless(&info);
+            tables.push(Arc::new(info));
+        }
+    }
+
+    // 2. Every reader imports the snapshot before the exporting connection does anything else.
+    let threads = settings.snapshot_threads.min(tables.len()).max(1);
+    let mut readers = Vec::with_capacity(threads);
+    for _ in 0..threads {
+        let client = settings.conn.connect(false).await?;
+        client
+            .batch_execute(&format!(
+                "BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY; SET TRANSACTION SNAPSHOT '{}'",
+                snapshot_name.replace('\'', "''")
+            ))
+            .await
+            .map_err(|error| format!("failed to import the slot's snapshot: {}", error_text(&error)))?;
+        readers.push(client);
+    }
+    drop(repl);
+    info!(
+        message = "Created the replication slot; snapshotting tables.",
+        slot = %settings.slot_name,
+        lsn = %lsn,
+        tables = tables.len(),
+        threads,
+    );
+
+    let snapshot_id = new_snapshot_id();
+    let started_seq = emitter.next_seq();
+    let started_ms = Utc::now().timestamp_millis();
+    let previous_batch = emitter.set_batch_size(settings.snapshot_batch_size);
+    for info in &tables {
+        note_table_schema(emitter, &settings, info, "snapshot", Some(lsn));
+    }
+
+    // 3. Readers take tables from a shared queue.
+    let queue = Arc::new(Mutex::new((0..tables.len()).collect::<VecDeque<_>>()));
+    let (tx, mut rx) = mpsc::channel::<Read>(4096);
+    let builder = emitter.builder();
+    let mut tasks = Vec::with_capacity(threads);
+    for client in readers {
+        let (queue, tx, tables, settings) = (
+            Arc::clone(&queue),
+            tx.clone(),
+            tables.clone(),
+            Arc::clone(&settings),
+        );
+        let snapshot_id = snapshot_id.clone();
+        tasks.push(tokio::spawn(async move {
+            let result = read_tables(&client, &queue, &tx, &tables, &settings, builder, lsn, &snapshot_id).await;
+            if let Err(error) = result {
+                _ = tx.send(Read::Failed(error)).await;
+            }
+            _ = client.batch_execute("COMMIT").await;
+        }));
+    }
+    drop(tx);
+
+    // The emitting side: one row of each table is held back, so the last row of a table (and of
+    // the whole snapshot) can be marked as such.
+    let mut held: HashMap<usize, LogEvent> = HashMap::new();
+    let mut first = true;
+    let mut done_tables = 0;
+    let mut rows_total = 0u64;
+    let mark = |event: &mut LogEvent, marker: SnapshotMarker| builder.set_snapshot_marker(event, marker);
+    loop {
+        let read = tokio::select! {
+            _ = &mut shutdown => {
+                for task in &tasks {
+                    task.abort();
+                }
+                info!(message = "Shut down during the snapshot; it will be taken again on the next start.");
+                return Ok(None);
+            }
+            read = rx.recv() => read,
+        };
+        match read {
+            None => break,
+            Some(Read::Failed(error)) => {
+                for task in &tasks {
+                    task.abort();
+                }
+                return Err(format!("snapshot failed: {error}"));
+            }
+            Some(Read::Row(table, event)) => {
+                if let Some(mut previous) = held.insert(table, event) {
+                    if first {
+                        mark(&mut previous, SnapshotMarker::First);
+                        first = false;
+                    }
+                    emitter.push_snapshot_row(previous);
+                }
+            }
+            Some(Read::Done(table, rows)) => {
+                done_tables += 1;
+                rows_total += rows;
+                if let Some(mut last) = held.remove(&table) {
+                    let marker = if done_tables == tables.len() {
+                        SnapshotMarker::Last
+                    } else if first {
+                        SnapshotMarker::First
+                    } else {
+                        SnapshotMarker::LastInDataCollection
+                    };
+                    first = false;
+                    mark(&mut last, marker);
+                    emitter.push_snapshot_row(last);
+                }
+                let info = &tables[table];
+                if settings.snapshot_end_markers {
+                    emitter.push_control(
+                        snapshot_completed(
+                            &settings.topic_prefix,
+                            &info.schema,
+                            &info.table,
+                            &snapshot_id,
+                            started_seq,
+                            started_ms,
+                            rows,
+                            Some(&info.schema_version),
+                        ),
+                        EventMeta {
+                            key: None,
+                            database: &info.schema,
+                            table: Some(&info.table),
+                            op: "snapshot_completed",
+                            timestamp: Utc::now(),
+                            schema_version: None,
+                        },
+                        true,
+                    );
+                }
+                info!(message = "Snapshotted table.", table = %format!("{}.{}", info.schema, info.table), rows);
+            }
+        }
+        emitter.maybe_flush().await?;
+        emitter.check_health()?;
+    }
+
+    // 4. Done: stream from the consistent point.
+    let mut offset = Offset::new(lsn, &settings.slot_name, Some(system_id.to_owned()));
+    offset.snapshot_completed = true;
+    offset.snapshotted_tables = tables.iter().map(|t| (t.schema.clone(), t.table.clone())).collect();
+    emitter.commit(offset.clone());
+    emitter.flush().await?;
+    emitter.set_batch_size(previous_batch);
+    info!(message = "Snapshot complete.", tables = tables.len(), rows = rows_total, lsn = %lsn);
+    Ok(Some(offset))
+}
+
+/// One reader: takes tables from `queue` and sends their rows.
+#[allow(clippy::too_many_arguments)]
+async fn read_tables(
+    client: &Client,
+    queue: &Mutex<VecDeque<usize>>,
+    tx: &mpsc::Sender<Read>,
+    tables: &[Arc<TableInfo>],
+    settings: &Settings,
+    builder: EventBuilder,
+    lsn: Lsn,
+    snapshot_id: &str,
+) -> Result<(), String> {
+    loop {
+        let Some(index) = queue.lock().ok().and_then(|mut q| q.pop_front()) else {
+            return Ok(());
+        };
+        let info = &tables[index];
+        let name = format!("{}.{}", quote_ident(&info.schema), quote_ident(&info.table));
+        let columns = info
+            .columns
+            .iter()
+            .map(|c| quote_ident(&c.name))
+            .collect::<Vec<_>>()
+            .join(", ");
+        client
+            .batch_execute(&format!("DECLARE vtz_snapshot NO SCROLL CURSOR FOR SELECT {columns} FROM {name}"))
+            .await
+            .map_err(|error| format!("failed to read {name}: {}", error_text(&error)))?;
+        let fetch = format!("FETCH {} FROM vtz_snapshot", settings.fetch_size);
+        let now = Utc::now();
+        let mut rows = 0u64;
+        loop {
+            let messages = client
+                .simple_query(&fetch)
+                .await
+                .map_err(|error| format!("failed to read {name}: {}", error_text(&error)))?;
+            let mut fetched = 0;
+            for message in messages {
+                let SimpleQueryMessage::Row(row) = message else {
+                    continue;
+                };
+                fetched += 1;
+                let after = match row_map(settings, info, |i| row.get(i)) {
+                    Ok(after) => after,
+                    Err(error) => {
+                        settings.handle_failure(error, &info.schema, &info.table)?;
+                        continue;
+                    }
+                };
+                let source = settings.source_info(
+                    info,
+                    now.timestamp_micros(),
+                    SnapshotMarker::True,
+                    None,
+                    Some(lsn),
+                    None,
+                );
+                let mut event = row_event(&builder, info, Op::Read, None, Some(after), &source, now);
+                builder.set_snapshot_id(&mut event, snapshot_id);
+                rows += 1;
+                if tx.send(Read::Row(index, event)).await.is_err() {
+                    return Ok(());
+                }
+            }
+            if fetched < settings.fetch_size {
+                break;
+            }
+        }
+        client
+            .batch_execute("CLOSE vtz_snapshot")
+            .await
+            .map_err(|error| format!("failed to read {name}: {}", error_text(&error)))?;
+        if tx.send(Read::Done(index, rows)).await.is_err() {
+            return Ok(());
+        }
+    }
+}
diff --git a/src/sources/postgres_cdc/source.rs b/src/sources/postgres_cdc/source.rs
new file mode 100644
index 0000000..5b52bf1
--- /dev/null
+++ b/src/sources/postgres_cdc/source.rs
@@ -0,0 +1,863 @@
+//! Source orchestration: start-up decisions (slot, publication, snapshot or stream) and the row
+//! building both phases share. Batching, `seq` numbering and acknowledgement-driven
+//! checkpointing are the shared CDC core (`sources::cdc`).
+
+use std::{
+    collections::{HashMap, HashSet},
+    path::PathBuf,
+    sync::{Arc, Mutex, atomic::AtomicBool},
+    time::Duration,
+};
+
+use chrono::{DateTime, Utc};
+use pgrepl_tokio_postgres::Client;
+use serde_json::{Map, Value as Json};
+use vector_lib::config::LogNamespace;
+
+use super::{
+    EventFormat, EventProcessingFailureHandlingMode, PostgresCdcConfig, PublicationAutocreateMode,
+    RecordImages, SnapshotMode, SnapshotStrategy, UnplannedSnapshots,
+    catalog::{self, TableInfo, TypeRegistry, quote_ident},
+    connection::{ConnectionSettings, error_text, simple_rows},
+    convert::{self, ConvertOptions},
+    envelope::{Op, SourceInfo},
+    filter::Filters,
+    offset::{CheckpointStore, IncrementalProgress, Lsn, Offset, TableRef},
+    snapshot, stream, table_schema,
+};
+pub(super) use crate::sources::cdc::emitter::{EventBuilder, EventMeta};
+use crate::{
+    SourceSender,
+    config::SourceContext,
+    internal_events::{PostgresCdcConnectionError, PostgresCdcDecodeError},
+    shutdown::ShutdownSignal,
+    sources::{
+        Source,
+        cdc::{
+            checkpoint::{Checkpoints, OffsetPublisher, check_acknowledgements},
+            lock::{WriterGuard, run_locked},
+            recovery::{OffsetRecovery, Recovered},
+        },
+        source_with_error,
+    },
+};
+
+/// Schemas that are never captured.
+const SYSTEM_SCHEMAS: &[&str] = &["pg_catalog", "information_schema", "pg_toast"];
+
+/// Version reported in `source.version`.
+pub const CONNECTOR_VERSION: &str = concat!("vector-postgres_cdc-", env!("CARGO_PKG_VERSION"));
+
+/// PostgreSQL's emitter: the shared CDC emitter with WAL offsets.
+pub(super) type Emitter = crate::sources::cdc::emitter::Emitter<Offset>;
+
+/// Static settings shared by the snapshot and streaming phases.
+pub(super) struct Settings {
+    pub conn: ConnectionSettings,
+    pub database: String,
+    pub topic_prefix: String,
+    pub slot_name: String,
+    pub publication_name: String,
+    pub autocreate: PublicationAutocreateMode,
+    pub filters: Filters,
+    pub convert: ConvertOptions,
+    pub placeholder: String,
+    pub include_schema_changes: bool,
+    pub include_table_schemas: bool,
+    pub observe_output: bool,
+    pub snapshot_end_markers: bool,
+    pub snapshot_mode: SnapshotMode,
+    pub snapshot_strategy: SnapshotStrategy,
+    pub snapshot_new_tables: bool,
+    pub incremental_chunk_size: usize,
+    pub unplanned_snapshots: UnplannedSnapshots,
+    pub failure_mode: EventProcessingFailureHandlingMode,
+    pub snapshot_batch_size: usize,
+    pub snapshot_threads: usize,
+    pub fetch_size: usize,
+    pub event_format: EventFormat,
+    pub record_images: RecordImages,
+    pub publish_offsets: Option<Duration>,
+    pub status_interval: Duration,
+    /// Tables already reported as having no key.
+    pub warned_no_key: Mutex<HashSet<String>>,
+}
+
+impl Settings {
+    /// Warns once per table that has neither a primary key nor `pk_override`.
+    pub fn warn_if_keyless(&self, info: &TableInfo) {
+        if !info.key.is_empty() {
+            return;
+        }
+        let name = format!("{}.{}", info.schema, info.table);
+        let first = self
+            .warned_no_key
+            .lock()
+            .map(|mut warned| warned.insert(name.clone()))
+            .unwrap_or(false);
+        if first {
+            warn!(
+                message = "Table has no primary key; its change events carry no key, so a downstream \
+                           merge cannot identify rows. Add a primary key or set `pk_override.<schema>.<table>`.",
+                table = %name,
+                internal_log_rate_limit = false,
+            );
+        }
+    }
+
+    /// Applies `event_processing_failure_handling_mode` to a change that could not be converted.
+    pub fn handle_failure(&self, error: String, schema: &str, table: &str) -> Result<(), String> {
+        match self.failure_mode {
+            EventProcessingFailureHandlingMode::Fail => {
+                let message = format!("failed to convert a change in {schema}.{table}: {error}");
+                emit!(PostgresCdcDecodeError { error, schema, table });
+                Err(message)
+            }
+            EventProcessingFailureHandlingMode::Warn => {
+                emit!(PostgresCdcDecodeError { error, schema, table });
+                Ok(())
+            }
+            EventProcessingFailureHandlingMode::Skip => {
+                debug!(message = "Skipping change that could not be converted.", %error, schema, table);
+                Ok(())
+            }
+        }
+    }
+
+    /// The `source` block of a change in `info`.
+    pub fn source_info<'a>(
+        &'a self,
+        info: &'a TableInfo,
+        ts_us: i64,
+        snapshot: super::envelope::SnapshotMarker,
+        txid: Option<u32>,
+        lsn: Option<Lsn>,
+        last_commit_lsn: Option<Lsn>,
+    ) -> SourceInfo<'a> {
+        SourceInfo {
+            connector_version: CONNECTOR_VERSION,
+            name: &self.topic_prefix,
+            ts_us,
+            snapshot,
+            database: &self.database,
+            schema: &info.schema,
+            table: &info.table,
+            txid,
+            lsn,
+            last_commit_lsn,
+        }
+    }
+}
+
+/// Converts one row: `value(i)` gives column `i`'s text (`None` for SQL `NULL`). Excluded
+/// columns are left out.
+pub(super) fn row_map<'v>(
+    settings: &Settings,
+    info: &TableInfo,
+    value: impl Fn(usize) -> Option<&'v str>,
+) -> Result<Map<String, Json>, String> {
+    let mut row = Map::with_capacity(info.columns.len());
+    for (i, column) in info.columns.iter().enumerate() {
+        if column.excluded {
+            continue;
+        }
+        row.insert(
+            column.name.clone(),
+            convert::convert(column, value(i), &settings.convert)?,
+        );
+    }
+    Ok(row)
+}
+
+/// The key of a row (its key columns), or `None` for a table without a key.
+pub(super) fn row_key(info: &TableInfo, row: &Map<String, Json>) -> Option<Map<String, Json>> {
+    if info.key.is_empty() {
+        return None;
+    }
+    let mut key = Map::with_capacity(info.key.len());
+    for &i in &info.key {
+        let name = &info.columns[i].name;
+        key.insert(name.clone(), row.get(name).cloned().unwrap_or(Json::Null));
+    }
+    Some(key)
+}
+
+/// Builds a row-change event.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn row_event(
+    builder: &EventBuilder,
+    info: &TableInfo,
+    op: Op,
+    before: Option<Map<String, Json>>,
+    after: Option<Map<String, Json>>,
+    source: &SourceInfo<'_>,
+    timestamp: DateTime<Utc>,
+) -> crate::event::LogEvent {
+    let key = match op {
+        Op::Delete => before.as_ref().and_then(|row| row_key(info, row)),
+        _ => after.as_ref().and_then(|row| row_key(info, row)),
+    };
+    builder.row_change(
+        op,
+        before,
+        after,
+        source,
+        EventMeta {
+            key,
+            database: &info.schema,
+            table: Some(&info.table),
+            op: op.code(),
+            timestamp,
+            schema_version: Some(&info.schema_version),
+        },
+    )
+}
+
+/// Queues the schema document of `info`, the first time this process sees its version.
+pub(super) fn note_table_schema(
+    emitter: &mut Emitter,
+    settings: &Settings,
+    info: &TableInfo,
+    origin: &'static str,
+    lsn: Option<Lsn>,
+) {
+    emitter.note_schema_document(&info.schema, &info.table, &info.schema_version, || {
+        table_schema::document(
+            &info.schema_core,
+            &info.schema_version,
+            &settings.topic_prefix,
+            &settings.database,
+            origin,
+            lsn,
+        )
+    });
+}
+
+pub(super) async fn build(config: &PostgresCdcConfig, cx: SourceContext) -> crate::Result<Source> {
+    if config.database.is_empty() {
+        return Err("`database` must name the database to capture".into());
+    }
+    if config.batch_size == 0 || config.snapshot_batch_size == Some(0) {
+        return Err("`batch_size` and `snapshot_batch_size` must be greater than zero".into());
+    }
+    if config.snapshot_max_threads == 0 || config.snapshot_max_threads > 64 {
+        return Err("`snapshot_max_threads` must be between 1 and 64".into());
+    }
+    let valid_name = |s: &str| {
+        !s.is_empty()
+            && s.len() <= 63
+            && s.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'_')
+    };
+    if config.snapshot_strategy == SnapshotStrategy::Incremental
+        && config.snapshot_mode == SnapshotMode::InitialOnly
+    {
+        return Err("`snapshot_strategy: incremental` reads tables while streaming, so it cannot be \
+                    combined with `snapshot_mode: initial_only`"
+            .into());
+    }
+    if !valid_name(&config.slot_name) {
+        return Err("`slot_name` may only contain lower-case letters, digits and `_` (at most 63)".into());
+    }
+
+    let filters = Filters::new(
+        &config.schema_include_list,
+        &config.schema_exclude_list,
+        &config.table_include_list,
+        &config.table_exclude_list,
+        &config.column_exclude_list,
+    )
+    .map_err(|e| e.replace("database_", "schema_"))?
+    .with_system_databases(SYSTEM_SCHEMAS)
+    .with_key_columns(key_columns(&config.pk_override)?);
+
+    let data_dir = cx
+        .globals
+        .resolve_and_make_data_subdir(config.data_dir.as_ref(), cx.key.id())?;
+
+    let settings = Settings {
+        conn: ConnectionSettings::new(config)?,
+        database: config.database.clone(),
+        topic_prefix: config.topic_prefix.clone(),
+        slot_name: config.slot_name.clone(),
+        publication_name: config.publication_name.clone(),
+        autocreate: config.publication_autocreate_mode,
+        filters,
+        convert: ConvertOptions {
+            decimal: config.decimal_handling_mode,
+            binary: config.binary_handling_mode,
+            time_precision: config.time_precision_mode,
+            interval: config.interval_handling_mode,
+            json: config.json_handling_mode,
+            money_fraction_digits: config.money_fraction_digits,
+        },
+        placeholder: config.unavailable_value_placeholder.clone(),
+        include_schema_changes: config.include_schema_changes,
+        include_table_schemas: config.include_table_schemas,
+        observe_output: config.observe_output,
+        snapshot_end_markers: config.snapshot_end_markers,
+        snapshot_mode: config.snapshot_mode,
+        snapshot_strategy: config.snapshot_strategy,
+        snapshot_new_tables: config.snapshot_new_tables,
+        incremental_chunk_size: config.incremental_snapshot_chunk_size.max(1),
+        unplanned_snapshots: config.unplanned_snapshots,
+        failure_mode: config.event_processing_failure_handling_mode,
+        snapshot_batch_size: config.snapshot_batch_size.unwrap_or(config.batch_size),
+        snapshot_threads: config.snapshot_max_threads,
+        fetch_size: config.snapshot_fetch_size.max(1),
+        event_format: config.event_format,
+        record_images: config.record_images,
+        publish_offsets: config
+            .publish_offsets
+            .then(|| Duration::from_secs(config.offset_publish_interval_secs.max(1))),
+        status_interval: Duration::from_secs(config.status_update_interval_secs.max(1)),
+        warned_no_key: Default::default(),
+    };
+
+    let acknowledgements = cx.do_acknowledgements(config.acknowledgements);
+    let log_namespace = cx.log_namespace(config.log_namespace);
+    check_acknowledgements(
+        PostgresCdcConfig::NAME,
+        acknowledgements,
+        config.publish_offsets,
+    )?;
+
+    let lock = config
+        .single_writer_lock
+        .as_ref()
+        .map(|lock| lock.build(&cx.proxy))
+        .transpose()?;
+    if lock.is_none() {
+        info!(
+            message = "No `single_writer_lock` configured: make sure only one instance captures \
+                       this database at a time (including during redeploys)."
+        );
+    }
+    let recovery = config
+        .offset_recovery
+        .as_ref()
+        .map(|recovery| recovery.build(lock.as_ref()))
+        .transpose()?;
+    if recovery.is_some() && !config.publish_offsets {
+        return Err(
+            "`offset_recovery` resumes from published offsets: enable `publish_offsets`".into(),
+        );
+    }
+
+    let batch_size = config.batch_size;
+    let shutdown = cx.shutdown;
+    let out = cx.out;
+    Ok(source_with_error(run_locked(
+        lock,
+        shutdown.clone(),
+        move |guard, written| {
+            run(
+                Arc::new(settings),
+                data_dir,
+                recovery,
+                out,
+                shutdown,
+                acknowledgements,
+                log_namespace,
+                batch_size,
+                guard,
+                written,
+            )
+        },
+    )))
+}
+
+/// Flattens `pk_override` (`schema` → `table` → `"col1, col2"`) into `schema.table` → columns.
+fn key_columns(
+    overrides: &HashMap<String, HashMap<String, String>>,
+) -> Result<HashMap<String, Vec<String>>, String> {
+    let mut out = HashMap::new();
+    for (schema, tables) in overrides {
+        for (table, columns) in tables {
+            let columns: Vec<String> = columns
+                .split(',')
+                .map(|c| c.trim().trim_matches('"').to_owned())
+                .filter(|c| !c.is_empty())
+                .collect();
+            if columns.is_empty() {
+                return Err(format!("`pk_override.{schema}.{table}` lists no columns"));
+            }
+            out.insert(format!("{schema}.{table}"), columns);
+        }
+    }
+    Ok(out)
+}
+
+/// Connects, retrying every 5 seconds while the server is unavailable. `None` on shutdown.
+pub(super) async fn connect_retrying(
+    settings: &Settings,
+    replication: bool,
+    shutdown: &mut ShutdownSignal,
+) -> Option<Client> {
+    loop {
+        match settings.conn.connect(replication).await {
+            Ok(client) => return Some(client),
+            Err(error) => {
+                emit!(PostgresCdcConnectionError {
+                    error,
+                    endpoint: &settings.conn.endpoint,
+                });
+                tokio::select! {
+                    _ = &mut *shutdown => return None,
+                    () = tokio::time::sleep(Duration::from_secs(5)) => {}
+                }
+            }
+        }
+    }
+}
+
+/// Checks the server and returns its `system_identifier`.
+async fn inspect_server(client: &Client, settings: &Settings) -> Result<String, String> {
+    let row = client
+        .query_one(
+            "SELECT current_setting('server_version_num')::int, current_setting('wal_level'), \
+                    current_setting('server_version')",
+            &[],
+        )
+        .await
+        .map_err(|error| format!("failed to read server settings: {}", error_text(&error)))?;
+    let version_num: i32 = row.get(0);
+    let wal_level: String = row.get(1);
+    let version: String = row.get(2);
+    if version_num < 130_000 {
+        return Err(format!("PostgreSQL 13 or newer is required (the server is {version})"));
+    }
+    if wal_level != "logical" {
+        return Err(format!(
+            "`wal_level` must be `logical` (it is `{wal_level}`); set it and restart the server"
+        ));
+    }
+    let repl = settings.conn.connect(true).await?;
+    let ident = simple_rows(&repl, "IDENTIFY_SYSTEM")
+        .await
+        .map_err(|error| format!("IDENTIFY_SYSTEM failed (does the user have the REPLICATION attribute?): {}", error_text(&error)))?;
+    let system_id = ident
+        .first()
+        .and_then(|row| row.first().cloned().flatten())
+        .ok_or("IDENTIFY_SYSTEM returned no system identifier")?;
+    info!(
+        message = "Connected to PostgreSQL.",
+        endpoint = %settings.conn.endpoint,
+        version = %version,
+        system_identifier = %system_id,
+    );
+    Ok(system_id)
+}
+
+/// Makes sure the publication exists (creating it per `publication_autocreate_mode`) and warns
+/// about captured tables it does not include.
+async fn ensure_publication(client: &Client, settings: &Settings) -> Result<(), String> {
+    let name = &settings.publication_name;
+    let exists = client
+        .query_opt("SELECT 1 FROM pg_publication WHERE pubname = $1", &[name])
+        .await
+        .map_err(|error| format!("failed to read pg_publication: {}", error_text(&error)))?
+        .is_some();
+    let wanted = catalog::filtered_tables(client, &settings.filters).await?;
+    if !exists {
+        let sql = match settings.autocreate {
+            PublicationAutocreateMode::Disabled => {
+                return Err(format!(
+                    "publication `{name}` does not exist and `publication_autocreate_mode` is \
+                     `disabled`: create it (CREATE PUBLICATION {name} FOR TABLE …)"
+                ));
+            }
+            PublicationAutocreateMode::AllTables => format!("CREATE PUBLICATION {} FOR ALL TABLES", quote_ident(name)),
+            PublicationAutocreateMode::Filtered => {
+                if wanted.is_empty() {
+                    return Err(format!(
+                        "publication `{name}` does not exist and the include/exclude lists match \
+                         no tables to create it for"
+                    ));
+                }
+                let tables = wanted
+                    .iter()
+                    .map(|(s, t)| format!("{}.{}", quote_ident(s), quote_ident(t)))
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                format!("CREATE PUBLICATION {} FOR TABLE {tables}", quote_ident(name))
+            }
+        };
+        client
+            .batch_execute(&sql)
+            .await
+            .map_err(|error| format!("failed to create publication `{name}`: {}", error_text(&error)))?;
+        info!(message = "Created the publication.", publication = %name, tables = wanted.len());
+        return Ok(());
+    }
+    let published: HashSet<TableRef> = catalog::captured_tables(client, name, &settings.filters)
+        .await?
+        .into_iter()
+        .collect();
+    let missing: Vec<String> = wanted
+        .iter()
+        .filter(|t| !published.contains(*t))
+        .map(|(s, t)| format!("{s}.{t}"))
+        .collect();
+    if !missing.is_empty() {
+        warn!(
+            message = "Tables match the include lists but are not in the publication, so they are \
+                       not captured. Add them with ALTER PUBLICATION … ADD TABLE.",
+            publication = %name,
+            tables = %missing.join(", "),
+            internal_log_rate_limit = false,
+        );
+    }
+    Ok(())
+}
+
+/// Warns about captured tables whose before images will be incomplete.
+async fn check_replica_identity(client: &Client, settings: &Settings, captured: &[TableRef]) {
+    let mut partial = Vec::new();
+    for (schema, table) in captured {
+        let identity = client
+            .query_opt(
+                "SELECT c.relreplident::text FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace \
+                 WHERE n.nspname = $1 AND c.relname = $2",
+                &[schema, table],
+            )
+            .await
+            .ok()
+            .flatten()
+            .map(|row| row.get::<_, String>(0));
+        if identity.as_deref() != Some("f") {
+            partial.push(format!("{schema}.{table}"));
+        }
+    }
+    let wants_before = settings.event_format == EventFormat::Debezium
+        || settings.record_images == RecordImages::BeforeAndAfter;
+    if !partial.is_empty() && wants_before {
+        warn!(
+            message = "Tables without REPLICA IDENTITY FULL: their updates carry no before image, \
+                       their deletes only the key, and unchanged large values the placeholder. \
+                       Run ALTER TABLE … REPLICA IDENTITY FULL for complete images.",
+            tables = %partial.join(", "),
+            internal_log_rate_limit = false,
+        );
+    }
+}
+
+/// The state of the source's slot on the server.
+#[derive(Debug, PartialEq)]
+pub(super) enum SlotState {
+    Missing,
+    /// Invalidated (`wal_status = lost`, e.g. by `max_slot_wal_keep_size`).
+    Lost,
+    /// In use by another connection.
+    Active(i32),
+    Usable,
+}
+
+pub(super) async fn slot_state(client: &Client, settings: &Settings) -> Result<SlotState, String> {
+    let row = client
+        .query_opt(
+            "SELECT coalesce(wal_status, ''), active_pid, plugin::text, database::text \
+             FROM pg_replication_slots WHERE slot_name = $1",
+            &[&settings.slot_name],
+        )
+        .await
+        .map_err(|error| format!("failed to read pg_replication_slots: {}", error_text(&error)))?;
+    let Some(row) = row else {
+        return Ok(SlotState::Missing);
+    };
+    let (wal_status, active, plugin, database): (String, Option<i32>, Option<String>, Option<String>) =
+        (row.get(0), row.get(1), row.get(2), row.get(3));
+    if plugin.as_deref() != Some("pgoutput") || database.as_deref() != Some(settings.database.as_str()) {
+        return Err(format!(
+            "replication slot `{}` exists but is not a pgoutput slot of database `{}`; choose \
+             another `slot_name`",
+            settings.slot_name, settings.database
+        ));
+    }
+    Ok(match (wal_status.as_str(), active) {
+        ("lost", _) => SlotState::Lost,
+        (_, Some(pid)) => SlotState::Active(pid),
+        _ => SlotState::Usable,
+    })
+}
+
+/// Drops the source's slot (to create it again with a fresh snapshot).
+pub(super) async fn drop_slot(client: &Client, settings: &Settings) -> Result<(), String> {
+    client
+        .execute(
+            "SELECT pg_drop_replication_slot(slot_name) FROM pg_replication_slots WHERE slot_name = $1",
+            &[&settings.slot_name],
+        )
+        .await
+        .map_err(|error| format!("failed to drop replication slot `{}`: {}", settings.slot_name, error_text(&error)))?;
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn run(
+    settings: Arc<Settings>,
+    data_dir: PathBuf,
+    recovery: Option<OffsetRecovery>,
+    out: SourceSender,
+    mut shutdown: ShutdownSignal,
+    acknowledgements: bool,
+    log_namespace: LogNamespace,
+    batch_size: usize,
+    guard: WriterGuard,
+    written: tokio::sync::oneshot::Sender<()>,
+) -> Result<(), String> {
+    let store = CheckpointStore::<Offset>::new(&data_dir);
+    let offset_file = store.path().display().to_string();
+    let mut stored = store
+        .load()
+        .await
+        .map_err(|error| format!("failed to load offsets from {offset_file}: {error}"))?;
+
+    // No stored offset: resume from the published one if the lake has it (`offset_recovery`).
+    if stored.is_none()
+        && let Some(recovery) = &recovery
+    {
+        let Some(recovered) = recovery.recover(&settings.topic_prefix, &mut shutdown).await? else {
+            return Ok(());
+        };
+        if let Recovered::Published(payload) = recovered {
+            let checkpoint = payload
+                .get("checkpoint")
+                .ok_or("the published offset has no `checkpoint`; cannot resume from it")?;
+            let offset: Offset = serde_json::from_value(checkpoint.clone()).map_err(|error| {
+                format!("the published offset's `checkpoint` is not a valid offset: {error}")
+            })?;
+            info!(
+                message = "No stored offset; resuming from the offset published in the lake.",
+                offset = %offset,
+                next_seq = offset.next_seq,
+            );
+            store
+                .store(&offset)
+                .await
+                .map_err(|error| format!("failed to store the recovered offset in {offset_file}: {error}"))?;
+            stored = Some(offset);
+        } else {
+            info!(message = "No stored offset and the connector's folder in the lake is empty; starting from scratch.");
+        }
+    }
+
+    let Some(query) = connect_retrying(&settings, false, &mut shutdown).await else {
+        return Ok(());
+    };
+    let system_id = inspect_server(&query, &settings).await?;
+    let mut registry = TypeRegistry::load(&query).await?;
+    ensure_publication(&query, &settings).await?;
+    let captured = catalog::captured_tables(&query, &settings.publication_name, &settings.filters).await?;
+    if captured.is_empty() {
+        warn!(
+            message = "No captured tables: the publication streams no table the include lists match.",
+            publication = %settings.publication_name,
+        );
+    }
+    check_replica_identity(&query, &settings, &captured).await;
+
+    let poisoned = Arc::new(AtomicBool::new(false));
+    let builder = EventBuilder::new(
+        PostgresCdcConfig::NAME,
+        log_namespace,
+        settings.event_format,
+        settings.record_images,
+    );
+    let publisher = settings.publish_offsets.map(|interval| OffsetPublisher {
+        out: out.clone(),
+        builder,
+        server_name: settings.topic_prefix.clone(),
+        interval,
+    });
+    let (released_tx, released_rx) = tokio::sync::watch::channel(None);
+    let checkpoints = Checkpoints::start_notifying(
+        acknowledgements,
+        store,
+        Arc::clone(&poisoned),
+        publisher,
+        guard,
+        written,
+        Some(released_tx),
+    );
+    let mut emitter = Emitter::new(
+        out,
+        builder,
+        acknowledgements,
+        checkpoints.finalizer,
+        batch_size,
+        poisoned,
+        settings.include_table_schemas,
+    )
+    .with_observe(settings.observe_output);
+    emitter.set_next_seq(
+        stored.as_ref().map_or(1, |offset| offset.next_seq),
+        stored.as_ref().map_or(0, |offset| offset.seq_sub),
+    );
+
+    // Decide where to start.
+    // A slot still held by the previous run's connection is released within moments; one held
+    // for longer belongs to someone else.
+    let mut slot = slot_state(&query, &settings).await?;
+    for _ in 0..12 {
+        if !matches!(slot, SlotState::Active(_)) {
+            break;
+        }
+        tokio::select! {
+            _ = &mut shutdown => return Ok(()),
+            () = tokio::time::sleep(Duration::from_secs(5)) => {}
+        }
+        slot = slot_state(&query, &settings).await?;
+    }
+    if let SlotState::Active(pid) = slot {
+        return Err(format!(
+            "replication slot `{}` is in use by another connection (pid {pid}); is another \
+             instance capturing this database?",
+            settings.slot_name
+        ));
+    }
+    let resume = match &stored {
+        Some(offset) if offset.snapshot_completed => {
+            if let Some(id) = &offset.system_identifier
+                && id != &system_id
+            {
+                return Err(format!(
+                    "the stored offset {offset} belongs to the server with system identifier {id}, \
+                     but the source is now connected to {system_id}; slots and LSNs do not move \
+                     between servers. Remove {offset_file} to start over"
+                ));
+            }
+            if offset.slot_name != settings.slot_name {
+                return Err(format!(
+                    "the stored offset {offset} is for slot `{}`, but `slot_name` is `{}`; \
+                     remove {offset_file} to start over with the new slot",
+                    offset.slot_name, settings.slot_name
+                ));
+            }
+            if slot == SlotState::Usable {
+                Some(offset.clone())
+            } else {
+                let why = if slot == SlotState::Lost {
+                    "was invalidated (it fell more than `max_slot_wal_keep_size` behind)"
+                } else {
+                    "no longer exists"
+                };
+                if settings.snapshot_mode != SnapshotMode::WhenNeeded {
+                    return Err(format!(
+                        "replication slot `{}` {why}, so changes after {offset} are lost. Set \
+                         `snapshot_mode: when_needed` to re-snapshot",
+                        settings.slot_name
+                    ));
+                }
+                if settings.unplanned_snapshots == UnplannedSnapshots::Hold && !offset.resnapshot_approved {
+                    return Err(format!(
+                        "replication slot `{}` {why}, so every captured table would be \
+                         snapshotted again. `unplanned_snapshots` is `hold`: approve the \
+                         re-snapshot by setting `\"resnapshot_approved\": true` in {offset_file} \
+                         while the source is stopped, or set `unplanned_snapshots: allow`",
+                        settings.slot_name
+                    ));
+                }
+                warn!(message = "The replication slot was lost; re-snapshotting.", slot = %settings.slot_name, %why);
+                None
+            }
+        }
+        Some(_) => {
+            info!(message = "The previous snapshot did not complete; snapshotting again.");
+            None
+        }
+        None => None,
+    };
+
+    let start = match resume {
+        Some(offset) => offset,
+        None => {
+            // Starting over: a leftover slot cannot give a snapshot, so it is replaced.
+            if slot != SlotState::Missing {
+                info!(message = "Dropping the replication slot to create it again with a snapshot.", slot = %settings.slot_name);
+                drop_slot(&query, &settings).await?;
+            }
+            let snapshotting = stored.is_some() || settings.snapshot_mode != SnapshotMode::NoData;
+            if snapshotting && settings.snapshot_strategy == SnapshotStrategy::Blocking {
+                let completed = snapshot::run(
+                    Arc::clone(&settings),
+                    &query,
+                    &registry,
+                    &mut emitter,
+                    &captured,
+                    &system_id,
+                    shutdown.clone(),
+                )
+                .await?;
+                let Some(offset) = completed else {
+                    // Shut down mid-snapshot; it is taken again on the next start.
+                    return emitter.close().await;
+                };
+                if settings.snapshot_mode == SnapshotMode::InitialOnly {
+                    info!(message = "Snapshot complete; `snapshot_mode` is `initial_only`, so not streaming.");
+                    return emitter.close().await;
+                }
+                offset
+            } else {
+                // An incremental snapshot (read while streaming), or `no_data` (existing rows are
+                // deliberately not captured): stream from the slot's position right away.
+                let repl = settings.conn.connect(true).await?;
+                let created = simple_rows(
+                    &repl,
+                    &format!("CREATE_REPLICATION_SLOT {} LOGICAL pgoutput NOEXPORT_SNAPSHOT", quote_ident(&settings.slot_name)),
+                )
+                .await
+                .map_err(|error| format!("failed to create replication slot `{}`: {}", settings.slot_name, error_text(&error)))?;
+                let lsn: Lsn = created
+                    .first()
+                    .and_then(|row| row.get(1).cloned().flatten())
+                    .ok_or("CREATE_REPLICATION_SLOT returned no position")?
+                    .parse()?;
+                let mut offset = Offset::new(lsn, &settings.slot_name, Some(system_id.clone()));
+                offset.snapshot_completed = true;
+                if snapshotting {
+                    info!(message = "Created the replication slot; snapshotting tables incrementally while streaming.", offset = %offset, tables = captured.len());
+                    offset.incremental = (!captured.is_empty()).then(|| IncrementalProgress::new(captured.clone()));
+                } else {
+                    info!(message = "Created the replication slot; streaming without a snapshot.", offset = %offset);
+                    offset.snapshotted_tables = captured.clone();
+                }
+                emitter.commit(offset.clone());
+                emitter.flush().await?;
+                offset
+            }
+        }
+    };
+
+    // Captured tables that were never snapshotted: added to the publication or the include
+    // lists since, or removed from `snapshotted_tables` by an operator (an ad-hoc snapshot).
+    let mut start = start;
+    let queued: HashSet<&TableRef> = start
+        .snapshotted_tables
+        .iter()
+        .chain(start.incremental.iter().flat_map(|p| p.tables.iter()))
+        .collect();
+    let new_tables: Vec<TableRef> = captured.iter().filter(|t| !queued.contains(t)).cloned().collect();
+    if !new_tables.is_empty() {
+        let names = new_tables.iter().map(|(s, t)| format!("{s}.{t}")).collect::<Vec<_>>().join(", ");
+        if settings.snapshot_new_tables {
+            info!(message = "Snapshotting captured tables that were never snapshotted, incrementally.", tables = %names);
+            start
+                .incremental
+                .get_or_insert_with(|| IncrementalProgress::new(Vec::new()))
+                .tables
+                .extend(new_tables);
+            emitter.commit(start.clone());
+            emitter.flush().await?;
+        } else {
+            info!(
+                message = "Some captured tables have never been snapshotted; only their changes from \
+                           now on are captured. Set `snapshot_new_tables: true` to snapshot them.",
+                tables = %names,
+            );
+        }
+    }
+
+    stream::stream(&settings, query, &mut registry, &mut emitter, start, &captured, released_rx, shutdown)
+        .await?;
+    emitter.close().await
+}

+++ b/contrib/mysql_cdc/run-e2e.sh
@@ -0,0 +1,245 @@
+#!/usr/bin/env bash
+# End-to-end test for the mysql_cdc source.
+#
+# Usage: ./run-e2e.sh /path/to/vector
+#
+# Requires: docker (with compose), jq.
+# Starts MySQL + Azurite, runs Vector with vector-e2e.yaml and checks snapshot, streaming,
+# restart/resume, filtering and the blobs written to Azurite.
+set -uo pipefail
+
+VECTOR=${1:?usage: run-e2e.sh /path/to/vector}
+VECTOR=$(cd "$(dirname "$VECTOR")" && pwd)/$(basename "$VECTOR")
+cd "$(dirname "$0")"
+
+command -v jq >/dev/null || { echo "jq is required"; exit 2; }
+
+PASS=0
+FAIL=0
+VPID=""
+
+ok()   { echo "  PASS  $*"; PASS=$((PASS + 1)); }
+bad()  { echo "  FAIL  $*"; FAIL=$((FAIL + 1)); }
+check() { # check "description" <command...>
+  local desc=$1; shift
+  if "$@" >/dev/null 2>&1; then ok "$desc"; else bad "$desc"; fi
+}
+
+sql() { docker exec -i cdc-mysql mysql --default-character-set=utf8mb4 -uroot -prootpw inventory -N -e "$1" 2>/dev/null; }
+
+start_vector() {
+  "$VECTOR" --config vector-e2e.yaml >>out/vector.log 2>&1 &
+  VPID=$!
+}
+
+stop_vector() {
+  if [ -n "$VPID" ]; then
+    kill -TERM "$VPID" 2>/dev/null
+    wait "$VPID" 2>/dev/null
+    VPID=""
+  fi
+}
+
+cleanup() { stop_vector; }
+trap cleanup EXIT
+
+# wait_for <seconds> <description> <command...>
+wait_for() {
+  local timeout=$1 desc=$2; shift 2
+  for _ in $(seq 1 "$timeout"); do
+    if "$@" >/dev/null 2>&1; then return 0; fi
+    sleep 1
+  done
+  echo "  timed out waiting for: $desc"
+  return 1
+}
+
+raw() { cat out/raw.ndjson 2>/dev/null; }
+count() { raw | jq -s "[.[] | select($1)] | length"; }
+has_at_least() { [ "$(count "$1")" -ge "$2" ]; }
+
+echo "==> Starting MySQL and Azurite"
+rm -rf out && mkdir -p out/data
+docker compose down -v >/dev/null 2>&1
+docker compose up -d || exit 1
+wait_for 120 "MySQL healthy" \
+  bash -c '[ "$(docker inspect -f "{{.State.Health.Status}}" cdc-mysql)" = healthy ]' || exit 1
+# The entrypoint restarts mysqld after running init.sql; make sure the data is there.
+wait_for 60 "init.sql applied" bash -c "docker exec cdc-mysql mysql -uroot -prootpw -N -e 'SELECT COUNT(*) FROM inventory.customers' 2>/dev/null | grep -q 3" || exit 1
+wait_for 60 "Azurite container created" \
+  docker exec cdc-azcli az storage container create -n cdc --only-show-errors || exit 1
+
+echo "==> Snapshot"
+start_vector
+wait_for 60 "3 snapshot events" has_at_least '.op == "r"' 3
+
+check "3 snapshot read events"            test "$(count '.op == "r"')" -eq 3
+check "first event marked first"          test "$(raw | head -1 | jq -r .source.snapshot)" = first
+check "last event marked last"            test "$(count '.op == "r" and .source.snapshot == "last"')" -eq 1
+check "excluded table not captured"       test "$(count '.source.table == "audit_log"')" -eq 0
+check "excluded column removed"           test "$(count '.after.ssn != null')" -eq 0
+A='select(.op == "r" and .after.id == 1) | .after'
+check "decimal as string"                 test "$(raw | jq -r "$A | .balance")" = "1234.50"
+check "float shortest form"               test "$(raw | jq -r "$A | .ratio")" = "0.1"
+check "bigint unsigned wraps like Debezium" test "$(raw | jq -r "$A | .big")" = "-1"
+check "bit(1) as boolean"                 test "$(raw | jq -r "$A | .active")" = "true"
+check "enum as string"                    test "$(raw | jq -r "$A | .status")" = "active"
+check "set as string"                     test "$(raw | jq -r "$A | .tags")" = "a,c"
+json_is_gold() { raw | jq -r "$A | .profile" | jq -e '.tier == "gold"'; }
+check "json as string"                    json_is_gold
+check "date as epoch days"                test "$(raw | jq -r "$A | .born")" = "7441"
+check "time(3) as microseconds"           test "$(raw | jq -r "$A | .wake_up")" = "27000250000"
+check "datetime(6) as epoch micros"       test "$(raw | jq -r "$A | .created")" = "1704110400123456"
+check "timestamp(3) as ISO string"        test "$(raw | jq -r "$A | .updated")" = "2024-01-01T12:00:00.500Z"
+check "latin1 text decoded"               test "$(raw | jq -r "$A | .latin")" = "café"
+check "varbinary as base64"               test "$(raw | jq -r "$A | .avatar")" = "3q2+7w=="
+check "geometry srid"                     test "$(raw | jq -r "$A | .location.srid")" = "4326"
+check "negative time"                     test "$(raw | jq -r 'select(.op == "r" and .after.id == 3) | .after.wake_up')" = "-43200000000"
+
+echo "==> Streaming"
+sql "INSERT INTO customers (id, name, balance) VALUES (4, 'Dave', 10.00);"
+sql "UPDATE customers SET name = 'Alicia' WHERE id = 1;"
+sql "UPDATE customers SET id = 20 WHERE id = 2;"
+sql "DELETE FROM customers WHERE id = 3;"
+sql "START TRANSACTION; INSERT INTO customers (id, name) VALUES (99, 'Ghost'); ROLLBACK;"
+sql "START TRANSACTION; INSERT INTO customers (id, name) VALUES (6, 'Eve'); INSERT INTO customers (id, name) VALUES (7, 'Frank'); COMMIT;"
+sql "INSERT INTO audit_log (note) VALUES ('still ignored');"
+sql "UPDATE customers SET latin = 'über' WHERE id = 4;"
+sql "ALTER TABLE customers ADD COLUMN nickname VARCHAR(20);"
+sql "INSERT INTO customers (id, name, nickname) VALUES (8, 'Gina', 'gg');"
+wait_for 30 "insert after DDL" has_at_least '.op == "c" and .after.id == 8' 1
+
+check "insert captured"                   test "$(count '.op == "c" and .after.id == 4')" -eq 1
+check "update has before and after"       test "$(count '.op == "u" and .before.name == "Alice" and .after.name == "Alicia"')" -eq 1
+check "pk change -> delete old key"       test "$(count '.op == "d" and .before.id == 2')" -eq 1
+check "pk change -> create new key"       test "$(count '.op == "c" and .after.id == 20')" -eq 1
+check "delete captured"                   test "$(count '.op == "d" and .before.id == 3 and .after == null')" -eq 1
+check "rolled-back insert not emitted"    test "$(count '.after.id == 99')" -eq 0
+one_gtid() { [ "$(raw | jq -s '[.[] | select(.after.id == 6 or .after.id == 7) | .source.gtid] | unique | length')" -eq 1 ]; }
+check "multi-row tx shares one GTID"      one_gtid
+check "streamed events have gtid/file/pos" test "$(count '.op == "c" and .after.id == 4 and .source.gtid != null and .source.pos > 0')" -eq 1
+check "source.query populated"            test "$(count '.after.id == 4 and (.source.query | test("INSERT"))')" -eq 1
+check "latin1 text decoded (binlog)"      test "$(count '.op == "u" and .after.id == 4 and .after.latin == "über"')" -eq 1
+check "new column after DDL"              test "$(count '.after.id == 8 and .after.nickname == "gg"')" -eq 1
+check "filtered table still ignored"      test "$(count '.source.table == "audit_log"')" -eq 0
+check "DDL emitted on the control output" grep -q 'ADD COLUMN nickname' out/ddl.ndjson
+check "every row event has a seq"         test "$(count '.source.seq == null')" -eq 0
+
+echo "==> Restart and resume"
+sleep 3   # let the last acknowledgements land
+stop_vector
+check "offset file written"               test -s out/data/mysql/offsets.json
+check "offset marks snapshot complete"    test "$(jq -r .snapshot_completed out/data/mysql/offsets.json)" = true
+before_restart=$(raw | wc -l)
+sql "INSERT INTO customers (id, name) VALUES (5, 'While-Down');"
+start_vector
+wait_for 60 "change made while stopped" has_at_least '.op == "c" and .after.id == 5' 1
+check "change made while stopped is captured" test "$(count '.op == "c" and .after.id == 5')" -eq 1
+check "no re-snapshot after restart"      test "$(count '.op == "r"')" -eq 3
+dupes=$(raw | jq -s '[.[] | select(.op != "r") | "\(.source.gtid)/\(.source.pos)/\(.source.row)/\(.op)"] | group_by(.) | map(select(length > 1)) | length')
+if [ "$dupes" -eq 0 ]; then ok "no duplicates across restart"; else echo "  NOTE  $dupes duplicated change(s) across restart (allowed: at-least-once)"; fi
+echo "        events before restart: $before_restart, after: $(raw | wc -l)"
+
+echo "==> ADLS (Azurite, metadata + record format)"
+sleep 5   # sink batch timeout
+blobs=$(docker exec cdc-azcli az storage blob list -c cdc --prefix mysql/inventory/customers/ --query "[].name" -o tsv --only-show-errors 2>/dev/null | tr -d '\r')
+if [ -n "$blobs" ]; then ok "blobs written under mysql/inventory/customers/"; else bad "no blobs written to Azurite"; fi
+echo "$blobs" | head -3 | sed 's/^/        /'
+all_json_gz() { ! echo "$blobs" | grep -qv '\.json\.gz$'; }
+check "blob_extension json.gz used"       all_json_gz
+
+# Download every blob and concatenate the rows (the Azure CLI may transparently gunzip).
+: > out/blobs.ndjson
+for b in $blobs; do
+  docker exec cdc-azcli az storage blob download -c cdc -n "$b" -f /tmp/b --overwrite --only-show-errors >/dev/null 2>&1
+  docker exec cdc-azcli sh -c 'gzip -dcf /tmp/b' >> out/blobs.ndjson 2>/dev/null
+done
+blob() { jq -s "[.[] | select($1)] | length" out/blobs.ndjson; }
+head -1 out/blobs.ndjson | cut -c1-240 | sed 's/^/        /'
+
+only_envelope_keys() { [ "$(jq -s '[.[] | keys] | unique | length' out/blobs.ndjson)" -eq 1 ] && [ "$(head -1 out/blobs.ndjson | jq -c 'keys')" = '["metadata","record"]' ] && [ "$(head -1 out/blobs.ndjson | jq -c '.record | keys')" = '["after","before"]' ]; }
+check "rows contain only metadata and record (before, after)" only_envelope_keys
+check "snapshot row: op r, before null"   test "$(blob '.metadata.op == "r" and .record.after.id == 1 and .record.before == null')" -eq 1
+check "update row has before and after"   test "$(blob '.metadata.op == "u" and .record.after.name == "Alicia" and .record.before.name == "Alice"')" -eq 1
+check "delete row: deleted row, key in after"test "$(blob '.metadata.op == "d" and .metadata.deleted == true and .record.before.id == 3 and .record.after == {"id": 3}')" -eq 1
+check "metadata carries key and position" test "$(blob '.metadata.op == "c" and .record.after.id == 4 and .metadata.key.id == 4 and .metadata.pos > 0 and .metadata.gtid != null')" -eq 1
+check "excluded column absent from record" test "$(blob '(.record.after.ssn // .record.before.ssn) != null')" -eq 0
+blob_rows=$(wc -l < out/blobs.ndjson | tr -d ' ')
+raw_rows=$(count '.source.table == "customers"')
+echo "        rows in blobs: $blob_rows, change events captured (debezium source): $raw_rows"
+check "every change reached ADLS"         test "$blob_rows" -ge "$raw_rows"
+
+echo "==> Table schemas"
+schema_blobs=$(docker exec cdc-azcli az storage blob list -c cdc --prefix _schemas/inventory/customers/ --query "[].name" -o tsv --only-show-errors 2>/dev/null | tr -d '\r')
+echo "$schema_blobs" | sed 's/^/        /'
+: > out/schemas.ndjson
+for b in $schema_blobs; do
+  docker exec cdc-azcli az storage blob download -c cdc -n "$b" -f /tmp/s --overwrite --only-show-errors >/dev/null 2>&1
+  docker exec cdc-azcli cat /tmp/s >> out/schemas.ndjson 2>/dev/null
+done
+n_versions=$(echo "$schema_blobs" | grep -c .)
+# Two definitions of `customers`: before and after `ADD COLUMN nickname`.
+check "two schema versions (before/after DDL)" test "$n_versions" -eq 2
+names_are_versions() { echo "$schema_blobs" | grep -Eq '/[0-9a-f]{16}[.]json$'; }
+check "schema blobs named <version>.json"  names_are_versions
+versions_in_rows=$(jq -r '.metadata.schema_version' out/blobs.ndjson | sort -u | grep -c .)
+check "rows reference exactly those versions" test "$versions_in_rows" -eq "$n_versions"
+every_row_version_documented() {
+  comm -23 <(jq -r '.metadata.schema_version' out/blobs.ndjson | sort -u) <(jq -r '.schema_version' out/schemas.ndjson | sort -u) | grep -q . && return 1 || return 0
+}
+check "every row's version has a document" every_row_version_documented
+snap_v=$(jq -r 'select(.metadata.op == "r") | .metadata.schema_version' out/blobs.ndjson | sort -u)
+pre_ddl_v=$(jq -r 'select(.metadata.op == "c" and .record.after.id == 4) | .metadata.schema_version' out/blobs.ndjson)
+check "snapshot and binlog agree on version" test "$snap_v" = "$pre_ddl_v"
+S='select(.columns | map(.name) | index("nickname") | not)'
+col() { jq -r "$S | .columns[] | select(.name == \"$1\") | $2" out/schemas.ndjson; }
+check "pk recorded"                       test "$(jq -c "$S | .primary_key" out/schemas.ndjson)" = '["id"]'
+check "decimal precision/scale"           test "$(col balance '"\(.precision),\(.scale),\(.logical_type)"')" = "12,2,decimal"
+check "datetime(6) -> timestamp_micros_local" test "$(col created .logical_type)" = "timestamp_micros_local"
+check "timestamp -> iso8601 utc"          test "$(col updated .logical_type)" = "timestamp_iso8601_utc"
+check "bigint unsigned flagged"           test "$(col big .unsigned)" = "true"
+check "enum values listed"                test "$(col status '.values | join(",")')" = "new,active,closed"
+check "varbinary -> bytes/base64"         test "$(col avatar '"\(.mysql_type),\(.logical_type),\(.encoding)"')" = "varbinary,bytes,base64"
+check "not-null pk, nullable others"      test "$(col id .nullable),$(col email .nullable)" = "false,true"
+check "excluded column not in schema"     test -z "$(col ssn .name)"
+
+echo "==> Single-writer lock"
+# A second instance with the same server_id, offsets and lock must wait while the first runs,
+# take over when it stops, and resume from its offset; a crashed holder blocks only until its
+# lease expires.
+rawb() { cat out/raw-b.ndjson 2>/dev/null; }
+countb() { rawb | jq -s "[.[] | select($1)] | length"; }
+check "first instance holds the lock"     grep -q 'Acquired the single-writer lock' out/vector.log
+"$VECTOR" --config vector-e2e-lock.yaml >>out/vector-b.log 2>&1 &
+BPID=$!
+wait_for 30 "second instance waits" grep -q 'Another instance holds the single-writer lock' out/vector-b.log
+check "second instance waits for the lock" grep -q 'Another instance holds the single-writer lock' out/vector-b.log
+sql "INSERT INTO customers (id, name) VALUES (30, 'While-Locked');"
+wait_for 30 "first instance captures" has_at_least '.op == "c" and .after.id == 30' 1
+sleep 3
+check "second instance never connected"   bash -c "! grep -q 'Connected to MySQL' out/vector-b.log"
+check "second instance emitted nothing"   test "$(rawb | wc -l)" -eq 0
+sleep 2   # let the first instance store its offset
+stop_vector
+check "first instance released the lock"  grep -q 'Released the single-writer lock' out/vector.log
+wait_for 20 "second instance takes over" grep -q 'Acquired the single-writer lock' out/vector-b.log
+check "second instance takes over on release" grep -q 'Acquired the single-writer lock' out/vector-b.log
+sql "INSERT INTO customers (id, name) VALUES (31, 'After-Takeover');"
+wait_for 30 "second instance captures" bash -c "[ \"\$(cat out/raw-b.ndjson 2>/dev/null | jq -s '[.[] | select(.after.id == 31)] | length')\" -ge 1 ]"
+check "second instance captures new changes" test "$(countb '.op == "c" and .after.id == 31')" -eq 1
+check "second instance resumed (no snapshot, no replay of id 30)" test "$(countb '.op == "r" or .after.id == 30')" -eq 0
+sleep 2
+kill -KILL "$BPID" 2>/dev/null; wait "$BPID" 2>/dev/null
+lock_wait_start=$(date +%s)
+before_locks=$(grep -c 'Acquired the single-writer lock' out/vector.log)
+start_vector
+wait_for 40 "lease of the crashed instance expires" bash -c "[ \$(grep -c 'Acquired the single-writer lock' out/vector.log) -gt $before_locks ]"
+waited=$(( $(date +%s) - lock_wait_start ))
+echo "        took over from a crashed holder after ${waited}s (lease 15 s)"
+check "takes over after a crashed holder's lease expires" test "$waited" -le 30
+check "waited for the crashed holder's lease"   test "$waited" -ge 5
+
+stop_vector
+echo
+echo "Result: $PASS passed, $FAIL failed (logs: out/vector.log)"
+[ "$FAIL" -eq 0 ]
diff --git a/contrib/mysql_cdc/run-load.sh b/contrib/mysql_cdc/run-load.sh
new file mode 100755
index 0000000..39f01d1
--- /dev/null
+++ b/contrib/mysql_cdc/run-load.sh
@@ -0,0 +1,176 @@
+#!/usr/bin/env bash
+# Load test for the mysql_cdc source.
+#
+# Usage: ./run-load.sh /path/to/vector [RATE] [DURATION_SECONDS] [TABLES]
+#        defaults: 500 changes/s for 300 s across 5 tables
+#
+# Seeds tables (snapshot input), generates a steady mix of inserts/updates/deletes, hard-kills
+# Vector (SIGKILL) halfway through and restarts it, then verifies against MySQL that every change
+# was delivered and that replaying the captured changes reproduces each table exactly.
+# Requires: docker (with compose), jq, python3.
+set -uo pipefail
+
+VECTOR=${1:?usage: run-load.sh /path/to/vector [rate] [duration] [tables]}
+VECTOR=$(cd "$(dirname "$VECTOR")" && pwd)/$(basename "$VECTOR")
+# Rate 0 runs the snapshot benchmark instead: run-load.sh VECTOR 0 ROWS_PER_TABLE [TABLES] [THREADS] [CHUNK]
+if [ "${2:-}" = "0" ]; then
+  exec "$(dirname "$0")/run-snapshot-bench.sh" "$VECTOR" "${@:3}"
+fi
+# Rate 1 runs the production-readiness suite instead (run-readiness.sh); its report is copied to
+# out/load-readiness-report.json so build tooling that collects out/load-* picks it up.
+if [ "${2:-}" = "1" ]; then
+  exec "$(dirname "$0")/run-readiness.sh" "$VECTOR"
+fi
+RATE=${2:-500}
+DURATION=${3:-300}
+TABLES=${4:-5}
+SEED_ROWS=1000
+cd "$(dirname "$0")"
+
+for tool in docker jq python3; do
+  command -v "$tool" >/dev/null || { echo "$tool is required"; exit 2; }
+done
+
+VPID=""
+SAMPLER=""
+log() { echo "[$(date +%T)] $*"; }
+
+start_vector() {
+  "$VECTOR" --config vector-load.yaml >>out/load-vector.log 2>&1 &
+  VPID=$!
+  echo "$VPID" > out/load-vector.pid
+}
+
+cleanup() {
+  [ -n "$SAMPLER" ] && kill "$SAMPLER" 2>/dev/null
+  [ -n "$VPID" ] && kill -TERM "$VPID" 2>/dev/null && wait "$VPID" 2>/dev/null
+}
+trap cleanup EXIT
+
+# Samples Vector's resident memory and CPU use (per interval, not lifetime average) every 2 s.
+sample_resources() {
+  local hz prev_ticks="" prev_t=""
+  hz=$(getconf CLK_TCK)
+  echo "t,rss_kb,cpu_pct" > out/load-resources.csv
+  while true; do
+    local pid
+    pid=$(cat out/load-vector.pid 2>/dev/null)
+    if [ -n "$pid" ] && [ -r "/proc/$pid/stat" ]; then
+      local ticks rss now
+      ticks=$(awk '{print $14 + $15}' "/proc/$pid/stat")
+      rss=$(awk '/VmRSS/ {print $2}' "/proc/$pid/status")
+      now=$(date +%s.%N)
+      if [ -n "$prev_ticks" ] && [ "$ticks" -ge "$prev_ticks" ]; then
+        awk -v t="$now" -v pt="$prev_t" -v k="$ticks" -v pk="$prev_ticks" -v hz="$hz" -v rss="$rss" \
+          'BEGIN { printf "%.1f,%d,%.1f\n", t, rss, (k - pk) / hz / (t - pt) * 100 }' >> out/load-resources.csv
+      fi
+      prev_ticks=$ticks
+      prev_t=$now
+    else
+      prev_ticks=""
+    fi
+    sleep 2
+  done
+}
+
+mysql_root() { docker exec -i cdc-mysql mysql -uroot -prootpw "$@" 2>>out/load-mysql.err; }
+
+wait_for() { # wait_for <seconds> <description> <command...>
+  local timeout=$1 desc=$2; shift 2
+  for _ in $(seq 1 "$timeout"); do
+    if "$@" >/dev/null 2>&1; then return 0; fi
+    sleep 1
+  done
+  log "timed out waiting for: $desc"
+  return 1
+}
+
+log "Load test: $RATE changes/s for ${DURATION}s across $TABLES tables ($SEED_ROWS seed rows each)"
+rm -rf out/load-* && mkdir -p out/load-data out/load-truth out/load-blobs
+docker compose down -v >/dev/null 2>&1
+docker compose up -d >/dev/null 2>&1 || { log "docker compose up failed"; exit 1; }
+wait_for 120 "MySQL healthy" \
+  bash -c '[ "$(docker inspect -f "{{.State.Health.Status}}" cdc-mysql)" = healthy ]' || exit 1
+wait_for 60 "init.sql applied" bash -c "docker exec cdc-mysql mysql -uroot -prootpw -N -e 'SELECT 1 FROM inventory.customers LIMIT 1' 2>/dev/null | grep -q 1" || exit 1
+# Public read access lets the verification fetch blobs with plain HTTP (local emulator only).
+wait_for 60 "Azurite container" docker exec cdc-azcli az storage container create -n load --public-access container --only-show-errors || exit 1
+
+log "Seeding tables"
+python3 loadgen.py setup --tables "$TABLES" --seed-rows "$SEED_ROWS" | mysql_root
+
+log "Starting Vector (snapshot)"
+sample_resources &
+SAMPLER=$!
+start_vector
+wait_for 120 "snapshot completed" grep -q "Snapshot completed" out/load-vector.log || exit 1
+
+log "Generating load"
+python3 -u loadgen.py run --tables "$TABLES" --rate "$RATE" --duration "$DURATION" \
+  --seed-rows "$SEED_ROWS" --summary out/load-expected.json | mysql_root &
+GEN=$!
+
+sleep $(( DURATION / 2 ))
+log "Hard-killing Vector (SIGKILL) mid-load"
+kill -9 "$VPID" 2>/dev/null
+wait "$VPID" 2>/dev/null
+sleep 5
+log "Restarting Vector"
+start_vector
+
+wait "$GEN"
+log "Load finished: $(jq -c '{statements, rate_generated, duration_s}' out/load-expected.json)"
+
+log "Waiting for the source to catch up with MySQL"
+caught_up() {
+  local executed stored
+  executed=$(mysql_root -N -e "SELECT @@global.gtid_executed" | tr -d ' \n\r\\')
+  stored=$(jq -r .gtid_set out/load-data/mysql/offsets.json 2>/dev/null | tr -d ' \n\r')
+  [ -n "$executed" ] && [ "$executed" = "$stored" ]
+}
+if wait_for 300 "offsets to reach gtid_executed" caught_up; then
+  log "Caught up"
+else
+  log "WARNING: source did not catch up within 300 s"
+fi
+log "Letting the sink drain its buffer"
+sleep 30
+kill -TERM "$VPID" 2>/dev/null
+wait "$VPID" 2>/dev/null
+VPID=""
+kill "$SAMPLER" 2>/dev/null
+SAMPLER=""
+
+log "Dumping final table contents"
+for i in $(seq 1 "$TABLES"); do
+  mysql_root -N -e "SELECT id, val FROM loadtest.t$i ORDER BY id" > "out/load-truth/t$i.tsv"
+done
+
+log "Downloading blobs from Azurite"
+# Fetched over plain HTTP (the container is public in the emulator), so the stored gzip bytes
+# arrive unchanged; the Azure CLI's downloader decompresses and its progress bar can crash.
+docker exec cdc-azcli az storage blob list -c load --num-results '*' --query '[].name' -o tsv \
+  --only-show-errors 2>/dev/null | tr -d '\r' > out/load-blob-names.txt
+listed=$(grep -c '^cdc/' out/load-blob-names.txt)
+xargs -P 8 -I{} curl -sf --create-dirs -o "out/load-blobs/{}" "http://127.0.0.1:10000/devstoreaccount1/load/{}" \
+  < out/load-blob-names.txt
+downloaded=$(find out/load-blobs/cdc -type f 2>/dev/null | wc -l)
+log "Data blobs: $downloaded downloaded of $listed in Azurite, $(du -sh out/load-blobs/cdc 2>/dev/null | cut -f1)"
+if [ "$downloaded" != "$listed" ]; then
+  log "ERROR: not every blob was downloaded; the verification below would be meaningless"
+  exit 1
+fi
+find out/load-blobs/_schemas -type f -name '*.json' -exec cat {} + 2>/dev/null | jq -s . > out/load-schemas.json
+log "Schema documents: $(jq length out/load-schemas.json) (copied to load-schemas.json)"
+
+if [ -s out/load-mysql.err ] && grep -qv "Using a password" out/load-mysql.err; then
+  log "MySQL client reported errors:"; grep -v "Using a password" out/load-mysql.err | head -5
+fi
+
+log "Verifying"
+python3 verify_load.py --blobs out/load-blobs/cdc --expected out/load-expected.json \
+  --truth out/load-truth --resources out/load-resources.csv --report out/load-report.json
+verified=$?
+errors=$(grep -c " ERROR " out/load-vector.log)
+log "Vector logged $errors error line(s)"
+grep " ERROR " out/load-vector.log | cut -c1-200 | head -5
+[ "$verified" -eq 0 ] && [ "$errors" -eq 0 ]
diff --git a/contrib/mysql_cdc/run-readiness.sh b/contrib/mysql_cdc/run-readiness.sh
new file mode 100755
index 0000000..99ad9c3
--- /dev/null
+++ b/contrib/mysql_cdc/run-readiness.sh
@@ -0,0 +1,65 @@
+#!/usr/bin/env bash
+# Production-readiness suite for the mysql_cdc source (Vectezium).
+#
+# Usage: ./run-readiness.sh /path/to/vector [--only 1.1,2.1] [--skip-load] [--soak-hours N]
+#
+# Starts a fresh MySQL + Azurite (docker compose), runs readiness.py (tests 1.1-7.3, see that
+# file), then run-load.sh for 6.1 (SIGKILL under 500 changes/s) and optionally a soak run, and
+# prints a scorecard. Results: out/readiness/report.json, per-test logs in out/readiness/<id>/.
+# Requires: docker (with compose), python3, openssl, jq, curl.
+set -uo pipefail
+
+VECTOR=${1:?usage: run-readiness.sh /path/to/vector [--only ids] [--skip-load] [--soak-hours N]}
+VECTOR=$(cd "$(dirname "$VECTOR")" && pwd)/$(basename "$VECTOR")
+shift
+ONLY=""
+SKIP_LOAD=0
+SOAK_HOURS=0
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --only) ONLY=$2; shift 2 ;;
+    --skip-load) SKIP_LOAD=1; shift ;;
+    --soak-hours) SOAK_HOURS=$2; shift 2 ;;
+    *) echo "unknown option: $1"; exit 2 ;;
+  esac
+done
+cd "$(dirname "$0")"
+
+for tool in docker python3 openssl jq curl; do
+  command -v "$tool" >/dev/null || { echo "$tool is required"; exit 2; }
+done
+log() { echo "[$(date +%T)] $*"; }
+
+log "Starting a fresh MySQL + Azurite"
+rm -rf out/readiness && mkdir -p out/readiness
+docker compose down -v >/dev/null 2>&1
+docker compose up -d >/dev/null 2>&1 || { log "docker compose up failed"; exit 1; }
+for _ in $(seq 1 120); do
+  [ "$(docker inspect -f '{{.State.Health.Status}}' cdc-mysql 2>/dev/null)" = healthy ] &&
+    docker exec cdc-mysql mysql -uroot -prootpw -N -e 'SELECT 1 FROM inventory.customers LIMIT 1' 2>/dev/null | grep -q 1 &&
+    break
+  sleep 1
+done
+
+python3 -u readiness.py "$VECTOR" ${ONLY:+--only "$ONLY"}
+
+load_args=()
+if [ "$SKIP_LOAD" = 0 ] && [ -z "$ONLY" ]; then
+  log "Test 6.1: SIGKILL under 500 changes/s (run-load.sh, 120 s)"
+  ./run-load.sh "$VECTOR" 500 120 5 > out/readiness/6.1-load.log 2>&1
+  rc=$?
+  tail -15 out/readiness/6.1-load.log
+  load_args+=(--load-rc "$rc")
+fi
+if [ "$SOAK_HOURS" -gt 0 ]; then
+  log "Test 7.4: soak for ${SOAK_HOURS} h at 500 changes/s"
+  ./run-load.sh "$VECTOR" 500 $(( SOAK_HOURS * 3600 )) 5 > out/readiness/7.4-soak.log 2>&1
+  rc=$?
+  tail -15 out/readiness/7.4-soak.log
+  load_args+=(--soak-rc "$rc")
+fi
+
+python3 readiness.py --summary out/readiness/report.json "${load_args[@]}" | tee out/readiness/scorecard.txt
+rc=${PIPESTATUS[0]}
+cp -f out/readiness/report.json out/load-readiness-report.json
+exit "$rc"
diff --git a/contrib/mysql_cdc/run-snapshot-bench.sh b/contrib/mysql_cdc/run-snapshot-bench.sh
new file mode 100755
index 0000000..b743f9d
--- /dev/null
+++ b/contrib/mysql_cdc/run-snapshot-bench.sh
@@ -0,0 +1,219 @@
+#!/usr/bin/env bash
+# Snapshot benchmark for the mysql_cdc source.
+#
+# Usage: ./run-snapshot-bench.sh /path/to/vector ROWS_PER_TABLE [TABLES] [THREADS] [CHUNK_SIZE]
+#        e.g. 100000000 5 8 1000000  (5 x 100M = 500M rows, 8 snapshot threads)
+#
+# Seeds tables on the MySQL server itself (INSERT ... SELECT, binlog off for the seed), takes one
+# snapshot with Vector into local gzip NDJSON files, and verifies every table's row count,
+# sum(id) and sum(val) against MySQL, plus Debezium's first/last snapshot markers.
+# Requires: docker (with compose), jq, python3.
+set -uo pipefail
+
+VECTOR=${1:?usage: run-snapshot-bench.sh /path/to/vector ROWS_PER_TABLE [TABLES] [THREADS] [CHUNK]}
+VECTOR=$(cd "$(dirname "$VECTOR")" && pwd)/$(basename "$VECTOR")
+ROWS=${2:?rows per table}
+TABLES=${3:-5}
+THREADS=${4:-8}
+CHUNK=${5:-1000000}
+SEED_BATCH=1000000
+cd "$(dirname "$0")"
+
+for tool in docker jq python3; do
+  command -v "$tool" >/dev/null || { echo "$tool is required"; exit 2; }
+done
+
+log() { echo "[$(date +%T)] $*"; }
+TOTAL=$(( ROWS * TABLES ))
+
+# ---------------------------------------------------------------- preflight
+cores=$(nproc)
+mem_gb=$(awk '/MemTotal/ {printf "%d", $2 / 1048576}' /proc/meminfo)
+wsl_free_gb=$(df -BG --output=avail / | tail -1 | tr -dc '0-9')
+win_free_gb=$(df -BG --output=avail /mnt/c 2>/dev/null | tail -1 | tr -dc '0-9')
+free_gb=$wsl_free_gb
+# WSL's virtual disk grows on the Windows drive, so the Windows free space is the real limit.
+[ -n "$win_free_gb" ] && [ "$win_free_gb" -lt "$free_gb" ] && free_gb=$win_free_gb
+# Measured: ~490 B/row in InnoDB (row, PK, page overhead) + ~70 B/row of gzip output; +20%.
+need_gb=$(( TOTAL * 560 / 1000000000 * 12 / 10 + 5 ))
+log "Snapshot benchmark: $TABLES tables x $ROWS rows = $TOTAL rows, $THREADS threads, chunk $CHUNK"
+log "Host: $cores cores, ${mem_gb} GB RAM visible to WSL, ${free_gb} GB free disk (WSL ${wsl_free_gb} GB, Windows ${win_free_gb:-?} GB); estimated need ${need_gb} GB"
+if [ "$free_gb" -lt "$need_gb" ]; then
+  log "ERROR: not enough free disk for this run (need ~${need_gb} GB, have ${free_gb} GB)"
+  exit 3
+fi
+
+# Give InnoDB a buffer pool proportional to the memory available (25%, 1-8 GB).
+pool_gb=$(( mem_gb / 4 )); [ "$pool_gb" -lt 1 ] && pool_gb=1; [ "$pool_gb" -gt 8 ] && pool_gb=8
+
+VPID=""
+SAMPLER=""
+cleanup() {
+  [ -n "$SAMPLER" ] && kill "$SAMPLER" 2>/dev/null
+  [ -n "$VPID" ] && kill -TERM "$VPID" 2>/dev/null
+}
+trap cleanup EXIT
+
+mysql_root() { docker exec -i cdc-mysql mysql -uroot -prootpw "$@" 2>>out/load-bench-mysql.err; }
+
+wait_for() {
+  local timeout=$1 desc=$2; shift 2
+  for _ in $(seq 1 "$timeout"); do
+    if "$@" >/dev/null 2>&1; then return 0; fi
+    sleep 1
+  done
+  log "timed out waiting for: $desc"
+  return 1
+}
+
+# ---------------------------------------------------------------- environment
+rm -rf out/bench-* out/load-bench-* && mkdir -p out/bench-data out/bench-output
+sed -e "s/@SNAP_THREADS@/$THREADS/" -e "s/@SNAP_CHUNK@/$CHUNK/" -e "s|@OUT_DIR@|$(pwd)/out/bench-output|" \
+  vector-snapbench.yaml > out/bench-vector.yaml
+if ! "$VECTOR" validate --no-environment out/bench-vector.yaml > out/load-bench-validate.log 2>&1; then
+  log "ERROR: the generated Vector config is invalid:"; cat out/load-bench-validate.log
+  exit 1
+fi
+docker compose down -v >/dev/null 2>&1
+docker compose up -d mysql >/dev/null 2>&1 || { log "docker compose up failed"; exit 1; }
+wait_for 180 "MySQL healthy" \
+  bash -c '[ "$(docker inspect -f "{{.State.Health.Status}}" cdc-mysql)" = healthy ]' || exit 1
+wait_for 60 "init.sql applied" bash -c "docker exec cdc-mysql mysql -uroot -prootpw -N -e 'SELECT 1 FROM inventory.customers LIMIT 1' 2>/dev/null | grep -q 1" || exit 1
+
+mysql_root -e "
+  SET GLOBAL innodb_buffer_pool_size = ${pool_gb} * 1024 * 1024 * 1024;
+  SET GLOBAL innodb_redo_log_capacity = 4 * 1024 * 1024 * 1024;
+  SET GLOBAL innodb_flush_log_at_trx_commit = 2;
+  SET GLOBAL sync_binlog = 0;"
+
+# ---------------------------------------------------------------- seed (server side)
+log "Seeding (binlog off for the seed; ${pool_gb} GB buffer pool)"
+seed_start=$(date +%s)
+mysql_root -e "
+  SET SESSION sql_log_bin = 0;
+  SET SESSION cte_max_recursion_depth = $(( SEED_BATCH + 1 ));
+  DROP DATABASE IF EXISTS bench;
+  CREATE DATABASE bench;
+  CREATE TABLE bench.seq (n INT PRIMARY KEY);
+  INSERT INTO bench.seq WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < $SEED_BATCH) SELECT n FROM c;"
+seed_table() { # one session per table, so tables load in parallel
+  local t=$1
+  {
+    echo "SET SESSION sql_log_bin = 0;"
+    echo "CREATE TABLE bench.t$t (id BIGINT PRIMARY KEY, val INT NOT NULL, note VARCHAR(64), amount DECIMAL(12,2), status ENUM('new','paid','shipped'), updated DATETIME(6));"
+    local done_rows=0
+    while [ "$done_rows" -lt "$ROWS" ]; do
+      local n=$(( ROWS - done_rows )); [ "$n" -gt "$SEED_BATCH" ] && n=$SEED_BATCH
+      echo "INSERT INTO bench.t$t SELECT $done_rows + n, (($done_rows + n) * 7919) % 1000003, CONCAT('row ', $done_rows + n), ($done_rows + n) / 100, ELT(1 + (($done_rows + n) % 3), 'new', 'paid', 'shipped'), '2024-01-01 00:00:00.000000' FROM bench.seq WHERE n <= $n;"
+      done_rows=$(( done_rows + n ))
+    done
+  } | mysql_root
+}
+pids=()
+for t in $(seq 1 "$TABLES"); do seed_table "$t" & pids+=($!); done
+progress() {
+  while true; do
+    sleep 60
+    local loaded
+    loaded=$(mysql_root -N -e "SELECT COALESCE(SUM(TABLE_ROWS), 0) FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'bench' AND TABLE_NAME LIKE 't%'" | tr -d ' ')
+    log "  seeding... ~$loaded rows so far"
+  done
+}
+progress & PROGRESS=$!
+for p in "${pids[@]}"; do wait "$p"; done
+kill "$PROGRESS" 2>/dev/null
+seed_seconds=$(( $(date +%s) - seed_start ))
+log "Seeded in ${seed_seconds}s"
+
+log "Computing expected counts and checksums"
+: > out/load-bench-truth.tsv
+for t in $(seq 1 "$TABLES"); do
+  echo "t$t $(mysql_root -N -e "SELECT COUNT(*), SUM(id), SUM(val) FROM bench.t$t" | tr '\t' ' ')" >> out/load-bench-truth.tsv
+done
+cat out/load-bench-truth.tsv
+
+# ---------------------------------------------------------------- snapshot
+sample_resources() {
+  local hz prev_ticks="" prev_t=""
+  hz=$(getconf CLK_TCK)
+  echo "t,rss_kb,cpu_pct" > out/load-bench-resources.csv
+  while true; do
+    if [ -r "/proc/$1/stat" ]; then
+      local ticks rss now
+      ticks=$(awk '{print $14 + $15}' "/proc/$1/stat")
+      rss=$(awk '/VmRSS/ {print $2}' "/proc/$1/status")
+      now=$(date +%s.%N)
+      if [ -n "$prev_ticks" ]; then
+        awk -v t="$now" -v pt="$prev_t" -v k="$ticks" -v pk="$prev_ticks" -v hz="$hz" -v rss="$rss" \
+          'BEGIN { printf "%.1f,%d,%.1f\n", t, rss, (k - pk) / hz / (t - pt) * 100 }' >> out/load-bench-resources.csv
+      fi
+      prev_ticks=$ticks
+      prev_t=$now
+    fi
+    sleep 2
+  done
+}
+
+log "Snapshotting with Vector ($THREADS threads)"
+vector_start=$(date +%s.%N)
+"$VECTOR" --config out/bench-vector.yaml > out/load-vector.log 2>&1 &
+VPID=$!
+sample_resources "$VPID" & SAMPLER=$!
+last_report=0
+completed_at=""
+while kill -0 "$VPID" 2>/dev/null; do
+  sleep 5
+  now=$(date +%s)
+  # Vector exits by itself once the snapshot is delivered; don't wait forever if it doesn't.
+  if [ -z "$completed_at" ] && grep -q "Snapshot completed" out/load-vector.log; then completed_at=$now; fi
+  if [ -n "$completed_at" ] && [ $(( now - completed_at )) -gt 300 ]; then
+    log "Vector still running 5 minutes after the snapshot completed; stopping it"
+    kill -TERM "$VPID" 2>/dev/null
+  fi
+  if [ $(( now - last_report )) -ge 60 ]; then
+    last_report=$now
+    rows_done=$(grep -o 'Snapshot progress.*rows=[0-9]*' out/load-vector.log | tail -1 | grep -o 'rows=[0-9]*' | tr -dc '0-9')
+    log "  snapshot... ${rows_done:-0} rows emitted, output $(du -sh out/bench-output | cut -f1)"
+  fi
+done
+wait "$VPID"; vrc=$?
+VPID=""
+vector_seconds=$(awk -v s="$vector_start" -v e="$(date +%s.%N)" 'BEGIN { printf "%.1f", e - s }')
+kill "$SAMPLER" 2>/dev/null; SAMPLER=""
+log "Vector exited with $vrc after ${vector_seconds}s"
+
+ts() { grep "$1" out/load-vector.log | head -1 | grep -oE '^[0-9TZ:.-]+'; }
+started=$(ts "Snapshot started"); completed=$(ts "Snapshot completed")
+snapshot_seconds=$(python3 -c "
+from datetime import datetime
+f = lambda s: datetime.fromisoformat(s.replace('Z', '+00:00'))
+print(round((f('$completed') - f('$started')).total_seconds(), 1))" 2>/dev/null)
+log "Snapshot: ${snapshot_seconds:-?}s (from 'Snapshot started' to 'Snapshot completed')"
+
+python3 - "$THREADS" "$CHUNK" "$seed_seconds" "${snapshot_seconds:-0}" "$vector_seconds" \
+  "$cores" "$mem_gb" > out/load-bench-metrics.json <<'PY'
+import csv, json, statistics, sys
+threads, chunk, seed, snap, vec, cores, mem = sys.argv[1:]
+rows = [r for r in csv.DictReader(open("out/load-bench-resources.csv"))]
+rss = [int(r["rss_kb"]) / 1024 for r in rows]
+cpu = [float(r["cpu_pct"]) for r in rows]
+print(json.dumps({
+    "threads": int(threads), "chunk_size": int(chunk), "seed_seconds": int(seed),
+    "snapshot_seconds": float(snap), "vector_seconds": float(vec),
+    "rss_mb_max": round(max(rss), 1) if rss else None,
+    "cpu_pct_avg": round(statistics.mean(cpu), 1) if cpu else None,
+    "cpu_pct_max": round(max(cpu), 1) if cpu else None,
+    "host": {"cores": int(cores), "mem_gb": int(mem)},
+}))
+PY
+
+log "Verifying"
+python3 verify_snapshot.py --output out/bench-output --truth out/load-bench-truth.tsv \
+  --metrics out/load-bench-metrics.json --report out/load-bench-report.json
+verified=$?
+errors=$(grep -c " ERROR " out/load-vector.log)
+log "Vector logged $errors error line(s)"
+grep " ERROR " out/load-vector.log | cut -c1-200 | head -5
+log "Disk used: MySQL $(docker exec cdc-mysql du -sh /var/lib/mysql 2>/dev/null | cut -f1), output $(du -sh out/bench-output | cut -f1)"
+log "To free the space afterwards: docker compose down -v && rm -rf out/"
+[ "$verified" -eq 0 ] && [ "$errors" -eq 0 ] && [ "$vrc" -eq 0 ]
diff --git a/contrib/mysql_cdc/vector-adls.example.yaml b/contrib/mysql_cdc/vector-adls.example.yaml
new file mode 100644
index 0000000..7a68b34
--- /dev/null
+++ b/contrib/mysql_cdc/vector-adls.example.yaml
@@ -0,0 +1,183 @@
+# Production-style pipeline: MySQL binlog -> change events -> an Azure storage account (Blob
+# Storage or ADLS Gen2), for example a data lake landing zone.
+#
+# One process replaces Debezium Server + its HTTP sink + a separate shipper. Offsets are only
+# stored after the events are durably handed off (end-to-end acknowledgements), so a crash or
+# restart never loses changes; it may replay the last few seconds (at-least-once).
+#
+# Storage layout (one folder per connector):
+#   cdc/prod-mysql/<db>/<table>/date=…/      row changes only: c, r, u, d — ordered by metadata.seq
+#   cdc/prod-mysql/_control/date=…/          schema_change, truncate, snapshot_completed
+#   cdc/prod-mysql/_schemas/<db>/<table>/<schema_version>.json
+#   cdc/prod-mysql/_offsets/latest.json      published commit point (+ _offsets/history/)
+#
+# Each row change is one line like:
+#   {"metadata": {"op": "u", "seq": "00000000000000009001.0000000000", "deleted": false, "snapshot": "false", "db": "inventory",
+#                 "table": "customers", "key": {"id": 1}, "commit_ts_ms": …, "gtid": "…:42",
+#                 "file": "mysql-bin.000003", "pos": 1543, "row": 0,
+#                 "schema_version": "338df4226391e36c", …},
+#    "record":   {"id": 1, "name": "Alicia", …}}
+# With record_images: before_and_after, `record` holds both images:
+#    "record":   {"before": {"id": 1, "name": "Alice", …}, "after": {"id": 1, "name": "Alicia", …}}
+data_dir: /var/lib/vector
+
+# Secrets are read from files: /run/secrets/vectezium/<name> (e.g. a Kubernetes or Container Apps
+# secret volume). Vector 0.60 does not expand ${ENV_VARS} in configs unless started with
+# --dangerously-allow-env-var-interpolation, so do not rely on that for passwords.
+secret:
+  files:
+    type: directory
+    path: /run/secrets/vectezium
+    remove_trailing_whitespace: true
+
+acknowledgements:
+  enabled: true
+
+sources:
+  mysql:
+    type: mysql_cdc
+    hostname: mysql.internal
+    port: 3306
+    user: vector_cdc
+    password: "SECRET[files.mysql_password]"
+    server_id: 184054                 # unique among all replicas of this server
+    topic_prefix: prod-mysql          # emitted as metadata.server_name
+    database_include_list: ["inventory", "billing"]
+    table_exclude_list: ["billing\\.tmp_.*"]
+    column_exclude_list: ["inventory\\.customers\\.(ssn|password_hash)"]
+    snapshot_mode: when_needed        # re-snapshot automatically if the binlog was purged
+    batch_size: 2048                  # events per downstream batch
+    decimal_handling_mode: string     # exact decimals that downstream tools can read
+    event_format: record              # metadata + record (use `debezium` for Debezium envelopes)
+    record_images: after              # or before_and_after to also keep the previous row image
+    include_table_schemas: true       # schema document per table version -> `mysql.table_schemas`
+    include_schema_changes: true
+    snapshot_strategy: incremental    # chunked snapshot while streaming: no long locks (needs GTIDs)
+    snapshot_new_tables: true         # snapshot tables added to the include lists later
+    publish_offsets: true             # publish the commit point to _offsets/
+    single_writer_lock:               # one instance at a time (redeploys, platform moves)
+      account_name: mystorage
+      auth:
+        azure_credential_kind: managed_identity
+      container_name: raw
+      blob_name: cdc/prod-mysql/_lock
+    offset_recovery:                  # data directory lost: resume from _offsets/latest.json
+      latest_blob: cdc/prod-mysql/_offsets/latest.json
+      folder: cdc/prod-mysql/
+    unplanned_snapshots: hold         # re-snapshots nobody asked for wait for an operator
+    ssl_mode: verify_identity
+    # ssl_ca_file: /etc/ssl/certs/DigiCertGlobalRootG2.crt.pem   # e.g. Azure Database for MySQL
+
+sinks:
+  # Every table's row changes (c, r, u, d), ordered by metadata.seq:
+  #   cdc/prod-mysql/<db>/<table>/date=YYYY-MM-DD/<uuid>.json.gz
+  rows:
+    type: azure_blob
+    inputs: ["mysql"]
+    account_name: mystorage           # the destination storage account (Blob Storage or ADLS Gen2)
+    auth:
+      azure_credential_kind: managed_identity
+    container_name: raw
+    blob_prefix: "cdc/prod-mysql/{{ metadata.db }}/{{ metadata.table }}/date=%Y-%m-%d/"
+    blob_append_uuid: true
+    blob_extension: json.gz
+    encoding:
+      codec: json
+      except_fields: ["source_type", "timestamp"]   # added by Vector; keep rows to metadata + record
+    framing:
+      method: newline_delimited
+    compression: gzip
+    batch:
+      max_bytes: 100000000            # ~100 MB per blob (uncompressed)
+      timeout_secs: 300               # data in storage is at most ~5 minutes old
+    # Survive restarts and ADLS outages without holding everything in memory.
+    buffer:
+      type: disk
+      max_size: 10737418240           # 10 GiB
+      when_full: block
+
+  # Connector events: schema_change, truncate, snapshot_completed (each with seq).
+  control:
+    type: azure_blob
+    inputs: ["mysql.control"]
+    account_name: mystorage           # the destination storage account (Blob Storage or ADLS Gen2)
+    auth:
+      azure_credential_kind: managed_identity
+    container_name: raw
+    blob_prefix: "cdc/prod-mysql/_control/date=%Y-%m-%d/"
+    blob_append_uuid: true
+    blob_extension: json.gz
+    encoding:
+      codec: json
+      except_fields: ["source_type", "timestamp"]
+    framing:
+      method: newline_delimited
+    compression: gzip
+    batch:
+      timeout_secs: 10               # control events take part in checkpointing; keep this short
+
+  # One blob per table schema version (re-emitted documents overwrite themselves).
+  table_schemas:
+    type: azure_blob
+    inputs: ["mysql.table_schemas"]
+    account_name: mystorage           # the destination storage account (Blob Storage or ADLS Gen2)
+    auth:
+      azure_credential_kind: managed_identity
+    container_name: raw
+    blob_prefix: "cdc/prod-mysql/_schemas/{{ db }}/{{ table }}/{{ schema_version }}"
+    blob_time_format: ""
+    blob_append_uuid: false
+    blob_overwrite: true
+    blob_extension: json
+    encoding:
+      codec: json
+      except_fields: ["source_type", "timestamp"]
+    framing:
+      method: newline_delimited
+    compression: none
+    batch:
+      timeout_secs: 10
+
+  # Published offsets: every event with seq <= the published seq is in storage, and every
+  # transaction it belongs to is complete. Append-only history (for Auto Loader) ...
+  offsets_history:
+    type: azure_blob
+    inputs: ["mysql.offsets"]
+    account_name: mystorage           # the destination storage account (Blob Storage or ADLS Gen2)
+    auth:
+      azure_credential_kind: managed_identity
+    container_name: raw
+    blob_prefix: "cdc/prod-mysql/_offsets/history/date=%Y-%m-%d/"
+    blob_append_uuid: true
+    blob_extension: json
+    encoding:
+      codec: json
+      except_fields: ["source_type", "timestamp"]
+    framing:
+      method: newline_delimited
+    compression: none
+    batch:
+      timeout_secs: 10
+
+  # ... and the latest one, overwritten in place.
+  offsets_latest:
+    type: azure_blob
+    inputs: ["mysql.offsets"]
+    account_name: mystorage           # the destination storage account (Blob Storage or ADLS Gen2)
+    auth:
+      azure_credential_kind: managed_identity
+    container_name: raw
+    blob_prefix: "cdc/prod-mysql/_offsets/latest"
+    blob_time_format: ""
+    blob_append_uuid: false
+    blob_overwrite: true
+    blob_extension: json
+    encoding:
+      codec: json
+      except_fields: ["source_type", "timestamp"]
+    framing:
+      method: newline_delimited
+    compression: none
+    batch:
+      max_events: 1
+      timeout_secs: 1
diff --git a/contrib/mysql_cdc/vector-e2e-lock.yaml b/contrib/mysql_cdc/vector-e2e-lock.yaml

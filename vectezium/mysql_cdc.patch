diff --git a/contrib/mysql_cdc/verify_load.py b/contrib/mysql_cdc/verify_load.py
new file mode 100755
index 0000000..60621e5
--- /dev/null
+++ b/contrib/mysql_cdc/verify_load.py
@@ -0,0 +1,201 @@
+#!/usr/bin/env python3
+"""Verifies a mysql_cdc load test.
+
+  verify_load.py --blobs DIR --expected load-expected.json --truth DIR --resources res.csv
+
+* reads every blob written by the source (`event_format: record`, gzip or plain NDJSON);
+* removes duplicates (at-least-once delivery) using the documented key;
+* checks the number of unique changes per table and operation against what was generated;
+* replays snapshot rows + changes in binlog order and compares the result with the tables'
+  actual final contents (`truth` holds `<table>.tsv` dumps of `id<TAB>val`);
+* reports capture lag (commit -> captured), throughput and Vector's resource use.
+"""
+
+import argparse
+import gzip
+import json
+import os
+import statistics
+import sys
+
+
+def read_rows(directory):
+    for root, _, files in os.walk(directory):
+        for name in sorted(files):
+            path = os.path.join(root, name)
+            with open(path, "rb") as f:
+                data = f.read()
+            if data[:2] == b"\x1f\x8b":
+                data = gzip.decompress(data)
+            for line in data.splitlines():
+                if line.strip():
+                    yield json.loads(line)
+
+
+def pct(values, p):
+    if not values:
+        return None
+    values = sorted(values)
+    k = min(len(values) - 1, max(0, int(round(p / 100 * (len(values) - 1)))))
+    return values[k]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--blobs", required=True)
+    ap.add_argument("--expected", required=True)
+    ap.add_argument("--truth", required=True)
+    ap.add_argument("--resources")
+    ap.add_argument("--report", default="load-report.json")
+    args = ap.parse_args()
+
+    expected = json.load(open(args.expected))
+    failures = []
+
+    raw = 0
+    unique = {}
+    ends = {}
+    snapshot_ids = set()
+    seq_of = {}
+    seq_conflicts = 0
+    for row in read_rows(args.blobs):
+        if "type" in row:  # a control event
+            if row["type"] == "snapshot_completed" and row.get("db") == "loadtest":
+                ends.setdefault(row["table"], row)
+            continue
+        m = row["metadata"]
+        if m.get("db") != "loadtest":
+            continue
+        # Replayed events must carry the same seq as their first delivery.
+        ident = (m["table"], m["file"], m["pos"], m["row"], m["op"], m["op"] == "r" and row["record"]["id"])
+        if seq_of.setdefault(ident, m.get("seq")) != m.get("seq"):
+            seq_conflicts += 1
+        if m["op"] == "r":
+            snapshot_ids.add(m.get("snapshot_id"))
+        raw += 1
+        if m["op"] == "r":
+            key = ("r", m["table"], row["record"]["id"])
+        else:
+            key = (m["table"], m["file"], m["pos"], m["row"], m["op"])
+        unique.setdefault(key, row)
+
+    rows = list(unique.values())
+    duplicates = raw - len(rows)
+
+    # --- counts per table and operation ---
+    counts = {}
+    for row in rows:
+        m = row["metadata"]
+        counts.setdefault(m["table"], {"r": 0, "c": 0, "u": 0, "d": 0})[m["op"]] += 1
+    for table, exp in expected["counts"].items():
+        got = counts.get(table, {"r": 0, "c": 0, "u": 0, "d": 0})
+        for op in ("c", "u", "d"):
+            if got[op] != exp[op]:
+                failures.append(f"{table}: expected {exp[op]} '{op}' events, got {got[op]}")
+        if got["r"] != expected["seed_rows"]:
+            failures.append(f"{table}: expected {expected['seed_rows']} snapshot rows, got {got['r']}")
+
+    # --- snapshot markers: one per table, row count and snapshot id agree with the rows ---
+    for table in expected["counts"]:
+        end = ends.get(table)
+        if end is None:
+            failures.append(f"{table}: no snapshot_completed event")
+        elif end.get("rows") != expected["seed_rows"]:
+            failures.append(f"{table}: snapshot_completed says {end.get('rows')} rows, expected {expected['seed_rows']}")
+    if len(snapshot_ids) != 1 or None in snapshot_ids or {e.get("snapshot_id") for e in ends.values()} != snapshot_ids:
+        failures.append(f"snapshot ids disagree: rows {snapshot_ids}, markers {[e.get('snapshot_id') for e in ends.values()]}")
+
+    if seq_conflicts:
+        failures.append(f"{seq_conflicts} replayed events got a different seq than their first delivery")
+    if any(r["metadata"].get("seq") is None for r in rows):
+        failures.append("events without metadata.seq")
+
+    # --- replay and compare with the real table contents ---
+    def binlog_order(row):
+        m = row["metadata"]
+        return (m["file"], m["pos"], m["row"])
+
+    state = {}
+    for row in rows:
+        if row["metadata"]["op"] == "r":
+            state.setdefault(row["metadata"]["table"], {})[row["record"]["id"]] = row["record"]["val"]
+    changes = sorted((r for r in rows if r["metadata"]["op"] != "r"), key=binlog_order)
+    for row in changes:
+        m = row["metadata"]
+        table = state.setdefault(m["table"], {})
+        if m["op"] == "d":
+            table.pop(row["record"]["id"], None)
+        else:
+            table[row["record"]["id"]] = row["record"]["val"]
+
+    for table in expected["counts"]:
+        truth = {}
+        with open(os.path.join(args.truth, f"{table}.tsv")) as f:
+            for line in f:
+                if line.strip():
+                    i, v = line.split("\t")
+                    truth[int(i)] = int(v)
+        replayed = state.get(table, {})
+        if replayed != truth:
+            missing = len(truth.keys() - replayed.keys())
+            extra = len(replayed.keys() - truth.keys())
+            wrong = sum(1 for k in truth.keys() & replayed.keys() if truth[k] != replayed[k])
+            failures.append(
+                f"{table}: replayed state differs from MySQL (missing {missing}, extra {extra}, "
+                f"wrong values {wrong})"
+            )
+
+    # --- lag and throughput ---
+    lags = [
+        r["metadata"]["captured_ts_ms"] - r["metadata"]["commit_ts_ms"]
+        for r in changes
+    ]
+    captured = [r["metadata"]["captured_ts_ms"] for r in changes]
+    span_s = (max(captured) - min(captured)) / 1000 if captured else 0
+
+    resources = []
+    if args.resources and os.path.exists(args.resources):
+        for line in open(args.resources):
+            parts = line.split(",")
+            if len(parts) == 3 and parts[1].strip().isdigit():
+                resources.append((float(parts[0]), int(parts[1]) / 1024, float(parts[2])))
+
+    report = {
+        "result": "PASS" if not failures else "FAIL",
+        "failures": failures,
+        "generated": {
+            "statements": expected["statements"],
+            "rate_target_per_s": expected["rate_target"],
+            "rate_generated_per_s": expected["rate_generated"],
+            "duration_s": expected["duration_s"],
+            "tables": expected["tables"],
+        },
+        "delivered": {
+            "rows_in_blobs": raw,
+            "unique_changes": len(changes),
+            "snapshot_rows": len(rows) - len(changes),
+            "duplicates_after_crash": duplicates,
+            "capture_rate_per_s": round(len(changes) / span_s, 1) if span_s else None,
+        },
+        "capture_lag_ms": {
+            "p50": pct(lags, 50),
+            "p95": pct(lags, 95),
+            "p99": pct(lags, 99),
+            "max": max(lags) if lags else None,
+            "mean": round(statistics.mean(lags), 1) if lags else None,
+        },
+        "vector_resources": {
+            "rss_mb_max": round(max(r[1] for r in resources), 1) if resources else None,
+            "rss_mb_avg": round(statistics.mean(r[1] for r in resources), 1) if resources else None,
+            "cpu_pct_avg": round(statistics.mean(r[2] for r in resources), 1) if resources else None,
+            "cpu_pct_max": round(max(r[2] for r in resources), 1) if resources else None,
+        },
+    }
+    with open(args.report, "w") as f:
+        json.dump(report, f, indent=2)
+    print(json.dumps(report, indent=2))
+    sys.exit(0 if not failures else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/contrib/mysql_cdc/verify_snapshot.py b/contrib/mysql_cdc/verify_snapshot.py
new file mode 100755
index 0000000..fe6454c
--- /dev/null
+++ b/contrib/mysql_cdc/verify_snapshot.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Verifies a snapshot benchmark: per table row count, sum(id), sum(val) and snapshot markers,
+compared with MySQL. Streams the gzip NDJSON files in parallel (one process per file)."""
+
+import argparse
+import gzip
+import json
+import os
+import sys
+from multiprocessing import Pool
+
+
+def scan(path):
+    count = sum_id = sum_val = 0
+    markers = {}
+    with gzip.open(path, "rt") as f:
+        for line in f:
+            row = json.loads(line)
+            record = row["record"]
+            count += 1
+            sum_id += record["id"]
+            sum_val += record["val"]
+            marker = row["metadata"]["snapshot"]
+            if marker != "true":
+                markers[marker] = markers.get(marker, 0) + 1
+    return os.path.basename(path).split(".")[0], count, sum_id, sum_val, markers
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--output", required=True)
+    ap.add_argument("--truth", required=True, help="TSV: table count sum_id sum_val")
+    ap.add_argument("--metrics", required=True, help="JSON with timings and resources")
+    ap.add_argument("--report", required=True)
+    args = ap.parse_args()
+
+    files = sorted(
+        os.path.join(args.output, f) for f in os.listdir(args.output) if f.endswith(".ndjson.gz")
+    )
+    with Pool(min(len(files), os.cpu_count() or 1) or 1) as pool:
+        results = pool.map(scan, files)
+
+    truth = {}
+    for line in open(args.truth):
+        if line.strip():
+            table, count, sum_id, sum_val = line.split()
+            truth[table] = (int(count), int(sum_id), int(sum_val))
+
+    failures = []
+    seen = {}
+    markers = {}
+    for table, count, sum_id, sum_val, m in results:
+        seen[table] = (count, sum_id, sum_val)
+        for k, v in m.items():
+            markers[k] = markers.get(k, 0) + v
+    for table, expected in truth.items():
+        got = seen.get(table)
+        if got != expected:
+            failures.append(f"{table}: expected (rows, sum id, sum val) {expected}, got {got}")
+    tables = len(truth)
+    if markers.get("first", 0) != 1 or markers.get("last", 0) != 1:
+        failures.append(f"expected exactly one 'first' and one 'last' marker, got {markers}")
+    if markers.get("first", 0) + markers.get("first_in_data_collection", 0) != tables:
+        failures.append(f"expected {tables} first-of-table markers, got {markers}")
+    if markers.get("last", 0) + markers.get("last_in_data_collection", 0) != tables:
+        failures.append(f"expected {tables} last-of-table markers, got {markers}")
+    control_path = os.path.join(args.output, "_control.ndjson")
+    completed = []
+    if os.path.exists(control_path):
+        completed = [json.loads(l) for l in open(control_path) if l.strip()]
+        completed = [c for c in completed if c.get("type") == "snapshot_completed"]
+    if len(completed) != tables:
+        failures.append(f"expected {tables} snapshot_completed events, got {len(completed)}")
+    elif sum(c["rows"] for c in completed) != sum(t[0] for t in truth.values()):
+        failures.append(f"snapshot_completed row counts {sum(c['rows'] for c in completed)} != rows")
+    elif any(c.get("started_seq") is None for c in completed):
+        failures.append("snapshot_completed without started_seq")
+
+    metrics = json.load(open(args.metrics))
+    rows = sum(c for c, _, _ in truth.values())
+    snap_s = metrics.get("snapshot_seconds") or 0
+    report = {
+        "result": "PASS" if not failures else "FAIL",
+        "failures": failures,
+        "rows": rows,
+        "tables": tables,
+        "threads": metrics.get("threads"),
+        "chunk_size": metrics.get("chunk_size"),
+        "seed_seconds": metrics.get("seed_seconds"),
+        "snapshot_seconds": snap_s,
+        "rows_per_second": round(rows / snap_s) if snap_s else None,
+        "vector_total_seconds": metrics.get("vector_seconds"),
+        "output_gzip_bytes": sum(os.path.getsize(f) for f in files),
+        "vector_rss_mb_max": metrics.get("rss_mb_max"),
+        "vector_cpu_pct_avg": metrics.get("cpu_pct_avg"),
+        "vector_cpu_pct_max": metrics.get("cpu_pct_max"),
+        "host": metrics.get("host"),
+    }
+    with open(args.report, "w") as f:
+        json.dump(report, f, indent=2)
+    print(json.dumps(report, indent=2))
+    sys.exit(0 if not failures else 1)
+
+
+if __name__ == "__main__":

@@ -0,0 +1,489 @@
+//! Binlog offsets and GTID-set bookkeeping. Storage, checkpointing and publishing are shared
+//! by every connector (`cdc::checkpoint`); [`Offset`] is MySQL's [`CdcOffset`].
+//!
+//! An [`Offset`] always points at a transaction boundary: the binlog position *after* the last
+//! fully processed transaction, plus the GTID set executed up to and including that transaction.
+//! Restarting from an offset therefore never resumes in the middle of a transaction.
+
+use std::{collections::BTreeMap, fmt, str::FromStr};
+
+use mysql_async::Sid;
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value as Json};
+
+use crate::sources::cdc::checkpoint::CdcOffset;
+pub use crate::sources::cdc::checkpoint::{CHECKPOINT_FILENAME, CheckpointStore};
+
+/// Current on-disk checkpoint format version.
+const CHECKPOINT_VERSION: u32 = 1;
+
+/// A resumable position in the MySQL binlog.
+#[derive(Clone, Debug, Default, Eq, PartialEq, Serialize, Deserialize)]
+pub struct Offset {
+    /// Checkpoint format version.
+    #[serde(default = "default_version")]
+    pub version: u32,
+
+    /// `@@server_uuid` of the server the offset was taken from.
+    #[serde(default)]
+    pub server_uuid: Option<String>,
+
+    /// The binlog file name.
+    pub file: String,
+
+    /// Position inside `file` right after the last processed transaction.
+    pub pos: u64,
+
+    /// Executed GTID set including the last processed transaction (empty when GTIDs are off).
+    #[serde(default)]
+    pub gtid_set: String,
+
+    /// Whether the initial snapshot has fully completed and been delivered.
+    #[serde(default)]
+    pub snapshot_completed: bool,
+
+    /// The `seq` the next event will get. Every event with a lower `seq` is delivered, and
+    /// events replayed after a restart get the same numbers again.
+    #[serde(default)]
+    pub next_seq: u64,
+
+    /// The snapshot position within `next_seq - 1` reached at this offset (see `master_seq`).
+    #[serde(default)]
+    pub seq_sub: u64,
+
+    /// Captured tables whose existing rows have been snapshotted (or that were created while
+    /// streaming, so all their rows came from the binlog), as `[database, table]`. Absent in
+    /// offsets written before incremental snapshots existed.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub snapshotted_tables: Option<Vec<TableRef>>,
+
+    /// An incremental snapshot in progress.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub incremental: Option<IncrementalProgress>,
+
+    /// Captured tables that need a snapshot nobody asked for (`unplanned_snapshots: hold`), as
+    /// `[database, table]`. They are streamed but not snapshotted until an operator queues them
+    /// (or marks them as snapshotted).
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub held_tables: Vec<TableRef>,
+
+    /// Set by an operator to approve a full re-snapshot after the binlog was purged
+    /// (`unplanned_snapshots: hold`). Used once: offsets written afterwards do not carry it.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub resnapshot_approved: bool,
+}
+
+/// `(database, table)`.
+pub type TableRef = (String, String);
+
+/// Progress of an incremental (chunked) snapshot, stored with the offset so it resumes after a
+/// restart from the last delivered chunk.
+#[derive(Clone, Debug, Default, Eq, PartialEq, Serialize, Deserialize)]
+pub struct IncrementalProgress {
+    pub snapshot_id: String,
+    /// When the snapshot started (ms since the epoch); informational.
+    pub started_ms: i64,
+    /// The `seq` when the first table in `tables` started being read: changes with a `seq` at
+    /// or above it are newer than the snapshot of that table.
+    #[serde(default)]
+    pub started_seq: Option<u64>,
+    /// Tables still to snapshot; the first is in progress.
+    pub tables: Vec<TableRef>,
+    /// SQL literals of the key of the last row delivered from the first table.
+    #[serde(default)]
+    pub last_key: Option<Vec<String>>,
+    /// Rows delivered so far from the first table.
+    #[serde(default)]
+    pub rows: u64,
+}
+
+const fn default_version() -> u32 {
+    CHECKPOINT_VERSION
+}
+
+impl Offset {
+    pub fn new(
+        server_uuid: Option<String>,
+        file: String,
+        pos: u64,
+        gtid_set: String,
+        snapshot_completed: bool,
+    ) -> Self {
+        Self {
+            version: CHECKPOINT_VERSION,
+            server_uuid,
+            file,
+            pos,
+            gtid_set,
+            snapshot_completed,
+            next_seq: 0,
+            seq_sub: 0,
+            snapshotted_tables: None,
+            incremental: None,
+            held_tables: Vec::new(),
+            resnapshot_approved: false,
+        }
+    }
+
+    /// Attaches the table-snapshot state.
+    #[must_use]
+    pub fn with_tables(
+        mut self,
+        snapshotted_tables: Option<Vec<TableRef>>,
+        incremental: Option<IncrementalProgress>,
+    ) -> Self {
+        self.snapshotted_tables = snapshotted_tables;
+        self.incremental = incremental;
+        self
+    }
+
+    /// Attaches the tables whose snapshot is held.
+    #[must_use]
+    pub fn with_held(mut self, held_tables: Vec<TableRef>) -> Self {
+        self.held_tables = held_tables;
+        self
+    }
+
+    /// Rebuilds an offset from a published offset that predates the `checkpoint` field (it has
+    /// the position and `seq`, but not the table-snapshot state). `snapshotted` are the tables
+    /// with a `snapshot_completed` event in the lake.
+    pub fn from_published(
+        payload: &Map<String, Json>,
+        snapshotted: Vec<TableRef>,
+    ) -> Result<Self, String> {
+        let text = |key: &str| {
+            payload
+                .get(key)
+                .and_then(Json::as_str)
+                .ok_or_else(|| format!("the published offset has no `{key}`"))
+        };
+        let change_seq = payload
+            .get("change_seq")
+            .and_then(Json::as_u64)
+            .ok_or("the published offset has no `change_seq`")?;
+        let seq_sub = text("seq")?
+            .split_once('.')
+            .and_then(|(_, sub)| sub.parse::<u64>().ok())
+            .ok_or("the published offset has an invalid `seq`")?;
+        let pos = payload
+            .get("pos")
+            .and_then(Json::as_u64)
+            .ok_or("the published offset has no `pos`")?;
+        let mut offset = Self::new(
+            None,
+            text("file")?.to_owned(),
+            pos,
+            text("gtid_set")?.to_owned(),
+            true,
+        )
+        .with_tables(Some(snapshotted), None);
+        offset.next_seq = change_seq + 1;
+        offset.seq_sub = seq_sub;
+        Ok(offset)
+    }
+}
+
+impl CdcOffset for Offset {
+    fn seq(&self) -> (u64, u64) {
+        (self.next_seq, self.seq_sub)
+    }
+
+    fn set_seq(&mut self, next_seq: u64, seq_sub: u64) {
+        self.next_seq = next_seq;
+        self.seq_sub = seq_sub;
+    }
+
+    fn snapshot_in_progress(&self) -> bool {
+        !self.snapshot_completed || self.incremental.is_some()
+    }
+
+    fn publish_position(&self, payload: &mut Map<String, Json>) {
+        payload.insert("gtid_set".into(), Json::from(self.gtid_set.as_str()));
+        payload.insert("file".into(), Json::from(self.file.as_str()));
+        payload.insert("pos".into(), Json::from(self.pos));
+    }
+}
+
+impl fmt::Display for Offset {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "{}:{}", self.file, self.pos)?;
+        if !self.gtid_set.is_empty() {
+            write!(f, " (gtid_set: {})", self.gtid_set)?;
+        }
+        Ok(())
+    }
+}
+
+/// An executed GTID set, e.g. `3E11FA47-71CA-11E1-9E33-C80AA9429562:1-5:7,…`.
+///
+/// Intervals are stored inclusive and kept merged so the textual form stays compact.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct GtidSet {
+    /// Keyed by `uuid` (lowercase) or `uuid:tag` for tagged GTIDs (MySQL 8.4+).
+    sets: BTreeMap<String, Vec<(u64, u64)>>,
+}
+
+impl GtidSet {
+    #[cfg(test)]
+    pub fn is_empty(&self) -> bool {
+        self.sets.is_empty()
+    }
+
+    /// Adds a single transaction (`source_id` is `uuid` or `uuid:tag`).
+    pub fn add(&mut self, source_id: &str, gno: u64) {
+        let intervals = self.sets.entry(source_id.to_ascii_lowercase()).or_default();
+        insert_interval(intervals, gno, gno);
+    }
+
+    /// Whether the set contains a transaction.
+    pub fn contains(&self, source_id: &str, gno: u64) -> bool {
+        self.sets
+            .get(&source_id.to_ascii_lowercase())
+            .is_some_and(|intervals| intervals.iter().any(|&(s, e)| s <= gno && gno <= e))
+    }
+
+    /// Whether every transaction of `other` is in this set.
+    pub fn contains_set(&self, other: &GtidSet) -> bool {
+        other.sets.iter().all(|(key, theirs)| {
+            let ours = self.sets.get(key).map(Vec::as_slice).unwrap_or_default();
+            theirs
+                .iter()
+                .all(|&(s, e)| ours.iter().any(|&(os, oe)| os <= s && e <= oe))
+        })
+    }
+
+    /// Converts the set into the `Sid` list used by `COM_BINLOG_DUMP_GTID`.
+    pub fn to_sids(&self) -> Result<Vec<Sid<'static>>, String> {
+        self.to_string()
+            .split(',')
+            .map(str::trim)
+            .filter(|s| !s.is_empty())
+            .map(|s| {
+                Sid::from_str(s).map_err(|error| format!("invalid GTID set entry {s:?}: {error}"))
+            })
+            .collect()
+    }
+}
+
+fn insert_interval(intervals: &mut Vec<(u64, u64)>, start: u64, end: u64) {
+    intervals.push((start, end));
+    intervals.sort_unstable();
+    let mut merged: Vec<(u64, u64)> = Vec::with_capacity(intervals.len());
+    for &(s, e) in intervals.iter() {
+        match merged.last_mut() {
+            Some(last) if s <= last.1.saturating_add(1) => last.1 = last.1.max(e),
+            _ => merged.push((s, e)),
+        }
+    }
+    *intervals = merged;
+}
+
+impl FromStr for GtidSet {
+    type Err = String;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        let mut set = GtidSet::default();
+        for entry in s.split(',').map(str::trim).filter(|e| !e.is_empty()) {
+            let mut parts = entry.split(':');
+            let uuid = parts
+                .next()
+                .filter(|u| u.len() == 36)
+                .ok_or_else(|| format!("invalid GTID set entry: {entry:?}"))?
+                .to_ascii_lowercase();
+            let mut key = uuid.clone();
+            for part in parts {
+                let first = part.chars().next().unwrap_or('0');
+                if first.is_ascii_alphabetic() || first == '_' {
+                    // A tag applies to the intervals that follow it.
+                    key = format!("{uuid}:{part}");
+                    continue;
+                }
+                let (start, end) = match part.split_once('-') {
+                    Some((a, b)) => (parse_gno(a, entry)?, parse_gno(b, entry)?),
+                    None => {
+                        let n = parse_gno(part, entry)?;
+                        (n, n)
+                    }
+                };
+                if start == 0 || end < start {
+                    return Err(format!("invalid GTID interval {part:?} in {entry:?}"));
+                }
+                insert_interval(set.sets.entry(key.clone()).or_default(), start, end);
+            }
+        }
+        Ok(set)
+    }
+}
+
+fn parse_gno(s: &str, entry: &str) -> Result<u64, String> {
+    s.trim()
+        .parse::<u64>()
+        .map_err(|_| format!("invalid GTID number {s:?} in {entry:?}"))
+}
+
+impl fmt::Display for GtidSet {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let mut first = true;
+        for (key, intervals) in &self.sets {
+            if intervals.is_empty() {
+                continue;
+            }
+            if !first {
+                f.write_str(",")?;
+            }
+            first = false;
+            f.write_str(key)?;
+            for &(s, e) in intervals {
+                if s == e {
+                    write!(f, ":{s}")?;
+                } else {
+                    write!(f, ":{s}-{e}")?;
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const U1: &str = "3e11fa47-71ca-11e1-9e33-c80aa9429562";
+    const U2: &str = "4e11fa47-71ca-11e1-9e33-c80aa9429563";
+
+    #[test]
+    fn gtid_set_roundtrip_and_merge() {
+        let input = format!("{U2}:1-3,\n{U1}:1-5:7:9-10");
+        let mut set: GtidSet = input.parse().unwrap();
+        assert_eq!(set.to_string(), format!("{U1}:1-5:7:9-10,{U2}:1-3"));
+
+        set.add(U1, 6);
+        set.add(U1, 8);
+        set.add(&U2.to_uppercase(), 4);
+        assert_eq!(set.to_string(), format!("{U1}:1-10,{U2}:1-4"));
+    }
+
+    #[test]
+    fn gtid_set_containment() {
+        let big: GtidSet = format!("{U1}:1-10:15,{U2}:1-3").parse().unwrap();
+        assert!(big.contains(U1, 7));
+        assert!(big.contains(&U1.to_uppercase(), 15));
+        assert!(!big.contains(U1, 12));
+        assert!(!big.contains(U2, 4));
+        let small: GtidSet = format!("{U1}:2-5:15").parse().unwrap();
+        assert!(big.contains_set(&small));
+        assert!(!small.contains_set(&big));
+        let other: GtidSet = format!("{U1}:9-11").parse().unwrap();
+        assert!(!big.contains_set(&other));
+        assert!(big.contains_set(&GtidSet::default()));
+    }
+
+    #[test]
+    fn offsets_without_table_state_still_load() {
+        let old = r#"{"version":1,"file":"mysql-bin.000001","pos":4,"gtid_set":"","snapshot_completed":true}"#;
+        let offset: Offset = serde_json::from_str(old).unwrap();
+        assert_eq!(offset.snapshotted_tables, None);
+        assert_eq!(offset.incremental, None);
+    }
+
+    #[test]
+    fn held_tables_and_approval_are_optional_in_the_file() {
+        let offset = Offset::new(None, "mysql-bin.000001".into(), 4, String::new(), true);
+        let json = serde_json::to_value(&offset).unwrap();
+        assert!(json.get("held_tables").is_none());
+        assert!(json.get("resnapshot_approved").is_none());
+
+        let held = offset.with_held(vec![("shop".into(), "orders".into())]);
+        let json = serde_json::to_value(&held).unwrap();
+        assert_eq!(json["held_tables"], serde_json::json!([["shop", "orders"]]));
+
+        let approved: Offset = serde_json::from_str(
+            r#"{"file":"mysql-bin.000001","pos":4,"resnapshot_approved":true}"#,
+        )
+        .unwrap();
+        assert!(approved.resnapshot_approved);
+        assert!(approved.held_tables.is_empty());
+    }
+
+    #[test]
+    fn offset_from_a_published_offset_without_checkpoint() {
+        let payload: Map<String, Json> = serde_json::from_value(serde_json::json!({
+            "connector": "shop",
+            "seq": "00000000000000005020.0000013236",
+            "change_seq": 5020,
+            "gtid_set": format!("{U1}:1-27"),
+            "file": "mysql-bin.000003",
+            "pos": 4,
+            "snapshot_in_progress": false,
+        }))
+        .unwrap();
+        let offset =
+            Offset::from_published(&payload, vec![("shop".into(), "orders".into())]).unwrap();
+        assert_eq!((offset.next_seq, offset.seq_sub), (5021, 13236));
+        assert_eq!((offset.file.as_str(), offset.pos), ("mysql-bin.000003", 4));
+        assert_eq!(offset.gtid_set, format!("{U1}:1-27"));
+        assert!(offset.snapshot_completed);
+        assert_eq!(
+            offset.snapshotted_tables,
+            Some(vec![("shop".into(), "orders".into())])
+        );
+
+        let mut broken = payload;
+        broken.remove("change_seq");
+        assert!(Offset::from_published(&broken, Vec::new()).is_err());
+    }
+
+    #[test]
+    fn gtid_set_tagged() {
+        let set: GtidSet = format!("{U1}:1-3:tag_a:1-2").parse().unwrap();
+        assert_eq!(set.to_string(), format!("{U1}:1-3,{U1}:tag_a:1-2"));
+    }
+
+    #[test]
+    fn gtid_set_empty() {
+        let set: GtidSet = "".parse().unwrap();
+        assert!(set.is_empty());
+        assert_eq!(set.to_string(), "");
+        assert!(set.to_sids().unwrap().is_empty());
+    }
+
+    #[test]
+    fn gtid_set_rejects_garbage() {
+        assert!("nope:1-2".parse::<GtidSet>().is_err());
+        assert!(format!("{U1}:5-2").parse::<GtidSet>().is_err());
+        assert!(format!("{U1}:0").parse::<GtidSet>().is_err());
+    }
+
+    #[test]
+    fn gtid_set_to_sids() {
+        let set: GtidSet = format!("{U1}:1-5:7").parse().unwrap();
+        let sids = set.to_sids().unwrap();
+        assert_eq!(sids.len(), 1);
+        assert_eq!(sids[0].intervals().len(), 2);
+    }
+
+    #[tokio::test]
+    async fn checkpoint_store_roundtrip() {
+        let dir = tempfile::tempdir().unwrap();
+        let store = CheckpointStore::<Offset>::new(dir.path());
+        assert_eq!(store.load().await.unwrap(), None);
+
+        let offset = Offset::new(
+            Some("abc".into()),
+            "binlog.000002".into(),
+            1234,
+            format!("{U1}:1-9"),
+            true,
+        );
+        store.store(&offset).await.unwrap();
+        assert_eq!(store.load().await.unwrap(), Some(offset.clone()));
+
+        let next = Offset {
+            pos: 5678,
+            ..offset
+        };
+        store.store(&next).await.unwrap();
+        assert_eq!(store.load().await.unwrap(), Some(next));
+    }
+}
diff --git a/src/sources/mysql_cdc/schema.rs b/src/sources/mysql_cdc/schema.rs
new file mode 100644
index 0000000..93a4d26
--- /dev/null
+++ b/src/sources/mysql_cdc/schema.rs
@@ -0,0 +1,482 @@
+//! Column descriptions used to convert MySQL values into Debezium's representation.
+//!
+//! Descriptions come from two places:
+//!
+//! * binlog `TABLE_MAP` events, which with `binlog_row_metadata=FULL` carry column names,
+//!   real types, type metadata (fractional-second precision, `BIT` length, …), and the string
+//!   values of `ENUM` / `SET` columns *as of the moment the row was written*. Because every row
+//!   event is self-describing, no separate schema-history store is needed to decode old events
+//!   correctly after an `ALTER TABLE`;
+//! * result-set metadata of the snapshot `SELECT`s.
+
+use std::{collections::HashMap, io, sync::Arc};
+
+use serde_json::{Map, Value as Json};
+
+use mysql_async::{
+    Column,
+    binlog::events::{OptionalMetaExtractor, OptionalMetadataField, TableMapEvent},
+    consts::{ColumnFlags, ColumnType},
+};
+
+use super::{
+    convert::{ConvertOptions, decode_text},
+    filter::Filters,
+    table_schema,
+};
+
+/// MySQL's `binary` character set; columns using it hold raw bytes.
+pub const BINARY_CHARSET: u16 = 63;
+
+/// MySQL's `utf8mb4_0900_ai_ci` collation id.
+pub const UTF8MB4_CHARSET: u16 = 255;
+
+/// Normalized column kind.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ColKind {
+    TinyInt,
+    SmallInt,
+    MediumInt,
+    Int,
+    BigInt,
+    Float,
+    Double,
+    Decimal,
+    Date,
+    Time,
+    DateTime,
+    Timestamp,
+    Year,
+    Bit,
+    /// `CHAR`, `VARCHAR`, `TEXT`, `BINARY`, `VARBINARY`, `BLOB` (binary-ness from the charset).
+    String,
+    Enum,
+    Set,
+    Json,
+    Geometry,
+    Vector,
+    Unknown,
+}
+
+impl ColKind {
+    pub fn from_column_type(column_type: ColumnType) -> Self {
+        use ColumnType::*;
+        match column_type {
+            MYSQL_TYPE_TINY => Self::TinyInt,
+            MYSQL_TYPE_SHORT => Self::SmallInt,
+            MYSQL_TYPE_INT24 => Self::MediumInt,
+            MYSQL_TYPE_LONG => Self::Int,
+            MYSQL_TYPE_LONGLONG => Self::BigInt,
+            MYSQL_TYPE_FLOAT => Self::Float,
+            MYSQL_TYPE_DOUBLE => Self::Double,
+            MYSQL_TYPE_DECIMAL | MYSQL_TYPE_NEWDECIMAL => Self::Decimal,
+            MYSQL_TYPE_DATE | MYSQL_TYPE_NEWDATE => Self::Date,
+            MYSQL_TYPE_TIME | MYSQL_TYPE_TIME2 => Self::Time,
+            MYSQL_TYPE_DATETIME | MYSQL_TYPE_DATETIME2 => Self::DateTime,
+            MYSQL_TYPE_TIMESTAMP | MYSQL_TYPE_TIMESTAMP2 => Self::Timestamp,
+            MYSQL_TYPE_YEAR => Self::Year,
+            MYSQL_TYPE_BIT => Self::Bit,
+            MYSQL_TYPE_VARCHAR
+            | MYSQL_TYPE_VAR_STRING
+            | MYSQL_TYPE_STRING
+            | MYSQL_TYPE_BLOB
+            | MYSQL_TYPE_TINY_BLOB
+            | MYSQL_TYPE_MEDIUM_BLOB
+            | MYSQL_TYPE_LONG_BLOB => Self::String,
+            MYSQL_TYPE_ENUM => Self::Enum,
+            MYSQL_TYPE_SET => Self::Set,
+            MYSQL_TYPE_JSON => Self::Json,
+            MYSQL_TYPE_GEOMETRY => Self::Geometry,
+            MYSQL_TYPE_VECTOR => Self::Vector,
+            _ => Self::Unknown,
+        }
+    }
+}
+
+/// Everything needed to convert one column's values.
+#[derive(Clone, Debug)]
+pub struct ColumnDesc {
+    pub name: String,
+    /// 1-based ordinal position in the table.
+    pub position: u32,
+    pub kind: ColKind,
+    /// Normalized MySQL type name (`int`, `varchar`, `text`, `blob`, `datetime`, …).
+    pub mysql_type: &'static str,
+    pub nullable: bool,
+    /// Only meaningful for integer, decimal and floating-point columns.
+    pub unsigned: bool,
+    /// `DECIMAL(precision, scale)`.
+    pub precision: Option<u32>,
+    pub scale: Option<u32>,
+    /// Character set id (`63` = binary). Only meaningful for [`ColKind::String`].
+    pub charset: u16,
+    /// Fractional-second precision for temporal types.
+    pub fsp: u8,
+    /// Declared length of `BIT(n)` columns.
+    pub bit_len: u32,
+    /// Allowed values of `ENUM` columns (index 1 is the first value).
+    pub enum_values: Option<Arc<Vec<String>>>,
+    /// Allowed values of `SET` columns (bit 0 is the first value).
+    pub set_values: Option<Arc<Vec<String>>>,
+    pub primary_key: bool,
+    /// Excluded through `column_exclude_list`.
+    pub excluded: bool,
+}
+
+impl ColumnDesc {
+    pub fn is_binary(&self) -> bool {
+        self.charset == BINARY_CHARSET
+    }
+
+    /// Whether `unsigned` is a meaningful attribute of this column's type.
+    pub fn reports_unsigned(&self) -> bool {
+        matches!(
+            self.kind,
+            ColKind::TinyInt
+                | ColKind::SmallInt
+                | ColKind::MediumInt
+                | ColKind::Int
+                | ColKind::BigInt
+                | ColKind::Decimal
+                | ColKind::Float
+                | ColKind::Double
+        )
+    }
+}
+
+/// A captured table as described by the most recent `TABLE_MAP` event (or snapshot result set).
+#[derive(Debug)]
+pub struct TableInfo {
+    pub database: String,
+    pub table: String,
+    pub columns: Vec<ColumnDesc>,
+    index_by_name: HashMap<String, usize>,
+    /// The raw table map, needed to decode row images (`None` for snapshot tables).
+    pub table_map: Option<TableMapEvent<'static>>,
+    /// The hashed part of this table's schema document.
+    pub schema_core: Arc<Map<String, Json>>,
+    /// Identifier of this table definition; see [`table_schema`].
+    pub schema_version: String,
+}
+
+impl TableInfo {
+    pub fn column_index(&self, name: &str) -> Option<usize> {
+        self.index_by_name.get(name).copied()
+    }
+
+    pub fn has_primary_key(&self) -> bool {
+        self.columns.iter().any(|c| c.primary_key)
+    }
+
+    fn new(
+        database: String,
+        table: String,
+        columns: Vec<ColumnDesc>,
+        table_map: Option<TableMapEvent<'static>>,
+        convert: &ConvertOptions,
+    ) -> Self {
+        let index_by_name = columns
+            .iter()
+            .enumerate()
+            .map(|(i, c)| (c.name.clone(), i))
+            .collect();
+        let schema_core = table_schema::core(&database, &table, &columns, convert);
+        let schema_version = table_schema::version(&schema_core);
+        Self {
+            database,
+            table,
+            columns,
+            index_by_name,
+            table_map,
+            schema_core: Arc::new(schema_core),
+            schema_version,
+        }
+    }
+
+    /// Builds the description from a binlog `TABLE_MAP` event.
+    ///
+    /// Fails if the event lacks column names, i.e. the server is not running with
+    /// `binlog_row_metadata=FULL`.
+    pub fn from_table_map(
+        tme: TableMapEvent<'static>,
+        filters: &Filters,
+        convert: &ConvertOptions,
+    ) -> io::Result<Self> {
+        let database = tme.database_name().into_owned();
+        let table = tme.table_name().into_owned();
+        let num_columns = tme.columns_count() as usize;
+
+        let mut names: Vec<String> = Vec::new();
+        let mut enum_lists: Vec<Vec<Vec<u8>>> = Vec::new();
+        let mut set_lists: Vec<Vec<Vec<u8>>> = Vec::new();
+        let mut primary_key: Vec<usize> = Vec::new();
+
+        for field in tme.iter_optional_meta() {
+            match field? {
+                OptionalMetadataField::ColumnName(column_names) => {
+                    for name in column_names.iter_names() {
+                        names.push(name?.name().into_owned());
+                    }
+                }
+                OptionalMetadataField::EnumStrValue(values) => {
+                    for column in values.iter_values() {
+                        let column = column?;
+                        enum_lists.push(
+                            column
+                                .values()
+                                .iter()
+                                .map(|v| v.value_raw().to_vec())
+                                .collect(),
+                        );
+                    }
+                }
+                OptionalMetadataField::SetStrValue(values) => {
+                    for column in values.iter_values() {
+                        let column = column?;
+                        set_lists.push(
+                            column
+                                .values()
+                                .iter()
+                                .map(|v| v.value_raw().to_vec())
+                                .collect(),
+                        );
+                    }
+                }
+                OptionalMetadataField::SimplePrimaryKey(keys) => {
+                    for key in keys.iter_indexes() {
+                        primary_key.push(key? as usize);
+                    }
+                }
+                OptionalMetadataField::PrimaryKeyWithPrefix(keys) => {
+                    for key in keys.iter_keys() {
+                        primary_key.push(key?.column_index() as usize);
+                    }
+                }
+                _ => {}
+            }
+        }
+
+        if names.len() != num_columns {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                format!(
+                    "table map for `{database}`.`{table}` has no column names; the server must run \
+                     with `binlog_row_metadata=FULL`"
+                ),
+            ));
+        }
+
+        let columns = {
+            // Charsets cover character and ENUM/SET columns, each in column order — the same walk mysql_common does when decoding rows.
+            let extractor = OptionalMetaExtractor::new(tme.iter_optional_meta())?;
+            let mut charsets = extractor.iter_charset();
+            let mut signedness = extractor.iter_signedness();
+            let nullable_bits = tme.null_bitmask();
+            let mut enum_set_charsets = extractor.iter_enum_and_set_charset();
+            let mut enum_lists = enum_lists.into_iter();
+            let mut set_lists = set_lists.into_iter();
+            let mut columns = Vec::with_capacity(num_columns);
+
+            for (i, name) in names.into_iter().enumerate() {
+                let column_type = tme
+                    .get_column_type(i)
+                    .map_err(|error| io::Error::new(io::ErrorKind::InvalidData, error))?
+                    .ok_or_else(|| {
+                        io::Error::new(io::ErrorKind::InvalidData, "missing column type")
+                    })?;
+                let meta = tme.get_column_metadata(i).unwrap_or(&[]);
+                let kind = ColKind::from_column_type(column_type);
+
+                let (fsp, bit_len) = match column_type {
+                    ColumnType::MYSQL_TYPE_TIME2
+                    | ColumnType::MYSQL_TYPE_DATETIME2
+                    | ColumnType::MYSQL_TYPE_TIMESTAMP2 => (meta.first().copied().unwrap_or(0), 0),
+                    ColumnType::MYSQL_TYPE_BIT => {
+                        let bits = u32::from(meta.first().copied().unwrap_or(0));
+                        let bytes = u32::from(meta.get(1).copied().unwrap_or(0));
+                        (0, bytes * 8 + bits)
+                    }
+                    _ => (0, 0),
+                };
+                let charset = if column_type.is_character_type() {
+                    charsets.next().transpose()?.unwrap_or_default()
+                } else if column_type.is_enum_or_set_type() {
+                    enum_set_charsets.next().transpose()?.unwrap_or_default()
+                } else {
+                    0
+                };
+
+                let decode_values = |raw: Vec<Vec<u8>>| -> Arc<Vec<String>> {
+                    Arc::new(raw.iter().map(|v| decode_text(v, charset)).collect())
+                };
+                let enum_values = (kind == ColKind::Enum)
+                    .then(|| enum_lists.next().map(decode_values))
+                    .flatten();
+                let set_values = (kind == ColKind::Set)
+                    .then(|| set_lists.next().map(decode_values))
+                    .flatten();
+
+                // Signedness is listed for every numeric column, in order.
+                let unsigned = column_type.is_numeric_type() && signedness.next().unwrap_or(false);
+                let nullable = nullable_bits.get(i).as_deref().copied().unwrap_or(true);
+                let (precision, scale) = if kind == ColKind::Decimal {
+                    (
+                        meta.first().map(|p| u32::from(*p)),
+                        meta.get(1).map(|s| u32::from(*s)),
+                    )
+                } else {
+                    (None, None)
+                };
+                let binary = charset == BINARY_CHARSET;
+
+                columns.push(ColumnDesc {
+                    excluded: filters.column_excluded(&database, &table, &name),
+                    name,
+                    position: i as u32 + 1,
+                    kind,
+                    mysql_type: table_schema::mysql_type_from_binlog(kind, column_type, binary),
+                    nullable,
+                    unsigned,
+                    precision,
+                    scale,
+                    charset,
+                    fsp,
+                    bit_len,
+                    enum_values,
+                    set_values,
+                    primary_key: primary_key.contains(&i),
+                });
+            }
+            columns
+        };
+
+        let mut columns = columns;
+        apply_key_columns(&mut columns, filters, &database, &table);
+        Ok(Self::new(database, table, columns, Some(tme), convert))
+    }
+
+    /// Builds the description from snapshot result-set metadata, enriched with
+    /// `information_schema` details (enum/set values, primary key, bit length).
+    pub fn from_result_columns(
+        database: &str,
+        table: &str,
+        result_columns: &[Column],
+        details: &HashMap<String, ColumnDetails>,
+        filters: &Filters,
+        convert: &ConvertOptions,
+    ) -> Self {
+        let columns = result_columns
+            .iter()
+            .enumerate()
+            .map(|(index, column)| {
+                let name = column.name_str().into_owned();
+                let detail = details.get(&name);
+                let flags = column.flags();
+                let mut kind = ColKind::from_column_type(column.column_type());
+                // The binary protocol reports ENUM and SET as strings with a flag.
+                if flags.contains(ColumnFlags::ENUM_FLAG) {
+                    kind = ColKind::Enum;
+                } else if flags.contains(ColumnFlags::SET_FLAG) {
+                    kind = ColKind::Set;
+                }
+                let mysql_type = detail.map_or("unknown", |d| {
+                    table_schema::mysql_type_from_information_schema(&d.data_type)
+                });
+                ColumnDesc {
+                    excluded: filters.column_excluded(database, table, &name),
+                    position: detail.map_or(index as u32 + 1, |d| d.position),
+                    kind,
+                    mysql_type,
+                    nullable: detail.is_none_or(|d| d.nullable),
+                    unsigned: detail
+                        .map_or(flags.contains(ColumnFlags::UNSIGNED_FLAG), |d| d.unsigned),
+                    precision: detail.and_then(|d| d.precision),
+                    scale: detail.and_then(|d| d.scale),
+                    // The snapshot session uses `SET NAMES utf8mb4`, so the server has already
+                    // converted every text value to UTF-8; only binary columns keep raw bytes.
+                    charset: if column.character_set() == BINARY_CHARSET {
+                        BINARY_CHARSET
+                    } else {
+                        UTF8MB4_CHARSET
+                    },
+                    fsp: detail.map_or_else(|| column.decimals(), |d| d.fsp),
+                    bit_len: detail.map_or(column.column_length(), |d| d.bit_len),
+                    enum_values: (kind == ColKind::Enum)
+                        .then(|| detail.and_then(|d| d.values.clone()))
+                        .flatten(),
+                    set_values: (kind == ColKind::Set)
+                        .then(|| detail.and_then(|d| d.values.clone()))
+                        .flatten(),
+                    primary_key: detail.is_some_and(|d| d.primary_key)
+                        || flags.contains(ColumnFlags::PRI_KEY_FLAG),
+                    name,
+                }
+            })
+            .collect::<Vec<_>>();
+        let mut columns = columns;
+        apply_key_columns(&mut columns, filters, database, table);
+        Self::new(
+            database.to_owned(),
+            table.to_owned(),
+            columns,
+            None,
+            convert,
+        )
+    }
+}
+
+/// Replaces the primary key with the configured `pk_override`, if any.
+fn apply_key_columns(columns: &mut [ColumnDesc], filters: &Filters, database: &str, table: &str) {
+    if let Some(keys) = filters.key_columns(database, table) {
+        for column in columns {
+            column.primary_key = keys.iter().any(|k| k == &column.name);
+        }
+    }
+}
+
+/// Per-column details read from `information_schema.COLUMNS` during the snapshot.
+#[derive(Clone, Debug, Default)]
+pub struct ColumnDetails {
+    pub position: u32,
+    /// `DATA_TYPE`, e.g. `varchar`.
+    pub data_type: String,
+    pub nullable: bool,
+    pub unsigned: bool,
+    pub precision: Option<u32>,
+    pub scale: Option<u32>,
+    pub fsp: u8,
+    pub bit_len: u32,
+    pub primary_key: bool,
+    /// ENUM / SET values parsed from `COLUMN_TYPE`.
+    pub values: Option<Arc<Vec<String>>>,
+}
+
+/// Parses `bit(N)` from `information_schema.COLUMNS.COLUMN_TYPE`.
+pub fn parse_bit_len(column_type: &str) -> Option<u32> {
+    let rest = column_type.trim().strip_prefix("bit(")?;
+    rest.split(')').next()?.trim().parse().ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn bit_len_parsing() {
+        assert_eq!(parse_bit_len("bit(1)"), Some(1));
+        assert_eq!(parse_bit_len("bit(64)"), Some(64));
+        assert_eq!(parse_bit_len("int(11)"), None);
+    }
+
+    #[test]
+    fn kind_mapping() {
+        assert_eq!(
+            ColKind::from_column_type(ColumnType::MYSQL_TYPE_DATETIME2),
+            ColKind::DateTime
+        );
+        assert_eq!(
+            ColKind::from_column_type(ColumnType::MYSQL_TYPE_BLOB),
+            ColKind::String
+        );
+    }
+}
diff --git a/src/sources/mysql_cdc/snapshot.rs b/src/sources/mysql_cdc/snapshot.rs
new file mode 100644
index 0000000..976b485
--- /dev/null
+++ b/src/sources/mysql_cdc/snapshot.rs
@@ -0,0 +1,854 @@
+//! Consistent initial snapshot, modeled on Debezium's MySQL snapshot with
+//! `snapshot.locking.mode=minimal`, optionally read by several connections in parallel:
+//!
+//! 1. `FLUSH TABLES WITH READ LOCK` (blocks writes for a moment);
+//! 2. on each of the `snapshot_max_threads` connections, `START TRANSACTION WITH CONSISTENT
+//!    SNAPSHOT` at `REPEATABLE READ` — all started while writes are blocked, so they all see the
+//!    database at the same instant;
+//! 3. read the binlog position / executed GTID set and the list of tables;
+//! 4. `UNLOCK TABLES` — writes resume, but the transactions keep seeing the data exactly as of
+//!    the recorded binlog position;
+//! 5. split the work into units — whole tables, or primary-key ranges of about
+//!    `snapshot_chunk_size` rows for tables with a single-column integer primary key — and read
+//!    them on the worker connections, emitting `op: "r"` events;
+//! 6. commit, and stream the binlog from the recorded position.
+//!
+//! The snapshot's offset is only stored once every snapshot event has been delivered. If the
+//! source stops before that, the snapshot is taken again on the next start.
+
+use std::{
+    collections::{HashMap, VecDeque},
+    sync::{Arc, Mutex},
+};
+
+use crate::event::LogEvent;
+use chrono::Utc;
+use mysql_async::{Conn, Row, prelude::Queryable};
+use serde_json::{Map, Value as Json};
+use tokio::sync::mpsc;
+
+use super::{
+    SnapshotLockingMode,
+    convert::{ConvertOptions, Origin, convert_value},
+    envelope::{Op, SnapshotMarker, SourceInfo},
+    filter::Filters,
+    offset::Offset,
+    schema::{ColumnDetails, TableInfo, parse_bit_len},
+    source::{
+        BinlogPosition, CONNECTOR_VERSION, Emitter, EventBuilder, EventMeta, NoteTableSchema,
+        ServerInfo, Settings, connect, current_position, snapshot_completed,
+    },
+    table_schema::{self, Observed},
+};
+use crate::shutdown::ShutdownSignal;
+
+/// Log progress every this many rows.
+const PROGRESS_INTERVAL: u64 = 1_000_000;
+
+/// Rows a worker sends to the emitter in one message.
+const ROWS_PER_MESSAGE: usize = 512;
+
+/// Upper bound on the number of chunks a single table is split into.
+const MAX_CHUNKS_PER_TABLE: u64 = 100_000;
+
+/// Integer types whose primary key can be split into ranges.
+const CHUNKABLE_TYPES: &[&str] = &[
+    "tinyint",
+    "smallint",
+    "mediumint",
+    "int",
+    "integer",
+    "bigint",
+];
+
+/// Quotes a MySQL identifier.
+pub fn quote_ident(ident: &str) -> String {
+    format!("`{}`", ident.replace('`', "``"))
+}
+
+type Image = Map<String, Json>;
+
+/// A table to snapshot.
+struct TablePlan {
+    database: String,
+    table: String,
+    details: Arc<HashMap<String, ColumnDetails>>,
+    /// The single-column integer primary key, if the table can be chunked.
+    chunk_key: Option<String>,
+}
+
+/// One query's worth of work.
+#[derive(Clone, Debug)]
+struct Unit {
+    table: usize,
+    /// `[start, end)` primary-key range; `end: None` means unbounded.
+    range: Option<(i64, Option<i64>)>,
+}
+
+enum Message {
+    /// A worker started reading a unit of `table`.
+    Started {
+        table: usize,
+        info: Arc<TableInfo>,
+    },
+    /// Fully built `op: "r"` events (marker `true`; first/last markers are set by the emitter).
+    Rows {
+        table: usize,
+        events: Vec<LogEvent>,
+    },
+    /// A row could not be converted.
+    BadRow {
+        table: usize,
+        error: String,
+    },
+    UnitDone {
+        table: usize,
+    },
+    Failed(String),
+}
+
+/// Splits `[min, max]` into about `rows / chunk_size` ranges. The last range is unbounded.
+fn plan_chunks(
+    min: i64,
+    max: i64,
+    estimated_rows: u64,
+    chunk_size: u64,
+) -> Vec<(i64, Option<i64>)> {
+    let span = (i128::from(max) - i128::from(min) + 1).max(1) as u128;
+    let rows = if estimated_rows == 0 {
+        span as u64
+    } else {
+        estimated_rows
+    };
+    let chunks = rows
+        .div_ceil(chunk_size.max(1))
+        .clamp(1, MAX_CHUNKS_PER_TABLE);
+    if chunks <= 1 {
+        return vec![(min, None)];
+    }
+    let width = span.div_ceil(u128::from(chunks)).max(1);
+    let mut ranges = Vec::with_capacity(chunks as usize);
+    let mut start = i128::from(min);
+    loop {
+        let end = start + width as i128;
+        if end > i128::from(max) {
+            ranges.push((start as i64, None));
+            break;
+        }
+        ranges.push((start as i64, Some(end as i64)));
+        start = end;
+    }
+    ranges
+}
+
+/// Opens a connection configured for snapshot reads.
+pub(super) async fn snapshot_connection(settings: &Settings) -> Result<Conn, String> {
+    let mut conn = connect(settings).await?;
+    // UTF-8 results; UTC so TIMESTAMP values need no conversion; long timeouts because reading
+    // may pause for a long time while the pipeline applies backpressure.
+    for statement in [
+        "SET NAMES utf8mb4",
+        "SET SESSION time_zone = '+00:00', SESSION net_write_timeout = 3600, \
+         SESSION net_read_timeout = 3600, SESSION wait_timeout = 86400",
+        "SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ",
+    ] {
+        conn.query_drop(statement)
+            .await
+            .map_err(|error| format!("snapshot: configuring session: {error}"))?;
+    }
+    Ok(conn)
+}
+
+/// Runs the snapshot. Returns the offset to stream from, or `None` if shut down part-way.
+pub(super) async fn run(
+    settings: &Settings,
+    server: &ServerInfo,
+    emitter: &mut Emitter,
+    mut shutdown: ShutdownSignal,
+) -> Result<Option<Offset>, String> {
+    let threads = settings.snapshot_threads.max(1);
+    let mut conns = Vec::with_capacity(threads);
+    for _ in 0..threads {
+        conns.push(snapshot_connection(settings).await?);
+    }
+
+    let locked = match settings.locking_mode {
+        SnapshotLockingMode::Minimal => {
+            info!(message = "Snapshot: acquiring global read lock.");
+            conns[0]
+                .query_drop("FLUSH TABLES WITH READ LOCK")
+                .await
+                .map_err(|error| {
+                    format!(
+                        "snapshot: `FLUSH TABLES WITH READ LOCK` failed ({error}). Grant the RELOAD \
+                         privilege, or set `snapshot_locking_mode: none` if writes can be paused \
+                         while the snapshot starts"
+                    )
+                })?;
+            true
+        }
+        SnapshotLockingMode::None => {
+            if threads > 1 {
+                warn!(
+                    message = "`snapshot_locking_mode: none` with several snapshot threads: the \
+                               threads' views are only identical if no writes happen while the \
+                               snapshot starts."
+                );
+            }
+            false
+        }
+    };
+
+    let prepared = prepare(&mut conns, settings, locked).await;
+    if locked {
+        // Releases the global read lock without ending the consistent-snapshot transactions.
+        conns[0]
+            .query_drop("UNLOCK TABLES")
+            .await
+            .map_err(|error| format!("snapshot: releasing global read lock: {error}"))?;
+        info!(message = "Snapshot: global read lock released.");
+    }
+    let (position, tables) = prepared?;
+
+    // Plan the work inside the snapshot transaction of the first connection.
+    let mut plans = Vec::with_capacity(tables.len());
+    let mut units = VecDeque::new();
+    for (database, table) in tables {
+        let details = column_details(&mut conns[0], &database, &table).await?;
+        let pk: Vec<(&String, &ColumnDetails)> =
+            details.iter().filter(|(_, d)| d.primary_key).collect();
+        let chunk_key = (settings.snapshot_chunk_size > 0
+            && pk.len() == 1
+            && CHUNKABLE_TYPES.contains(&pk[0].1.data_type.to_ascii_lowercase().as_str()))
+        .then(|| pk[0].0.clone());
+
+        let index = plans.len();
+        let ranges = match &chunk_key {
+            Some(key) => {
+                chunk_ranges(
+                    &mut conns[0],
+                    &database,
+                    &table,
+                    key,
+                    settings.snapshot_chunk_size,
+                )
+                .await?
+            }
+            None => None,
+        };
+        match ranges {
+            Some(ranges) => units.extend(ranges.into_iter().map(|range| Unit {
+                table: index,
+                range: Some(range),
+            })),
+            None => units.push_back(Unit {
+                table: index,
+                range: None,
+            }),
+        }
+        plans.push(TablePlan {
+            database,
+            table,
+            details: Arc::new(details),
+            chunk_key,
+        });
+    }
+
+    // Identifies this snapshot's rows, so consumers can tell which keys a snapshot contained.
+    let started = Utc::now();
+    let started_ms = started.timestamp_millis();
+    // Every event of this snapshot, and every change streamed after it, gets a seq from here on.
+    let started_seq = emitter.next_seq();
+    let snapshot_id: Arc<str> = Arc::from(started.format("%Y%m%dT%H%M%S%.6fZ").to_string());
+    info!(
+        message = "Snapshot started.",
+        snapshot_id = %snapshot_id,
+        tables = plans.len(),
+        units = units.len(),
+        threads,
+        binlog_file = %position.file,
+        binlog_pos = position.pos,
+        gtid_set = %position.gtid_set,
+    );
+    if plans.is_empty() {
+        warn!(message = "Snapshot: no tables match the configured filters.");
+    }
+
+    let mut units_left: Vec<usize> = vec![0; plans.len()];
+    for unit in &units {
+        units_left[unit.table] += 1;
+    }
+    let total_units = units.len();
+    let plans = Arc::new(plans);
+    let queue = Arc::new(Mutex::new(units));
+    let (tx, mut rx) = mpsc::channel::<Message>(threads * 4);
+
+    for conn in conns {
+        let worker = Worker {
+            conn,
+            plans: Arc::clone(&plans),
+            queue: Arc::clone(&queue),
+            tx: tx.clone(),
+            filters: settings.filters.clone(),
+            convert: settings.convert,
+            builder: emitter.builder(),
+            server_name: settings.topic_prefix.clone(),
+            file: position.file.clone(),
+            pos: position.pos,
+            snapshot_id: Arc::clone(&snapshot_id),
+        };
+        crate::spawn_in_current_span(worker.run());
+    }
+    drop(tx);
+
+    // Emit rows as they arrive. One row per table is held back so the first and last rows of
+    // each table (and of the whole snapshot) can be marked like Debezium does.
+    let streaming_batch_size = emitter.set_batch_size(settings.snapshot_batch_size);
+    let builder = emitter.builder();
+    let mut held: Vec<Option<LogEvent>> = (0..plans.len()).map(|_| None).collect();
+    let mut seen = vec![false; plans.len()];
+    let mut schema_noted = vec![false; plans.len()];
+    let mut versions: Vec<Option<String>> = vec![None; plans.len()];
+    let mut table_rows: Vec<u64> = vec![0; plans.len()];
+    let mut first_overall = true;
+    let mut tables_left = units_left.iter().filter(|n| **n > 0).count();
+    let mut units_done = 0;
+    let mut total_rows: u64 = 0;
+    let observed = Observed {
+        origin: "snapshot",
+        file: &position.file,
+        pos: position.pos,
+        gtid: None,
+    };
+
+    loop {
+        let message = tokio::select! {
+            biased;
+            _ = &mut shutdown => {
+                info!(message = "Snapshot interrupted by shutdown; it will restart on the next start.");
+                return Ok(None);
+            }
+            message = rx.recv() => message,
+        };
+        let Some(message) = message else { break };
+        match message {
+            Message::Started { table, info } => {
+                if !schema_noted[table] {
+                    schema_noted[table] = true;
+                    versions[table] = Some(info.schema_version.clone());
+                    settings.warn_if_keyless(&info);
+                    emitter.note_table_schema(&info, &settings.topic_prefix, &observed);
+                }
+            }
+            Message::Rows { table, events } => {
+                table_rows[table] += events.len() as u64;
+                for mut event in events {
+                    if first_overall {
+                        builder.set_snapshot_marker(&mut event, SnapshotMarker::First);
+                    } else if !seen[table] {
+                        builder
+                            .set_snapshot_marker(&mut event, SnapshotMarker::FirstInDataCollection);
+                    }
+                    first_overall = false;
+                    seen[table] = true;
+                    if let Some(previous) = held[table].replace(event) {
+                        emitter.push_snapshot_row(previous);
+                    }
+                    total_rows += 1;
+                    if total_rows % PROGRESS_INTERVAL == 0 {
+                        info!(
+                            message = "Snapshot progress.",
+                            rows = total_rows,
+                            units_done,
+                            units = total_units,
+                        );
+                    }
+                }
+                emitter.maybe_flush().await?;
+                emitter.check_health()?;
+            }
+            Message::BadRow { table, error } => {
+                let plan = &plans[table];
+                settings.handle_failure(error, &plan.database, &plan.table)?;
+            }
+            Message::UnitDone { table } => {
+                units_done += 1;
+                units_left[table] -= 1;
+                if units_left[table] == 0 {
+                    tables_left -= 1;
+                    if let Some(mut event) = held[table].take() {
+                        let marker = if tables_left == 0 {
+                            SnapshotMarker::Last
+                        } else {
+                            SnapshotMarker::LastInDataCollection
+                        };
+                        builder.set_snapshot_marker(&mut event, marker);
+                        emitter.push_snapshot_row(event);
+                    }
+                    if settings.snapshot_end_markers {
+                        let plan = &plans[table];
+                        emitter.push_control(
+                            snapshot_completed(
+                                &settings.topic_prefix,
+                                &plan.database,
+                                &plan.table,
+                                &snapshot_id,
+                                started_seq,
+                                started_ms,
+                                table_rows[table],
+                                versions[table].as_deref(),
+                            ),
+                            EventMeta {
+                                key: None,
+                                database: &plan.database,
+                                table: Some(&plan.table),
+                                op: "snapshot_completed",
+                                timestamp: Utc::now(),
+                                schema_version: versions[table].as_deref(),
+                            },
+                            true,
+                        );
+                    }
+                    emitter.maybe_flush().await?;
+                    debug!(
+                        message = "Snapshot: table done.",
+                        table = %format!("{}.{}", plans[table].database, plans[table].table),
+                    );
+                }
+            }
+            Message::Failed(error) => return Err(error),
+        }
+    }
+
+    if units_done != total_units {
+        return Err(format!(
+            "snapshot: workers stopped after {units_done} of {total_units} units"
+        ));
+    }
+
+    let offset = Offset::new(
+        Some(server.server_uuid.clone()),
+        position.file,
+        position.pos,
+        position.gtid_set,
+        true,
+    )
+    .with_tables(
+        Some(
+            plans
+                .iter()
+                .map(|p| (p.database.clone(), p.table.clone()))
+                .collect(),
+        ),
+        None,
+    );
+    emitter.commit(offset.clone());
+    emitter.flush().await?;
+    emitter.set_batch_size(streaming_batch_size);
+    info!(message = "Snapshot completed.", snapshot_id = %snapshot_id, rows = total_rows, offset = %offset);
+    Ok(Some(offset))
+}
+
+/// Starts the consistent-snapshot transactions and reads position and table list.
+///
+/// With the global read lock held, no writes happen in between, so the order does not matter.
+/// Without it (`snapshot_locking_mode: none`), the position is read *before* the transactions
+/// start: a write that lands in between is then both in the snapshot and streamed again
+/// (a harmless duplicate) instead of being in neither (a lost change).
+async fn prepare(
+    conns: &mut [Conn],
+    settings: &Settings,
+    locked: bool,
+) -> Result<(BinlogPosition, Vec<(String, String)>), String> {
+    let early_position = if locked {
+        None
+    } else {
+        Some(current_position(&mut conns[0]).await?)
+    };
+    for conn in conns.iter_mut() {
+        conn.query_drop("START TRANSACTION WITH CONSISTENT SNAPSHOT")
+            .await
+            .map_err(|error| format!("snapshot: starting transaction: {error}"))?;
+    }
+    let conn = &mut conns[0];
+    let position = match early_position {
+        Some(position) => position,
+        None => current_position(conn).await?,
+    };
+
+    let all: Vec<(String, String)> = conn
+        .query(
+            "SELECT TABLE_SCHEMA, TABLE_NAME FROM information_schema.TABLES \
+             WHERE TABLE_TYPE = 'BASE TABLE' ORDER BY TABLE_SCHEMA, TABLE_NAME",
+        )
+        .await
+        .map_err(|error| format!("snapshot: listing tables: {error}"))?;
+    let tables = all
+        .into_iter()
+        .filter(|(db, table)| settings.filters.table_included(db, table))
+        .collect();
+    Ok((position, tables))
+}
+
+/// Primary-key ranges for a chunkable table, or `None` to read it with a single query.
+async fn chunk_ranges(
+    conn: &mut Conn,
+    database: &str,
+    table: &str,
+    key: &str,
+    chunk_size: u64,
+) -> Result<Option<Vec<(i64, Option<i64>)>>, String> {
+    let bounds: Result<Option<(Option<i64>, Option<i64>)>, _> = conn
+        .query_first(format!(
+            "SELECT MIN({k}), MAX({k}) FROM {}.{}",
+            quote_ident(database),
+            quote_ident(table),
+            k = quote_ident(key),
+        ))
+        .await;
+    let (min, max) = match bounds {
+        Ok(Some((Some(min), Some(max)))) => (min, max),
+        // Empty table, or keys outside the i64 range (BIGINT UNSIGNED): no chunking.
+        Ok(_) | Err(_) => return Ok(None),
+    };
+    let estimated: Option<Option<u64>> = conn
+        .exec_first(
+            "SELECT TABLE_ROWS FROM information_schema.TABLES WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ?",
+            (database, table),
+        )
+        .await
+        .map_err(|error| format!("snapshot: estimating rows of `{database}`.`{table}`: {error}"))?;
+    let ranges = plan_chunks(min, max, estimated.flatten().unwrap_or(0), chunk_size);
+    Ok((ranges.len() > 1).then_some(ranges))
+}
+
+/// Reads units from the shared queue on its own connection until the queue is empty.
+struct Worker {
+    conn: Conn,
+    plans: Arc<Vec<TablePlan>>,
+    queue: Arc<Mutex<VecDeque<Unit>>>,
+    tx: mpsc::Sender<Message>,
+    filters: Filters,
+    convert: ConvertOptions,
+    builder: EventBuilder,
+    server_name: String,
+    file: String,
+    pos: u64,
+    snapshot_id: Arc<str>,
+}
+
+impl Worker {
+    async fn run(mut self) {
+        if let Err(error) = self.work().await {
+            _ = self.tx.send(Message::Failed(error)).await;
+        }
+        _ = self.conn.query_drop("COMMIT").await;
+    }
+
+    async fn work(&mut self) -> Result<(), String> {
+        loop {
+            let unit = self.queue.lock().expect("snapshot queue lock").pop_front();
+            let Some(unit) = unit else { return Ok(()) };
+            let plan = &self.plans[unit.table];
+            // Name every column: `SELECT *` leaves out invisible columns (including generated
+            // invisible primary keys), which the binlog does include.
+            let mut columns: Vec<(&String, &ColumnDetails)> = plan.details.iter().collect();
+            columns.sort_by_key(|(_, detail)| detail.position);
+            let select_list = if columns.is_empty() {
+                "*".to_owned()
+            } else {
+                columns
+                    .iter()
+                    .map(|(name, _)| quote_ident(name))
+                    .collect::<Vec<_>>()
+                    .join(", ")
+            };
+            let mut query = format!(
+                "SELECT {select_list} FROM {}.{}",
+                quote_ident(&plan.database),
+                quote_ident(&plan.table)
+            );
+            if let (Some((start, end)), Some(key)) = (unit.range, &plan.chunk_key) {
+                let key = quote_ident(key);
+                query.push_str(&format!(" WHERE {key} >= {start}"));
+                if let Some(end) = end {
+                    query.push_str(&format!(" AND {key} < {end}"));
+                }
+            }
+            let context = || format!("snapshot: reading `{}`.`{}`", plan.database, plan.table);
+
+            let mut result = self
+                .conn
+                // The binary protocol returns typed values (dates, times) that the converter needs.
+                .exec_iter(query, ())
+                .await
+                .map_err(|error| format!("{}: {error}", context()))?;
+            let columns = result
+                .columns()
+                .ok_or_else(|| format!("{}: no result-set metadata", context()))?;
+            let info = Arc::new(TableInfo::from_result_columns(
+                &plan.database,
+                &plan.table,
+                &columns,
+                &plan.details,
+                &self.filters,
+                &self.convert,
+            ));
+            if self
+                .tx
+                .send(Message::Started {
+                    table: unit.table,
+                    info: Arc::clone(&info),
+                })
+                .await
+                .is_err()
+            {
+                return Ok(()); // the snapshot was stopped
+            }
+
+            let mut rows = Vec::with_capacity(ROWS_PER_MESSAGE);
+            while let Some(row) = result
+                .next()
+                .await
+                .map_err(|error| format!("{}: {error}", context()))?
+            {
+                match convert_row(&info, row, &self.convert) {
+                    Ok((after, key)) => {
+                        let mut event = build_read(
+                            &self.builder,
+                            &self.server_name,
+                            &self.file,
+                            self.pos,
+                            &info,
+                            after,
+                            key,
+                        );
+                        self.builder.set_snapshot_id(&mut event, &self.snapshot_id);
+                        rows.push(event);
+                    }
+                    Err(error) => {
+                        if self
+                            .tx
+                            .send(Message::BadRow {
+                                table: unit.table,
+                                error,
+                            })
+                            .await
+                            .is_err()
+                        {
+                            return Ok(());
+                        }
+                    }
+                }
+                if rows.len() == ROWS_PER_MESSAGE {
+                    let batch = std::mem::replace(&mut rows, Vec::with_capacity(ROWS_PER_MESSAGE));
+                    if self
+                        .tx
+                        .send(Message::Rows {
+                            table: unit.table,
+                            events: batch,
+                        })
+                        .await
+                        .is_err()
+                    {
+                        return Ok(());
+                    }
+                }
+            }
+            drop(result);
+            if !rows.is_empty()
+                && self
+                    .tx
+                    .send(Message::Rows {
+                        table: unit.table,
+                        events: rows,
+                    })
+                    .await
+                    .is_err()
+            {
+                return Ok(());
+            }
+            if self
+                .tx
+                .send(Message::UnitDone { table: unit.table })
+                .await
+                .is_err()
+            {
+                return Ok(());
+            }
+        }
+    }
+}
+
+/// Reads the column facts needed for conversion and schema documents from `information_schema`.
+pub(super) async fn column_details(
+    conn: &mut Conn,
+    database: &str,
+    table: &str,
+) -> Result<HashMap<String, ColumnDetails>, String> {
+    type Row9 = (
+        String,
+        String,
+        String,
+        String,
+        Option<u64>,
+        Option<u64>,
+        Option<u64>,
+        Option<String>,
+        u64,
+    );
+    let rows: Vec<Row9> = conn
+        .exec(
+            "SELECT COLUMN_NAME, COLUMN_TYPE, DATA_TYPE, IS_NULLABLE, NUMERIC_PRECISION, \
+             NUMERIC_SCALE, DATETIME_PRECISION, COLUMN_KEY, ORDINAL_POSITION \
+             FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = ? AND TABLE_NAME = ?",
+            (database, table),
+        )
+        .await
+        .map_err(|error| format!("snapshot: reading columns of `{database}`.`{table}`: {error}"))?;
+    Ok(rows
+        .into_iter()
+        .map(
+            |(name, column_type, data_type, is_nullable, precision, scale, fsp, key, position)| {
+                let column_type_lower = column_type.to_ascii_lowercase();
+                let kind = data_type.to_ascii_lowercase();
+                let details = ColumnDetails {
+                    position: position as u32,
+                    nullable: is_nullable.eq_ignore_ascii_case("YES"),
+                    unsigned: column_type_lower.contains("unsigned"),
+                    precision: (kind == "decimal" || kind == "numeric")
+                        .then(|| precision.map(|p| p as u32))
+                        .flatten(),
+                    scale: (kind == "decimal" || kind == "numeric")
+                        .then(|| scale.map(|s| s as u32))
+                        .flatten(),
+                    fsp: fsp.map_or(0, |p| p.min(6) as u8),
+                    bit_len: parse_bit_len(&column_type_lower).unwrap_or(0),
+                    primary_key: key.as_deref() == Some("PRI"),
+                    values: table_schema::parse_value_list(&column_type).map(Arc::new),
+                    data_type,
+                };
+                (name, details)
+            },
+        )
+        .collect())
+}
+
+/// Converts a snapshot row into the `after` image and the record key.
+pub(super) fn convert_row(
+    info: &TableInfo,
+    row: Row,
+    convert: &ConvertOptions,
+) -> Result<(Image, Option<Image>), String> {
+    let values = row.unwrap();
+    let mut after = Map::with_capacity(values.len());
+    let mut key = Map::new();
+    for (column, value) in info.columns.iter().zip(values.iter()) {
+        if column.excluded {
+            continue;
+        }
+        let json = convert_value(column, value, Origin::Snapshot, convert)
+            .map_err(|error| error.to_string())?;
+        if column.primary_key {
+            key.insert(column.name.clone(), json.clone());
+        }
+        after.insert(column.name.clone(), json);
+    }
+    Ok((after, (!key.is_empty()).then_some(key)))
+}
+
+/// Builds an `op: "r"` event with snapshot marker `true`.
+pub(super) fn build_read(
+    builder: &EventBuilder,
+    server_name: &str,
+    file: &str,
+    pos: u64,
+    info: &TableInfo,
+    after: Image,
+    key: Option<Image>,
+) -> LogEvent {
+    let now = Utc::now();
+    let source = SourceInfo {
+        connector_version: CONNECTOR_VERSION,
+        name: server_name,
+        ts_us: now.timestamp_micros(),
+        snapshot: SnapshotMarker::True,
+        db: &info.database,
+        table: &info.table,
+        server_id: 0,
+        gtid: None,
+        file,
+        pos,
+        row: 0,
+        query: None,
+    };
+    builder.row_change(
+        Op::Read,
+        None,
+        Some(after),
+        &source,
+        EventMeta {
+            key,
+            database: &info.database,
+            table: Some(&info.table),
+            op: Op::Read.code(),
+            timestamp: now,
+            schema_version: Some(&info.schema_version),
+        },
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn chunk_planning() {
+        // Dense keys: about rows / chunk_size ranges, contiguous, last one unbounded.
+        let ranges = plan_chunks(1, 1000, 1000, 250);
+        assert_eq!(
+            ranges,
+            vec![
+                (1, Some(251)),
+                (251, Some(501)),
+                (501, Some(751)),
+                (751, None)
+            ]
+        );
+
+        // Small tables are read with one query.
+        assert_eq!(plan_chunks(1, 100, 100, 250), vec![(1, None)]);
+
+        // Unknown row count falls back to the key span.
+        assert_eq!(plan_chunks(1, 1000, 0, 500).len(), 2);
+
+        // Sparse keys are split by estimated rows, not by span.
+        let sparse = plan_chunks(0, 1_000_000_000_000, 1000, 250);
+        assert_eq!(sparse.len(), 4);
+        assert_eq!(sparse.last().unwrap().1, None);
+
+        // Extreme bounds do not overflow, and the chunk count is capped.
+        let wide = plan_chunks(i64::MIN, i64::MAX, u64::MAX, 1);
+        assert_eq!(wide.len() as u64, MAX_CHUNKS_PER_TABLE);
+        assert_eq!(wide[0].0, i64::MIN);
+
+        // Ranges always cover every key exactly once.
+        let ranges = plan_chunks(-50, 49, 100, 7);
+        let mut covered = 0;
+        for k in -50..=49_i64 {
+            let hits = ranges
+                .iter()
+                .filter(|(s, e)| k >= *s && e.is_none_or(|e| k < e))
+                .count();
+            assert_eq!(hits, 1, "key {k}");
+            covered += 1;
+        }
+        assert_eq!(covered, 100);
+    }
+
+    #[test]
+    fn identifiers_are_quoted() {
+        assert_eq!(quote_ident("orders"), "`orders`");
+        assert_eq!(quote_ident("we`ird"), "`we``ird`");
+    }
+}

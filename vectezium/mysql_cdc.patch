index 0000000..399971b
--- /dev/null
+++ b/contrib/mysql_cdc/vector-e2e.yaml
@@ -0,0 +1,110 @@
+# End-to-end test pipeline used by run-e2e.sh:
+#   MySQL (docker) -> mysql_cdc (debezium format)        -> local file (for assertions)
+#                  -> mysql_cdc (metadata + record format) -> azure_blob (Azurite)
+data_dir: ./out/data
+
+acknowledgements:
+  enabled: true
+
+sources:
+  mysql:
+    type: mysql_cdc
+    hostname: 127.0.0.1
+    port: 3306
+    user: vector_cdc
+    password: cdcpw
+    server_id: 5401
+    topic_prefix: e2e
+    database_include_list: ["inventory"]
+    table_exclude_list: ["inventory\\.audit_log"]
+    column_exclude_list: ["inventory\\.customers\\.ssn"]
+    decimal_handling_mode: string
+    include_schema_changes: true
+    include_query: true
+    ssl_mode: disabled
+    heartbeat_interval_secs: 5
+    # Only one instance may capture with this lock; run-e2e.sh starts a second one to check.
+    single_writer_lock:
+      connection_string: "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
+      container_name: cdc
+      blob_name: e2e/_lock
+      lease_duration_secs: 15
+
+  # A second capture of the same database in the metadata + record format, sent to ADLS.
+  mysql_record:
+    type: mysql_cdc
+    hostname: 127.0.0.1
+    port: 3306
+    user: vector_cdc
+    password: cdcpw
+    server_id: 5402
+    topic_prefix: e2e
+    database_include_list: ["inventory"]
+    table_exclude_list: ["inventory\\.audit_log"]
+    column_exclude_list: ["inventory\\.customers\\.ssn"]
+    decimal_handling_mode: string
+    event_format: record
+    record_images: before_and_after
+    include_table_schemas: true
+    # Exercise the parallel, chunked snapshot path: 3 threads, one row per chunk.
+    snapshot_max_threads: 3
+    snapshot_chunk_size: 1
+    ssl_mode: disabled
+    heartbeat_interval_secs: 5
+
+sinks:
+  adls:
+    type: azure_blob
+    inputs: ["mysql_record"]
+    connection_string: "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
+    container_name: cdc
+    blob_prefix: "mysql/{{ metadata.db }}/{{ metadata.table }}/date=%Y-%m-%d/"
+    blob_append_uuid: true
+    blob_extension: json.gz
+    encoding:
+      codec: json
+      # Vector adds these to every event; keep the blobs to just `metadata` and `record`.
+      except_fields: ["source_type", "timestamp"]
+    framing:
+      method: newline_delimited
+    compression: gzip
+    batch:
+      timeout_secs: 3
+    healthcheck:
+      enabled: false
+
+  raw:
+    type: file
+    inputs: ["mysql"]
+    path: ./out/raw.ndjson
+    encoding:
+      codec: json
+
+  ddl:
+    type: file
+    inputs: ["mysql.control"]
+    path: ./out/ddl.ndjson
+    encoding:
+      codec: json
+
+  schemas:
+    type: azure_blob
+    inputs: ["mysql_record.table_schemas"]
+    connection_string: "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
+    container_name: cdc
+    # One blob per schema version, named after it: re-emitted documents overwrite themselves.
+    blob_prefix: "_schemas/{{ db }}/{{ table }}/{{ schema_version }}"
+    blob_time_format: ""
+    blob_append_uuid: false
+    blob_overwrite: true              # re-emitted documents rewrite their own file
+    blob_extension: json
+    encoding:
+      codec: json
+      except_fields: ["source_type", "timestamp"]
+    framing:
+      method: newline_delimited
+    compression: none
+    batch:
+      timeout_secs: 3
+    healthcheck:
+      enabled: false

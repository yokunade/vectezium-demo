@@ -0,0 +1,185 @@
+//! Change-event envelopes shared by every CDC connector.
+//!
+//! Two shapes (`event_format`):
+//!
+//! * **Debezium** — the Debezium change-event payload (JSON converter, `schemas.enable=false`):
+//!   `before`, `after`, `source`, `transaction`, `op`, `ts_ms`, `ts_us`, `ts_ns`. The `source`
+//!   block starts with the fields every Debezium connector has, then the connector's own
+//!   position fields ([`SourceBlock::debezium_position`]).
+//! * **Record** — `metadata` (the change, where it came from, `seq`, `schema_version`) and
+//!   `record` (the row), one table row per change.
+
+use chrono::Utc;
+use serde_json::{Map, Value as Json, json};
+
+use super::RecordImages;
+
+/// Debezium operation codes.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Op {
+    Create,
+    Update,
+    Delete,
+    Read,
+}
+
+impl Op {
+    pub const fn code(self) -> &'static str {
+        match self {
+            Op::Create => "c",
+            Op::Update => "u",
+            Op::Delete => "d",
+            Op::Read => "r",
+        }
+    }
+}
+
+/// The `source.snapshot` marker.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SnapshotMarker {
+    False,
+    True,
+    First,
+    FirstInDataCollection,
+    LastInDataCollection,
+    /// A row of an incremental snapshot.
+    Incremental,
+    Last,
+}
+
+impl SnapshotMarker {
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            SnapshotMarker::False => "false",
+            SnapshotMarker::True => "true",
+            SnapshotMarker::First => "first",
+            SnapshotMarker::FirstInDataCollection => "first_in_data_collection",
+            SnapshotMarker::LastInDataCollection => "last_in_data_collection",
+            SnapshotMarker::Last => "last",
+            SnapshotMarker::Incremental => "incremental",
+        }
+    }
+}
+
+/// Where one change came from. Each connector implements this for its own position type
+/// (binlog file/position/GTID for MySQL, an LSN for PostgreSQL or SQL Server, …).
+pub trait SourceBlock {
+    /// Debezium's `source.connector`, e.g. `mysql`.
+    fn connector(&self) -> &'static str;
+    fn connector_version(&self) -> &str;
+    /// The logical server name (`topic_prefix`).
+    fn server_name(&self) -> &str;
+    /// Commit time of the change in microseconds since the epoch.
+    fn ts_us(&self) -> i64;
+    fn snapshot(&self) -> SnapshotMarker;
+    /// The database (or schema) of the table.
+    fn db(&self) -> &str;
+    fn table(&self) -> &str;
+    /// Debezium's `source.sequence` (null unless the connector defines one).
+    fn sequence(&self) -> Json {
+        Json::Null
+    }
+    /// Appends the connector's position fields to Debezium's `source` block (after `table`).
+    fn debezium_position(&self, source: &mut Map<String, Json>);
+    /// Appends the connector's position fields to `metadata` in the record format (after
+    /// `captured_ts_ms`).
+    fn record_position(&self, metadata: &mut Map<String, Json>);
+}
+
+fn source_json<S: SourceBlock + ?Sized>(source: &S) -> Json {
+    let ts_us = source.ts_us();
+    let mut block = Map::with_capacity(18);
+    block.insert("version".into(), json!(source.connector_version()));
+    block.insert("connector".into(), json!(source.connector()));
+    block.insert("name".into(), json!(source.server_name()));
+    block.insert("ts_ms".into(), json!(ts_us.div_euclid(1000)));
+    block.insert("snapshot".into(), json!(source.snapshot().as_str()));
+    block.insert("db".into(), json!(source.db()));
+    block.insert("sequence".into(), source.sequence());
+    block.insert("ts_us".into(), json!(ts_us));
+    block.insert("ts_ns".into(), json!(ts_us.saturating_mul(1000)));
+    block.insert("table".into(), json!(source.table()));
+    source.debezium_position(&mut block);
+    Json::Object(block)
+}
+
+/// Builds the Debezium change-event payload.
+pub fn change_event<S: SourceBlock + ?Sized>(
+    op: Op,
+    before: Option<Map<String, Json>>,
+    after: Option<Map<String, Json>>,
+    source: &S,
+) -> Map<String, Json> {
+    let now_us = Utc::now().timestamp_micros();
+    let mut event = Map::with_capacity(8);
+    event.insert("before".into(), before.map_or(Json::Null, Json::Object));
+    event.insert("after".into(), after.map_or(Json::Null, Json::Object));
+    event.insert("source".into(), source_json(source));
+    event.insert("transaction".into(), Json::Null);
+    event.insert("op".into(), json!(op.code()));
+    event.insert("ts_ms".into(), json!(now_us.div_euclid(1000)));
+    event.insert("ts_us".into(), json!(now_us));
+    event.insert("ts_ns".into(), json!(now_us.saturating_mul(1000)));
+    event
+}
+
+/// Builds a `metadata` + `record` change event (`event_format: record`).
+///
+/// With [`RecordImages::After`], `record` is the latest known state of the row: the after
+/// image, or for deletes the deleted row. With [`RecordImages::BeforeAndAfter`], `record`
+/// holds both images: `{"before": …, "after": …}`, where `before` is `null` for inserts and
+/// snapshot reads, and `after` holds only the key columns for deletes (`null` without a key).
+pub fn record_event<S: SourceBlock + ?Sized>(
+    op: Op,
+    before: Option<Map<String, Json>>,
+    after: Option<Map<String, Json>>,
+    source: &S,
+    key: Option<&Map<String, Json>>,
+    schema_version: Option<&str>,
+    images: RecordImages,
+) -> Map<String, Json> {
+    let deleted = op == Op::Delete;
+    let ts_us = source.ts_us();
+    let mut metadata = Map::with_capacity(17);
+    metadata.insert("op".into(), json!(op.code()));
+    metadata.insert("deleted".into(), json!(deleted));
+    metadata.insert("snapshot".into(), json!(source.snapshot().as_str()));
+    metadata.insert("server_name".into(), json!(source.server_name()));
+    metadata.insert("db".into(), json!(source.db()));
+    metadata.insert("table".into(), json!(source.table()));
+    metadata.insert(
+        "key".into(),
+        key.map_or(Json::Null, |k| Json::Object(k.clone())),
+    );
+    metadata.insert("commit_ts_ms".into(), json!(ts_us.div_euclid(1000)));
+    metadata.insert("commit_ts_us".into(), json!(ts_us));
+    metadata.insert(
+        "captured_ts_ms".into(),
+        json!(Utc::now().timestamp_millis()),
+    );
+    source.record_position(&mut metadata);
+    metadata.insert(
+        "schema_version".into(),
+        schema_version.map_or(Json::Null, |v| json!(v)),
+    );
+
+    let mut event = Map::with_capacity(3);
+    event.insert("metadata".into(), Json::Object(metadata));
+    match images {
+        RecordImages::After => {
+            let record = if deleted { before } else { after };
+            event.insert("record".into(), record.map_or(Json::Null, Json::Object));
+        }
+        RecordImages::BeforeAndAfter => {
+            // A delete has no after image; its `after` holds the key of the deleted row (the
+            // primary key, or the `pk_override` columns), so a merge keyed on `record.after`
+            // finds the row to delete. Tables without a key get `null`.
+            let after = if deleted { key.cloned() } else { after };
+            let mut record = Map::with_capacity(2);
+            record.insert("before".into(), before.map_or(Json::Null, Json::Object));
+            record.insert("after".into(), after.map_or(Json::Null, Json::Object));
+            event.insert("record".into(), Json::Object(record));
+        }
+    }
+    event
+}
diff --git a/src/sources/cdc/filter.rs b/src/sources/cdc/filter.rs
new file mode 100644
index 0000000..3bfe336
--- /dev/null
+++ b/src/sources/cdc/filter.rs
@@ -0,0 +1,224 @@
+//! Database, table and column filters, following Debezium's include/exclude list semantics.
+//!
+//! * `database_include_list` / `database_exclude_list` match the database name.
+//! * `table_include_list` / `table_exclude_list` match `<database>.<table>`.
+//! * `column_exclude_list` matches `<database>.<table>.<column>`.
+//!
+//! Every entry is a regular expression that must match the *whole* identifier. Include and
+//! exclude lists of the same kind are mutually exclusive. The connector's system databases
+//! ([`Filters::with_system_databases`]) are always excluded.
+//!
+//! "Database" is whatever the connector's first name level is (a MySQL database, a PostgreSQL or
+//! SQL Server schema).
+
+use std::{collections::HashMap, sync::Arc};
+
+use regex::RegexSet;
+
+#[derive(Clone, Debug, Default)]
+pub struct Filters {
+    database_include: Option<RegexSet>,
+    database_exclude: Option<RegexSet>,
+    table_include: Option<RegexSet>,
+    table_exclude: Option<RegexSet>,
+    column_exclude: Option<RegexSet>,
+    /// Skip online schema-change shadow tables.
+    exclude_osc_tables: bool,
+    /// `<database>.<table>` → key columns replacing the primary key.
+    key_columns: Arc<HashMap<String, Vec<String>>>,
+    /// Databases whose changes are never captured.
+    system_databases: &'static [&'static str],
+}
+
+/// Whether `table` is a shadow table of gh-ost (`_t_gho`, `_t_ghc`, `_t_del`) or
+/// pt-online-schema-change (`_t_new`, `_t_old`).
+pub fn is_online_schema_change_table(table: &str) -> bool {
+    let Some(rest) = table.strip_prefix('_') else {
+        return false;
+    };
+    ["_gho", "_ghc", "_del", "_new", "_old"]
+        .iter()
+        .any(|suffix| rest.len() > suffix.len() && rest.ends_with(suffix))
+}
+
+fn build(patterns: &[String], what: &str) -> Result<Option<RegexSet>, String> {
+    if patterns.is_empty() {
+        return Ok(None);
+    }
+    let anchored: Vec<String> = patterns.iter().map(|p| format!("^(?:{p})$")).collect();
+    RegexSet::new(&anchored)
+        .map(Some)
+        .map_err(|error| format!("invalid regular expression in `{what}`: {error}"))
+}
+
+impl Filters {
+    pub fn new(
+        database_include: &[String],
+        database_exclude: &[String],
+        table_include: &[String],
+        table_exclude: &[String],
+        column_exclude: &[String],
+    ) -> Result<Self, String> {
+        if !database_include.is_empty() && !database_exclude.is_empty() {
+            return Err(
+                "`database_include_list` and `database_exclude_list` cannot both be set".into(),
+            );
+        }
+        if !table_include.is_empty() && !table_exclude.is_empty() {
+            return Err("`table_include_list` and `table_exclude_list` cannot both be set".into());
+        }
+        Ok(Self {
+            database_include: build(database_include, "database_include_list")?,
+            database_exclude: build(database_exclude, "database_exclude_list")?,
+            table_include: build(table_include, "table_include_list")?,
+            table_exclude: build(table_exclude, "table_exclude_list")?,
+            column_exclude: build(column_exclude, "column_exclude_list")?,
+            exclude_osc_tables: false,
+            key_columns: Arc::default(),
+            system_databases: &[],
+        })
+    }
+
+    /// Databases that are never captured, whatever the lists say (compared case-insensitively).
+    #[must_use]
+    pub fn with_system_databases(mut self, databases: &'static [&'static str]) -> Self {
+        self.system_databases = databases;
+        self
+    }
+
+    /// Skips online schema-change shadow tables (see [`is_online_schema_change_table`]).
+    #[must_use]
+    pub fn excluding_online_schema_change_tables(mut self, exclude: bool) -> Self {
+        self.exclude_osc_tables = exclude;
+        self
+    }
+
+    /// Sets key columns for tables (`<database>.<table>` → columns).
+    #[must_use]
+    pub fn with_key_columns(mut self, key_columns: HashMap<String, Vec<String>>) -> Self {
+        self.key_columns = Arc::new(key_columns);
+        self
+    }
+
+    /// The configured key columns of a table, if any.
+    pub fn key_columns(&self, database: &str, table: &str) -> Option<&[String]> {
+        self.key_columns
+            .get(&format!("{database}.{table}"))
+            .map(Vec::as_slice)
+    }
+
+    pub fn database_included(&self, database: &str) -> bool {
+        if self
+            .system_databases
+            .iter()
+            .any(|sys| sys.eq_ignore_ascii_case(database))
+        {
+            return false;
+        }
+        if let Some(include) = &self.database_include {
+            return include.is_match(database);
+        }
+        if let Some(exclude) = &self.database_exclude {
+            return !exclude.is_match(database);
+        }
+        true
+    }
+
+    pub fn table_included(&self, database: &str, table: &str) -> bool {
+        if !self.database_included(database) {
+            return false;
+        }
+        if self.exclude_osc_tables && is_online_schema_change_table(table) {
+            return false;
+        }
+        let fqn = format!("{database}.{table}");
+        if let Some(include) = &self.table_include {
+            return include.is_match(&fqn);
+        }
+        if let Some(exclude) = &self.table_exclude {
+            return !exclude.is_match(&fqn);
+        }
+        true
+    }
+
+    pub fn column_excluded(&self, database: &str, table: &str, column: &str) -> bool {
+        self.column_exclude
+            .as_ref()
+            .is_some_and(|set| set.is_match(&format!("{database}.{table}.{column}")))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn s(v: &[&str]) -> Vec<String> {
+        v.iter().map(|x| (*x).to_string()).collect()
+    }
+
+    #[test]
+    fn system_databases_always_excluded() {
+        let f = Filters::new(&s(&[".*"]), &[], &[], &[], &[])
+            .unwrap()
+            .with_system_databases(&["mysql", "sys"]);
+        assert!(!f.database_included("mysql"));
+        assert!(!f.database_included("MySQL"));
+        assert!(!f.table_included("sys", "x"));
+        assert!(f.database_included("app"));
+    }
+
+    #[test]
+    fn include_lists_are_anchored() {
+        let f = Filters::new(&s(&["app"]), &[], &s(&["app\\.orders.*"]), &[], &[]).unwrap();
+        assert!(f.database_included("app"));
+        assert!(!f.database_included("app2"));
+        assert!(f.table_included("app", "orders"));
+        assert!(f.table_included("app", "orders_archive"));
+        assert!(!f.table_included("app", "customers"));
+    }
+
+    #[test]
+    fn exclude_lists() {
+        let f = Filters::new(&[], &s(&["tmp_.*"]), &[], &s(&["app\\.audit"]), &[]).unwrap();
+        assert!(!f.database_included("tmp_x"));
+        assert!(!f.table_included("app", "audit"));
+        assert!(f.table_included("app", "audit_log"));
+    }
+
+    #[test]
+    fn column_exclusion() {
+        let f = Filters::new(&[], &[], &[], &[], &s(&["app\\.users\\.(password|ssn)"])).unwrap();
+        assert!(f.column_excluded("app", "users", "password"));
+        assert!(!f.column_excluded("app", "users", "email"));
+    }
+
+    #[test]
+    fn online_schema_change_tables() {
+        for t in [
+            "_orders_gho",
+            "_orders_ghc",
+            "_orders_del",
+            "_orders_new",
+            "_orders_old",
+        ] {
+            assert!(is_online_schema_change_table(t), "{t}");
+        }
+        for t in ["orders", "orders_new", "_gho", "_new", "_orders"] {
+            assert!(!is_online_schema_change_table(t), "{t}");
+        }
+        let f = Filters::new(&[], &[], &[], &[], &[])
+            .unwrap()
+            .excluding_online_schema_change_tables(true);
+        assert!(!f.table_included("app", "_orders_gho"));
+        assert!(f.table_included("app", "orders"));
+        let f = Filters::new(&[], &[], &[], &[], &[]).unwrap();
+        assert!(f.table_included("app", "_orders_gho"));
+    }
+
+    #[test]
+    fn conflicting_lists_rejected() {
+        assert!(Filters::new(&s(&["a"]), &s(&["b"]), &[], &[], &[]).is_err());
+        assert!(Filters::new(&[], &[], &s(&["a.b"]), &s(&["a.c"]), &[]).is_err());
+        assert!(Filters::new(&s(&["("]), &[], &[], &[], &[]).is_err());
+    }
+}
diff --git a/src/sources/cdc/lock.rs b/src/sources/cdc/lock.rs
new file mode 100644
index 0000000..4b0e52b
--- /dev/null
+++ b/src/sources/cdc/lock.rs
@@ -0,0 +1,475 @@
+//! Single-writer lock: a lease on an Azure blob, held while the source runs.
+//!
+//! Two instances capturing the same server (an overlapping redeploy, a platform move) would
+//! race on the stored offset and on the published offsets. With `single_writer_lock`
+//! configured, an instance takes the lease before it reads its stored offset, renews it while
+//! it runs, and releases it after its last offset write; a second instance waits until then
+//! (or until the lease expires, if the holder crashed).
+//!
+//! The holder stops writing offsets as soon as it cannot be sure it still holds the lease
+//! (`safety_margin` before the lease could expire), and the source stops with an error.
+
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use azure_core::http::{RequestContent, StatusCode, Url};
+use azure_storage_blob::{
+    BlobClient, BlobContainerClient,
+    models::{BlobClientAcquireLeaseOptions, BlockBlobClientUploadOptions},
+};
+use vector_lib::{configurable::configurable_component, sensitive_string::SensitiveString};
+
+use crate::{
+    config::ProxyConfig,
+    shutdown::ShutdownSignal,
+    sinks::{
+        azure_blob::config::build_client,
+        azure_common::{
+            config::{AzureAuthentication, AzureBlobTlsConfig},
+            connection_string::ParsedConnectionString,
+        },
+    },
+};
+
+const ACQUIRE_RETRY: Duration = Duration::from_secs(5);
+const MIN_LEASE_SECS: u64 = 15;
+const MAX_LEASE_SECS: u64 = 60;
+
+/// A lease on an Azure blob that makes this source the only writer for its offsets.
+///
+/// Configure it on every instance that could capture the same server, with the same blob.
+#[configurable_component]
+#[derive(Clone, Debug)]
+#[serde(deny_unknown_fields)]
+pub struct SingleWriterLockConfig {
+    /// Azure authentication, as for the `azure_blob` sink (for example a managed identity).
+    #[serde(default)]
+    pub auth: Option<AzureAuthentication>,
+
+    /// The storage account connection string (account key or SAS).
+    #[configurable(metadata(docs::examples = "AccountName=mystorage"))]
+    pub connection_string: Option<SensitiveString>,
+
+    /// The storage account name; requires `auth`.
+    #[configurable(metadata(docs::examples = "mystorage"))]
+    pub account_name: Option<String>,
+
+    /// The blob endpoint; requires `auth`.
+    #[configurable(metadata(docs::examples = "https://mystorage.blob.core.windows.net/"))]
+    pub blob_endpoint: Option<String>,
+
+    /// The container holding the lock blob. It must exist.
+    #[configurable(metadata(docs::examples = "raw"))]
+    pub container_name: String,
+
+    /// The lock blob, created empty if missing. Use one per captured server.
+    #[configurable(metadata(docs::examples = "cdc/azure-mysql/_lock"))]
+    pub blob_name: String,
+
+    /// The lease duration (15 to 60 seconds). A crashed holder blocks a successor for at most
+    /// this long; the lease is renewed every third of it.
+    #[serde(default = "default_lease_duration_secs")]
+    #[configurable(metadata(docs::type_unit = "seconds"))]
+    pub lease_duration_secs: u64,
+
+    /// TLS options for the storage endpoint.
+    pub tls: Option<AzureBlobTlsConfig>,
+}
+
+const fn default_lease_duration_secs() -> u64 {
+    30
+}
+
+impl SingleWriterLockConfig {
+    fn connection_string(&self) -> Result<String, String> {
+        match (
+            &self.connection_string,
+            &self.account_name,
+            &self.blob_endpoint,
+        ) {
+            (Some(connection_string), None, None) => Ok(connection_string.inner().to_owned()),
+            (None, Some(account), None) if self.auth.is_some() => {
+                Ok(format!("AccountName={account}"))
+            }
+            (None, None, Some(endpoint)) if self.auth.is_some() => {
+                Ok(format!("BlobEndpoint={}/", endpoint.trim_end_matches('/')))
+            }
+            (None, Some(_), None) | (None, None, Some(_)) => Err(
+                "`single_writer_lock.auth` is required with `account_name` or `blob_endpoint`"
+                    .into(),
+            ),
+            _ => Err(
+                "`single_writer_lock` needs exactly one of `connection_string`, \
+                      `account_name` or `blob_endpoint`"
+                    .into(),
+            ),
+        }
+    }
+
+    /// Checks the settings and builds the client (no I/O).
+    pub fn build(&self, proxy: &ProxyConfig) -> Result<LockClient, String> {
+        if !(MIN_LEASE_SECS..=MAX_LEASE_SECS).contains(&self.lease_duration_secs) {
+            return Err(format!(
+                "`single_writer_lock.lease_duration_secs` must be between {MIN_LEASE_SECS} and \
+                 {MAX_LEASE_SECS}"
+            ));
+        }
+        if self.blob_name.trim_matches('/').is_empty() {
+            return Err("`single_writer_lock.blob_name` is empty".into());
+        }
+        let parsed = ParsedConnectionString::parse(&self.connection_string()?)
+            .map_err(|error| format!("invalid `single_writer_lock` connection string: {error}"))?;
+        let url = parsed
+            .container_url(&self.container_name)
+            .map_err(|error| format!("invalid `single_writer_lock` container: {error}"))?;
+        let url = Url::parse(&url).map_err(|error| format!("invalid container URL: {error}"))?;
+        let container = build_client(self.auth.as_ref(), &parsed, url, proxy, self.tls.as_ref())
+            .map_err(|error| format!("failed to build the `single_writer_lock` client: {error}"))?;
+        let blob_name = self.blob_name.trim_start_matches('/').to_owned();
+        Ok(LockClient {
+            blob: Arc::new(container.blob_client(&blob_name)),
+            container,
+            blob_name: blob_name.clone(),
+            name: format!("{}/{blob_name}", self.container_name),
+            duration: Duration::from_secs(self.lease_duration_secs),
+        })
+    }
+}
+
+/// A configured, not yet acquired lock.
+pub struct LockClient {
+    blob: Arc<BlobClient>,
+    container: Arc<BlobContainerClient>,
+    blob_name: String,
+    name: String,
+    duration: Duration,
+}
+
+impl LockClient {
+    /// The container holding the lock blob, for reading the connector's other blobs
+    /// (`offset_recovery`).
+    pub fn container(&self) -> Arc<BlobContainerClient> {
+        Arc::clone(&self.container)
+    }
+
+    /// The lock blob's name inside the container.
+    pub fn blob_name(&self) -> &str {
+        &self.blob_name
+    }
+}
+
+/// Whether this instance may still write: the lease is held and cannot have expired yet.
+#[derive(Clone)]
+pub struct WriterGuard {
+    state: Arc<LeaseState>,
+}
+
+struct LeaseState {
+    /// Set when the lease is lost, released, or may have expired.
+    fenced: AtomicBool,
+    /// When the lease could expire, minus the safety margin (latest successful renewal).
+    valid_until: std::sync::Mutex<Instant>,
+}
+
+impl WriterGuard {
+    /// A guard that always allows writes (no lock configured).
+    pub fn unlocked() -> Self {
+        Self {
+            state: Arc::new(LeaseState {
+                fenced: AtomicBool::new(false),
+                valid_until: std::sync::Mutex::new(
+                    Instant::now() + Duration::from_secs(10 * 365 * 86_400),
+                ),
+            }),
+        }
+    }
+
+    pub fn may_write(&self) -> bool {
+        !self.state.fenced.load(Ordering::SeqCst)
+            && Instant::now() < *self.state.valid_until.lock().expect("lock poisoned")
+    }
+
+    fn fence(&self) {
+        self.state.fenced.store(true, Ordering::SeqCst);
+    }
+
+    fn extend(&self, until: Instant) {
+        *self.state.valid_until.lock().expect("lock poisoned") = until;
+    }
+}
+
+/// A held lease, renewed in the background until released or lost.
+pub struct HeldLock {
+    blob: Arc<BlobClient>,
+    name: String,
+    lease_id: String,
+    guard: WriterGuard,
+    renewer: tokio::task::JoinHandle<()>,
+}
+
+fn safety_margin(duration: Duration) -> Duration {
+    duration / 3
+}
+
+impl LockClient {
+    /// Waits for the lease. Returns `None` if shutdown is requested first.
+    pub async fn acquire(self, mut shutdown: ShutdownSignal) -> Result<Option<HeldLock>, String> {
+        let lease_id = uuid::Uuid::new_v4().to_string();
+        let seconds = i32::try_from(self.duration.as_secs()).unwrap_or(60);
+        let mut announced = false;
+        loop {
+            self.ensure_blob().await;
+            let requested = Instant::now();
+            let options = BlobClientAcquireLeaseOptions {
+                proposed_lease_id: Some(lease_id.clone()),
+                ..Default::default()
+            };
+            match self.blob.acquire_lease(seconds, Some(options)).await {
+                Ok(_) => {
+                    info!(
+                        message = "Acquired the single-writer lock.",
+                        lock = %self.name,
+                        lease_id = %lease_id,
+                    );
+                    let guard = WriterGuard {
+                        state: Arc::new(LeaseState {
+                            fenced: AtomicBool::new(false),
+                            valid_until: std::sync::Mutex::new(
+                                requested + self.duration - safety_margin(self.duration),
+                            ),
+                        }),
+                    };
+                    let renewer = tokio::spawn(renew(
+                        Arc::clone(&self.blob),
+                        self.name.clone(),
+                        lease_id.clone(),
+                        self.duration,
+                        guard.clone(),
+                    ));
+                    return Ok(Some(HeldLock {
+                        blob: self.blob,
+                        name: self.name,
+                        lease_id,
+                        guard,
+                        renewer,
+                    }));
+                }
+                Err(error) if error.http_status() == Some(StatusCode::Conflict) => {
+                    if !announced {
+                        warn!(
+                            message = "Another instance holds the single-writer lock; waiting for \
+                                       it to stop (or for its lease to expire).",
+                            lock = %self.name,
+                        );
+                        announced = true;
+                    }
+                }
+                Err(error) => {
+                    warn!(
+                        message = "Could not acquire the single-writer lock; retrying.",
+                        lock = %self.name,
+                        %error,
+                    );
+                }
+            }
+            tokio::select! {
+                _ = &mut shutdown => return Ok(None),
+                () = tokio::time::sleep(ACQUIRE_RETRY) => {}
+            }
+        }
+    }
+
+    /// Creates the lock blob if it does not exist (errors surface on the lease request).
+    async fn ensure_blob(&self) {
+        let options = BlockBlobClientUploadOptions::default().if_not_exists();
+        if let Err(error) = self
+            .blob
+            .upload(RequestContent::from(Vec::<u8>::new()), Some(options))
+            .await
+            && !matches!(
+                error.http_status(),
+                Some(StatusCode::Conflict | StatusCode::PreconditionFailed)
+            )
+        {
+            debug!(message = "Could not create the lock blob.", lock = %self.name, %error);
+        }
+    }
+}
+
+async fn renew(
+    blob: Arc<BlobClient>,
+    name: String,
+    lease_id: String,
+    duration: Duration,
+    guard: WriterGuard,
+) {
+    let interval = duration / 3;
+    let margin = safety_margin(duration);
+    let mut next = Instant::now() + interval;
+    loop {
+        tokio::time::sleep_until(next.into()).await;
+        if guard.state.fenced.load(Ordering::SeqCst) {
+            return;
+        }
+        let requested = Instant::now();
+        let result = tokio::time::timeout(interval, blob.renew_lease(lease_id.clone(), None)).await;
+        match result {
+            Ok(Ok(_)) => {
+                guard.extend(requested + duration - margin);
+                next = requested + interval;
+                continue;
+            }
+            Ok(Err(error))
+                if matches!(
+                    error.http_status(),
+                    Some(StatusCode::Conflict | StatusCode::PreconditionFailed)
+                ) =>
+            {
+                guard.fence();
+                error!(
+                    message = "Lost the single-writer lock (another instance holds it); \
+                               stopping without writing further offsets.",
+                    lock = %name,
+                    %error,
+                );
+                return;
+            }
+            Ok(Err(error)) => {
+                warn!(message = "Could not renew the single-writer lock; retrying.", lock = %name, %error);
+            }
+            Err(_) => {
+                warn!(message = "Renewing the single-writer lock timed out; retrying.", lock = %name);
+            }
+        }
+        if !guard.may_write() {
+            guard.fence();
+            error!(
+                message = "Could not renew the single-writer lock before it could expire; \
+                           stopping without writing further offsets.",
+                lock = %name,
+            );
+            return;
+        }
+        next = Instant::now() + Duration::from_secs(2);
+    }
+}
+
+impl HeldLock {
+    pub fn guard(&self) -> WriterGuard {
+        self.guard.clone()
+    }
+
+    /// Resolves once this instance may no longer write.
+    pub async fn lost(&self) {
+        while self.guard.may_write() {
+            tokio::time::sleep(Duration::from_millis(500)).await;
+        }
+    }
+
+    /// Stops writes, then releases the lease so a successor can start at once.
+    pub async fn release(self) {
+        let held = self.guard.may_write();
+        self.guard.fence();
+        self.renewer.abort();
+        if !held {
+            return;
+        }
+        match self.blob.release_lease(self.lease_id, None).await {
+            Ok(_) => info!(message = "Released the single-writer lock.", lock = %self.name),
+            Err(error) => warn!(
+                message = "Could not release the single-writer lock; it expires on its own.",
+                lock = %self.name,
+                %error,
+            ),
+        }
+    }
+}
+
+/// How long a stopping source waits for its last offset write before releasing the lock.
+const LOCK_RELEASE_WAIT: Duration = Duration::from_secs(10);
+
+/// Runs a source under the single-writer lock (if configured): takes the lock before `run`
+/// starts (so before the stored offset is read), stops `run` if the lock is lost, and releases
+/// the lock once the last offset is written (`run` fires the `oneshot` sender after its last
+/// write; see `Checkpoints::start`).
+pub async fn run_locked<F, Fut>(
+    lock: Option<LockClient>,
+    shutdown: ShutdownSignal,
+    run: F,
+) -> Result<(), String>
+where
+    F: FnOnce(WriterGuard, tokio::sync::oneshot::Sender<()>) -> Fut,
+    Fut: std::future::Future<Output = Result<(), String>>,
+{
+    let Some(lock) = lock else {
+        let (done, _) = tokio::sync::oneshot::channel();
+        return run(WriterGuard::unlocked(), done).await;
+    };
+    let Some(held) = lock.acquire(shutdown).await? else {
+        return Ok(());
+    };
+    let (done, written) = tokio::sync::oneshot::channel();
+    let result = tokio::select! {
+        result = run(held.guard(), done) => result,
+        () = held.lost() => Err("lost the single-writer lock; another instance may be capturing \
+                                 this server".to_owned()),
+    };
+    // Let the last acknowledged offset be stored, then release (which also fences writes).
+    _ = tokio::time::timeout(LOCK_RELEASE_WAIT, written).await;
+    held.release().await;
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn config(duration: u64) -> SingleWriterLockConfig {
+        SingleWriterLockConfig {
+            auth: None,
+            connection_string: Some(
+                "DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
+                    .to_owned()
+                    .into(),
+            ),
+            account_name: None,
+            blob_endpoint: None,
+            container_name: "raw".into(),
+            blob_name: "cdc/x/_lock".into(),
+            lease_duration_secs: duration,
+            tls: None,
+        }
+    }
+
+    #[test]
+    fn validates_settings() {
+        let proxy = ProxyConfig::default();
+        assert!(config(30).build(&proxy).is_ok());
+        assert!(config(10).build(&proxy).is_err());
+        assert!(config(61).build(&proxy).is_err());
+        let mut no_auth = config(30);
+        no_auth.connection_string = None;
+        no_auth.account_name = Some("lake".into());
+        assert!(no_auth.build(&proxy).is_err());
+        let mut empty = config(30);
+        empty.blob_name = "/".into();
+        assert!(empty.build(&proxy).is_err());
+    }
+
+    #[test]
+    fn guard_fences_on_expiry_and_release() {
+        let guard = WriterGuard::unlocked();
+        assert!(guard.may_write());
+        guard.extend(Instant::now() - Duration::from_millis(1));
+        assert!(!guard.may_write(), "expired lease must stop writes");
+        guard.extend(Instant::now() + Duration::from_secs(10));
+        assert!(guard.may_write());
+        guard.fence();
+        assert!(!guard.may_write(), "fenced guard must stop writes");
+    }
+}

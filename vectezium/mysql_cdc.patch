+# Snapshot benchmark pipeline used by run-snapshot-bench.sh. Takes one snapshot and exits.
+data_dir: ./out/bench-data
+
+acknowledgements:
+  enabled: true
+
+sources:
+  mysql:
+    type: mysql_cdc
+    hostname: 127.0.0.1
